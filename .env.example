# ==============================================================================
# Synapse Website (corteon.in) - Environment Variables Template
# See docs/ENV.md for full configuration and deployment instructions.
# ==============================================================================

# [PUBLIC] Client-exposed Cloudflare Turnstile site key for interactive challenge widgets on /enquire and /fellowship
PUBLIC_TURNSTILE_SITE_KEY=

# [SECRET] Serverless Cloudflare Turnstile private secret key for /api/enquire token verification
TURNSTILE_SECRET_KEY=

# [SECRET] Serverless Google Apps Script webhook URL for persisting admissions enquiries to Google Sheets
APPS_SCRIPT_URL=

# [SECRET] Serverless & Apps Script shared authentication token validating requests to the webhook
APPS_SCRIPT_TOKEN=

# [CONFIG] Deployment environment identifier ('production', 'preview', or 'development')
ENVIRONMENT=
