{
  "name": "synapse-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/content-lint.js --prod && astro build && node scripts/clean-dev-routes.js",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test:contrast": "node scripts/test-contrast.js",
    "content-lint": "node scripts/content-lint.js",
    "content-lint:prod": "node scripts/content-lint.js --prod",
    "link-check": "node scripts/link-check.js",
    "axe": "node scripts/axe-check.js",
    "lighthouse-ci": "lhci autorun",
    "check": "astro check && eslint . && prettier --check . && npm run test:contrast && npm run content-lint && npm run build && npm run link-check",
    "check:full": "npm run check && npm run axe && npm run lighthouse-ci"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/tailwind": "^5.1.5",
    "@fontsource-variable/geist": "^5.1.1",
    "@fontsource-variable/geist-mono": "^5.1.1",
    "@fontsource/eb-garamond": "^5.1.1",
    "astro": "^5.4.1",
    "autoprefixer": "^10.4.20",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "eslint": "^9.21.0",
    "eslint-plugin-astro": "^1.3.1",
    "linkinator": "^8.1.0",
    "playwright": "^1.64.1",
    "prettier": "^3.5.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0"
  }
}
