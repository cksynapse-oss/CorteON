{
  "name": "synapse-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test:contrast": "node scripts/test-contrast.js",
    "content-lint": "node scripts/stub-check.js content-lint",
    "link-check": "node scripts/stub-check.js link-check",
    "axe": "node scripts/stub-check.js axe",
    "lighthouse-ci": "node scripts/stub-check.js lighthouse-ci",
