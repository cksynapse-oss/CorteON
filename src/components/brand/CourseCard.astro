---
import Button from '../ui/Button.astro';
import type { CourseItem } from '../../content/schemas';
import { getFormUrl, isFormConfigured, type FormKey } from '../../config/forms';

interface Props {
  course: CourseItem;
  featured?: boolean;
  class?: string;
}

const { course, featured = false, class: className = '' } = Astro.props;

// Map course ID to form configuration key
const formKeyMap: Record<string, FormKey> = {
  'foundation-pack': 'foundationPack',
  'question-bank': 'questionBank',
  'subject-classes': 'subjectClasses',
  communication: 'communication',
  'business-development': 'businessDevelopment',
  'ai-literacy': 'aiLiteracy',
  'ai-business-combo': 'aiBusinessCombo',
};

const formKey = formKeyMap[course.id] || 'courseGeneral';
const formUrl = getFormUrl(formKey);
const isExternalForm = isFormConfigured(formKey);

// Pricing display formatting
const formattedPrice = `₹${course.price_inr.toLocaleString('en-IN')}`;
---

<article
  class={`relative flex flex-col justify-between rounded border border-hair bg-paper p-6 transition-colors hover:border-ink/40 sm:p-8 ${
    featured ? 'ring-1 ring-spark-ink/30' : ''
  } ${className}`}
  id={`course-${course.id}`}
>
  <div>
    <!-- Audience Chips & Duration -->
    <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
      <div class="flex flex-wrap gap-1.5">
        {
          course.audience.map((aud) => (
            <span class="bg-hair/40 inline-block rounded-sm px-2.5 py-0.5 font-mono text-[11px] font-medium uppercase tracking-wider text-muted">
              {aud}
            </span>
          ))
        }
      </div>
      {
        course.duration && (
          <span class="font-mono text-xs font-medium text-spark-ink">
            {course.duration}
          </span>
        )
      }
    </div>

    <!-- Title and Subtitle -->
    <h3
      class="font-serif text-2xl font-normal tracking-tight text-ink md:text-3xl"
    >
      <a
        href={`/courses/${course.id}`}
        class="hover:text-spark-ink focus-visible:outline-2 focus-visible:outline-spark"
      >
        {course.title}
      </a>
    </h3>

    {
      course.subtitle && (
        <p class="mt-1 font-serif text-base italic text-muted">
          {course.subtitle}
        </p>
      )
    }

    <!-- Pricing Block -->
    <div class="border-hair/60 my-6 border-y py-4">
      <div class="flex items-baseline gap-2">
        <span class="font-serif text-3xl font-semibold text-ink sm:text-4xl">
          {formattedPrice}
        </span>
        <span class="font-sans text-sm font-medium text-muted">
          / {course.billing}
        </span>
      </div>

      {
        course.total_at_listed_monthly_rate_inr && (
          <p class="mt-1 font-mono text-xs text-muted">
            Total 6-month programme: ₹
            {course.total_at_listed_monthly_rate_inr.toLocaleString('en-IN')}
          </p>
        )
      }

      {
        course.monthly_saving_inr && (
          <p class="mt-1 font-mono text-xs font-semibold text-spark-ink">
            Saves ₹{course.monthly_saving_inr} / month vs taking both separately
          </p>
        )
      }

      {
        course.availability_note && (
          <p class="mt-2 font-sans text-xs italic text-muted">
            * {course.availability_note}
          </p>
        )
      }
    </div>

    <!-- What is Included -->
    <div class="mb-6">
      <h4
        class="mb-3 font-mono text-xs font-semibold uppercase tracking-wider text-ink"
      >
        What is included
      </h4>
      <ul class="space-y-2 font-sans text-sm text-muted">
        {
          course.includes.slice(0, 5).map((item) => (
            <li class="flex items-start gap-2.5">
              <span
                class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-spark"
                aria-hidden="true"
              />
              <span class="leading-relaxed">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- Card Action Controls -->
  <div class="border-hair/60 mt-4 border-t pt-6">
    <div
      class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
    >
      <Button
        href={formUrl}
        target={isExternalForm ? '_blank' : undefined}
        rel={isExternalForm ? 'noopener noreferrer' : undefined}
        variant="primary"
        size="sm"
        class="w-full justify-center sm:w-auto"
      >
        <span>Enquire now</span>
        {
          isExternalForm && (
            <svg
              class="ml-1 h-3.5 w-3.5 opacity-80"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
              />
            </svg>
          )
        }
      </Button>

      <a
        href={`/courses/${course.id}`}
        class="inline-flex items-center justify-center font-sans text-xs font-semibold uppercase tracking-wider text-muted hover:text-ink focus-visible:outline-2 focus-visible:outline-spark"
      >
        <span>View full syllabus</span>
        <span aria-hidden="true" class="ml-1">→</span>
      </a>
    </div>

    <p class="text-muted/80 mt-3 font-sans text-[11px]">
      Offline classroom learning in Chamba · 1–2 trial classes before payment
    </p>
  </div>
</article>
