---
import StatusChip from '../ui/StatusChip.astro';
import type { BuildingFloor } from '../../content/schemas';

interface Props {
  floors: BuildingFloor[];
  class?: string;
}

const { floors, class: className = '' } = Astro.props;
---

<nav
  aria-label="Floor switcher"
  class:list={[
    'floor-switcher bg-paper/95 sticky top-4 z-30 mb-8 rounded border border-hair p-2 backdrop-blur-sm sm:p-3',
    className,
  ]}
  id="floor-switcher-island"
>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <span
      class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-spark-ink"
    >
      Floors
    </span>

    <div
      role="group"
      aria-label="Floor filter and navigation"
      class="flex flex-wrap items-center gap-1.5 sm:gap-2"
    >
      <a
        href="#all-floors"
        data-floor-target="all"
        aria-pressed="true"
        class="floor-tab-btn inline-flex items-center gap-1.5 rounded-pill border border-ink bg-ink px-3 py-1.5 font-mono text-xs font-medium uppercase tracking-wider text-paper transition-colors hover:border-spark-ink hover:bg-spark-ink hover:text-paper focus-visible:outline-2 focus-visible:outline-spark"
      >
        <span>All</span>
      </a>

      {
        floors.map((floor) => (
          <a
            href={`#floor-${floor.id}`}
            data-floor-target={floor.id}
            aria-pressed="false"
            class="floor-tab-btn hover:bg-surface-dim/40 inline-flex items-center gap-1.5 rounded-pill border border-hair bg-paper px-3 py-1.5 font-mono text-xs font-medium uppercase tracking-wider text-ink transition-colors hover:border-ink focus-visible:outline-2 focus-visible:outline-spark"
          >
            <span>Floor {floor.shortName}</span>
            <StatusChip status={floor.status} />
          </a>
        ))
      }
    </div>
  </div>
</nav>

<script>
  function setupFloorSwitcher() {
    const switcher = document.getElementById('floor-switcher-island');
    if (!switcher) return;

    const buttons = switcher.querySelectorAll<HTMLAnchorElement>(
      '[data-floor-target]'
    );
    const buildingEl = document.querySelector<HTMLElement>('.building');
    const floorSections = document.querySelectorAll<HTMLElement>(
      '[data-floor-section]'
    );

    const setActiveButton = (target: string) => {
      buttons.forEach((btn) => {
        const btnTarget = btn.getAttribute('data-floor-target');
        const isActive = btnTarget === target;
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        if (isActive) {
          btn.classList.add('border-ink', 'bg-ink', 'text-paper');
          btn.classList.remove('border-hair', 'bg-paper', 'text-ink');
        } else {
          btn.classList.remove('border-ink', 'bg-ink', 'text-paper');
          btn.classList.add('border-hair', 'bg-paper', 'text-ink');
        }
      });
    };

    const updateBuildingVisual = (target: string) => {
      if (!buildingEl) return;
      if (target === 'all' || !target) {
        buildingEl.removeAttribute('data-active');
      } else {
        buildingEl.setAttribute('data-active', target);
      }
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = btn.getAttribute('data-floor-target');
        if (!target) return;

        // Progressive enhancement: intercept click to smoothly scroll & update building
        e.preventDefault();
        setActiveButton(target);
        updateBuildingVisual(target);

        if (target === 'all') {
          const container = document.getElementById('all-floors');
          if (container) {
            container.scrollIntoView({
              behavior: window.matchMedia('(prefers-reduced-motion: reduce)')
                .matches
                ? 'auto'
                : 'smooth',
              block: 'start',
            });
          }
          if (window.history && window.history.replaceState) {
            window.history.replaceState(null, '', '#all-floors');
          }
        } else {
          const section = document.getElementById(`floor-${target}`);
          if (section) {
            section.scrollIntoView({
              behavior: window.matchMedia('(prefers-reduced-motion: reduce)')
                .matches
                ? 'auto'
                : 'smooth',
              block: 'start',
            });
          }
          if (window.history && window.history.replaceState) {
            window.history.replaceState(null, '', `#floor-${target}`);
          }
        }
      });
    });

    // Synchronize switcher and building drawing on scroll
    if ('IntersectionObserver' in window && floorSections.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const floorId = entry.target.getAttribute('data-floor');
              if (floorId) {
                setActiveButton(floorId);
                updateBuildingVisual(floorId);
              }
            }
          });
        },
        {
          rootMargin: '-20% 0px -60% 0px',
          threshold: 0.1,
        }
      );

      floorSections.forEach((sec) => observer.observe(sec));
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFloorSwitcher);
  } else {
    setupFloorSwitcher();
  }
</script>
