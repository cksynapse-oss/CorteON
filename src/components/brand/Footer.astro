---
import site from '../../content/site.json';
import navigation from '../../content/navigation.json';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const footerLinks = navigation.footer;
---

<footer
  class={`w-full border-t border-hair-ink bg-ink text-paper ${className}`}
  aria-label="Site Footer"
>
  <div class="mx-auto max-w-content px-4 py-16 sm:px-6 md:px-8 lg:px-10">
    <!-- Top Row: Brand & Purpose -->
    <div
      class="grid grid-cols-1 items-baseline gap-8 border-b border-hair-ink pb-12 md:grid-cols-12"
    >
      <div class="md:col-span-6">
        <a
          href="/"
          class="inline-block rounded-sm focus-visible:outline-2 focus-visible:outline-spark-glow"
          aria-label={`${site.name} home`}
        >
          <span
            class="font-serif text-headline-md font-normal tracking-tight text-paper md:text-headline-lg"
          >
            {site.name}
          </span>
        </a>
        <p
          class="text-paper/90 mt-4 max-w-lg font-serif text-headline-sm font-normal italic leading-relaxed"
        >
          {site.subline}
        </p>
      </div>

      <div
        class="flex flex-col justify-between md:col-span-6 md:items-end md:text-right"
      >
        <span
          class="font-mono text-xs uppercase tracking-[0.16em] text-muted-on-ink"
        >
          {site.tagline}
        </span>
        <p class="mt-4 font-sans text-sm tracking-wide text-muted-on-ink">
          Grown only from what it earns. Chamba, Himachal Pradesh.
        </p>
      </div>
    </div>

    <!-- Middle Row: Navigation Links -->
    <nav aria-label="Footer Navigation" class="border-b border-hair-ink py-10">
      <ul
        class="flex flex-wrap gap-x-8 gap-y-4 font-mono text-xs uppercase tracking-[0.14em]"
      >
        {
          footerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="rounded-sm text-muted-on-ink transition-colors hover:text-paper focus-visible:outline-2 focus-visible:outline-spark-glow"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Bottom Row: Contact & Verification Details -->
    <div
      class="flex flex-col justify-between gap-6 pt-10 font-sans text-sm text-muted-on-ink md:flex-row md:items-center"
    >
      <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:gap-3">
        <span>{site.place}</span>
        <span class="hidden sm:inline" aria-hidden="true">·</span>
        <div class="flex items-center gap-3">
          <a
            href={`tel:+91${site.phone}`}
            class="transition-colors hover:text-paper focus-visible:outline-2 focus-visible:outline-spark-glow"
          >
            {site.phoneDisplay}
          </a>
          <span aria-hidden="true">·</span>
          <a
            href={`https://wa.me/91${site.phone}`}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-paper focus-visible:outline-2 focus-visible:outline-spark-glow"
          >
            WhatsApp
          </a>
          <span aria-hidden="true">·</span>
          <a
            href={`mailto:${site.email}`}
            class="transition-colors hover:text-paper focus-visible:outline-2 focus-visible:outline-spark-glow"
          >
            {site.email}
          </a>
        </div>
      </div>

      <div
        class="font-mono text-xs uppercase tracking-widest text-muted-on-ink"
      >
        © Synapse · {site.domain}
      </div>
    </div>
  </div>
</footer>
