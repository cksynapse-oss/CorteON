---
interface Props {
  onDark?: boolean;
  class?: string;
  id?: string;
}

const { onDark = false, class: className = '', id } = Astro.props;
---

<div
  class:list={[
    'loop-diagram-container relative mx-auto w-full max-w-[540px]',
    onDark && 'theme-ink',
    className,
  ]}
  id={id}
>
  <div class="relative aspect-square w-full">
    <!-- SVG Vector Track & Nodes -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 440 440"
      fill="none"
      role="img"
      aria-labelledby="loop-title-cmp loop-desc-cmp"
      class="absolute inset-0 h-full w-full select-none"
    >
      <title id="loop-title-cmp">The Synapse Loop Diagram</title>
      <desc id="loop-desc-cmp">
        Continuous circular pedagogic cycle connecting Learn, Teach, Build, and
        Show.
      </desc>

      <!-- Base circumference ring -->
      <circle
        cx="220"
        cy="220"
        r="160"
        stroke="var(--hair)"
        stroke-width="1.5"
        stroke-dasharray="3 4"
        stroke-opacity="0.8"></circle>

      <!-- Active vermilion flow arcs with directional momentum -->
      <path
        d="M 220 60 A 160 160 0 0 1 380 220"
        stroke="var(--spark)"
        stroke-width="2.5"
        stroke-linecap="round"></path>
      <path
        d="M 380 220 A 160 160 0 0 1 220 380"
        stroke="var(--ink)"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-opacity="0.4"></path>
      <path
        d="M 220 380 A 160 160 0 0 1 60 220"
        stroke="var(--ink)"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-opacity="0.4"></path>
      <path
        d="M 60 220 A 160 160 0 0 1 220 60"
        stroke="var(--ink)"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-opacity="0.4"></path>

      <!-- Clockwise directional chevrons -->
      <path
        d="M 328 100 L 338 107 L 332 118"
        stroke="var(--spark)"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        fill="none"></path>
      <path
        d="M 338 328 L 333 338 L 321 334"
        stroke="var(--ink)"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-opacity="0.5"
        fill="none"></path>
      <path
        d="M 112 338 L 102 331 L 108 320"
        stroke="var(--ink)"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-opacity="0.5"
        fill="none"></path>
      <path
        d="M 102 112 L 107 102 L 119 106"
        stroke="var(--ink)"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-opacity="0.5"
        fill="none"></path>

      <!-- Center cadence core -->
      <circle
        cx="220"
        cy="220"
        r="54"
        fill="var(--paper)"
        stroke="var(--hair)"
        stroke-width="1.2"></circle>
      <circle
        cx="220"
        cy="220"
        r="48"
        fill="none"
        stroke="var(--hair)"
        stroke-width="0.8"
        stroke-dasharray="2 3"></circle>

      <!-- 4 Nodal markers -->
      <!-- 12 O'Clock: LEARN (Active Spark Node) -->
      <circle
        cx="220"
        cy="60"
        r="11"
        fill="var(--paper)"
        stroke="var(--spark)"
        stroke-width="2.5"></circle>
      <circle cx="220" cy="60" r="5" fill="var(--spark)"></circle>

      <!-- 3 O'Clock: TEACH -->
      <circle
        cx="380"
        cy="220"
        r="9"
        fill="var(--paper)"
        stroke="var(--ink)"
        stroke-width="2"></circle>
      <circle cx="380" cy="220" r="4" fill="var(--ink)"></circle>

      <!-- 6 O'Clock: BUILD -->
      <circle
        cx="220"
        cy="380"
        r="9"
        fill="var(--paper)"
        stroke="var(--ink)"
        stroke-width="2"></circle>
      <circle cx="220" cy="380" r="4" fill="var(--ink)"></circle>

      <!-- 9 O'Clock: SHOW -->
      <circle
        cx="60"
        cy="220"
        r="9"
        fill="var(--paper)"
        stroke="var(--ink)"
        stroke-width="2"></circle>
      <circle cx="60" cy="220" r="4" fill="var(--ink)"></circle>
    </svg>

    <!-- Center Callout Overlay -->
    <div
      class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-center"
    >
      <span
        class="block font-mono text-xs uppercase tracking-[0.2em] text-muted"
        >Continuous</span
      >
      <span class="block font-serif text-lg italic text-ink sm:text-xl"
        >Cadence</span
      >
    </div>

    <!-- 12 O'CLOCK: LEARN (सीखो) -->
    <div
      class="absolute left-1/2 top-0 -translate-x-1/2 text-center"
      style="width: 170px;"
    >
      <div class="font-serif text-xl font-normal text-ink sm:text-2xl">
        LEARN <span class="font-serif text-base text-spark">सीखो</span>
      </div>
      <p class="font-sans text-xs text-muted sm:text-sm">“Learn a thing.”</p>
    </div>

    <!-- 3 O'CLOCK: TEACH (सिखाओ) -->
    <div
      class="absolute right-0 top-1/2 -translate-y-1/2 pl-3 text-left"
      style="width: 150px; transform: translate(15%, -50%);"
    >
      <div class="font-serif text-lg font-normal text-ink sm:text-xl">
        TEACH <span class="font-serif text-base text-spark">सिखाओ</span>
      </div>
      <p class="font-sans text-xs text-muted sm:text-sm">
        “Teach it to someone.”
      </p>
    </div>

    <!-- 6 O'CLOCK: BUILD (बनाओ) -->
    <div
      class="absolute bottom-0 left-1/2 -translate-x-1/2 text-center"
      style="width: 170px;"
    >
      <div class="font-serif text-xl font-normal text-ink sm:text-2xl">
        BUILD <span class="font-serif text-base text-spark">बनाओ</span>
      </div>
      <p class="font-sans text-xs text-muted sm:text-sm">
        “Build something with it.”
      </p>
    </div>

    <!-- 9 O'CLOCK: SHOW (दिखाओ) -->
    <div
      class="absolute left-0 top-1/2 -translate-y-1/2 pr-3 text-right"
      style="width: 150px; transform: translate(-15%, -50%);"
    >
      <div class="font-serif text-lg font-normal text-ink sm:text-xl">
        SHOW <span class="font-serif text-base text-spark">दिखाओ</span>
      </div>
      <p class="font-sans text-xs text-muted sm:text-sm">
        “Show it in public.”
      </p>
    </div>
  </div>
</div>

<style>
  .loop-diagram-container {
    --ink: var(--ink);
    --paper: var(--paper);
    --hair: var(--hair);
    --spark: var(--spark);
    --muted: var(--muted);
  }

  :global(.theme-ink) .loop-diagram-container,
  :global([data-theme='ink']) .loop-diagram-container,
  :global(.dark) .loop-diagram-container,
  .loop-diagram-container.theme-ink {
    --ink: var(--ink);
    --paper: var(--paper);
    --hair: var(--hair);
    --spark: var(--spark);
    --muted: var(--muted);
  }
</style>
