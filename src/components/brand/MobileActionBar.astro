---
import site from '../../content/site.json';

interface Props {
  courseTitle?: string;
}

const { courseTitle } = Astro.props;

const defaultMsg = courseTitle
  ? `Hi Synapse, I would like to book a trial class for ${courseTitle} in Chamba.`
  : 'Hi Synapse, I would like to enquire about courses and admissions in Chamba.';

const whatsappUrl = `https://wa.me/91${site.phone}?text=${encodeURIComponent(defaultMsg)}`;
---

<!-- Sticky Bottom Mobile Action Bar (sm:hidden) -->
<aside
  class="bg-paper/95 fixed bottom-0 left-0 right-0 z-40 border-t border-hair px-4 py-2.5 pb-[calc(0.625rem+env(safe-area-inset-bottom,0px))] shadow-[0_-2px_10px_rgba(21,19,15,0.06)] backdrop-blur-sm sm:hidden"
  aria-label="Quick Admissions Contact"
>
  <div class="mx-auto flex max-w-md items-center justify-between gap-3">
    <!-- WhatsApp Action -->
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex min-h-[44px] flex-1 items-center justify-center gap-2 rounded-full bg-ink px-4 py-2.5 font-sans text-xs font-semibold text-paper transition-colors hover:bg-spark-ink focus-visible:outline-2 focus-visible:outline-spark"
      aria-label="Message Synapse on WhatsApp"
    >
      <svg
        class="h-4 w-4 text-spark"
        fill="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"
        ></path>
      </svg>
      <span>WhatsApp</span>
    </a>

    <!-- Phone Call Action -->
    <a
      href={`tel:+91${site.phone}`}
      class="flex min-h-[44px] flex-1 items-center justify-center gap-2 rounded-full border border-hair bg-paper px-4 py-2.5 font-sans text-xs font-semibold text-ink transition-colors hover:border-spark-ink hover:text-spark-ink focus-visible:outline-2 focus-visible:outline-spark"
      aria-label={`Call Synapse at ${site.phoneDisplay}`}
    >
      <svg
        class="h-3.5 w-3.5 text-muted"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
        ></path>
      </svg>
      <span>Call Centre</span>
    </a>
  </div>
</aside>
