---
import siteEn from '../../content/site.json';
import siteHi from '../../content/hi/site.json';
import navEn from '../../content/navigation.json';
import navHi from '../../content/hi/navigation.json';
import Button from '../ui/Button.astro';
import LanguageToggle from '../ui/LanguageToggle.astro';

interface Props {
  currentPath?: string;
  class?: string;
}

const { currentPath = Astro.url.pathname, class: className = '' } = Astro.props;
const isHindi = currentPath === '/hi' || currentPath.startsWith('/hi/');
const navigation = isHindi ? navHi : navEn;
const site = isHindi ? siteHi : siteEn;
const homeHref = isHindi ? '/hi' : '/';
const mainLinks = navigation.main;
const teachAction = navigation.actions[0] || {
  label: 'Teach with us',
  href: '/fellowship',
};
const enquireAction = navigation.actions[1] || {
  label: 'Enquire',
  href: '/enquire',
};
---

<header
  class={`sticky top-0 left-0 right-0 z-50 w-full border-b border-hair bg-paper ${className}`}
>
  <div
    class="mx-auto flex h-20 max-w-content items-center justify-between px-4 sm:px-6 md:px-8 lg:px-10"
  >
    <!-- Brand Wordmark -->
    <a
      href={homeHref}
      class="group flex items-center gap-2.5 rounded-sm p-1 focus-visible:outline-2 focus-visible:outline-spark"
      aria-label={`${site.name} home`}
    >
      <span
        class="font-serif text-headline-sm font-normal tracking-tight text-ink transition-colors group-hover:text-spark-ink md:text-headline-md"
      >
        {site.name}
      </span>
      <span aria-hidden="true" class="flex items-center text-spark">
        <svg
          fill="none"
          height="14"
          viewBox="0 0 14 14"
          width="14"
          xmlns="http://www.w3.org/2000/svg"
        >
          <line
            stroke="currentColor"
            stroke-width="1.2"
            x1="2"
            x2="12"
            y1="7"
            y2="7"></line>
          <circle cx="7" cy="7" fill="currentColor" r="2.5"></circle>
        </svg>
      </span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav aria-label="Main Navigation" class="hidden items-center gap-8 lg:flex">
      {
        mainLinks.map((link) => {
          const isActive =
            currentPath === link.href ||
            (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class={`rounded-sm py-1 font-sans text-xs font-medium uppercase tracking-[0.14em] transition-colors focus-visible:outline-2 focus-visible:outline-spark ${
                isActive
                  ? 'font-semibold text-spark-ink'
                  : 'text-muted hover:text-ink'
              }`}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Desktop Action Buttons -->
    <div class="hidden items-center gap-3 lg:flex">
      <LanguageToggle currentPath={currentPath} />
      <Button href={teachAction.href} variant="ghost" size="sm">
        {teachAction.label}
      </Button>
      <Button href={enquireAction.href} variant="primary" size="sm">
        {enquireAction.label}
      </Button>
    </div>

    <!-- Mobile Navigation Toggle and Language Switcher -->
    <div class="flex items-center gap-2 lg:hidden">
      <LanguageToggle currentPath={currentPath} />

      <details id="mobile-nav-details" class="group/details relative">
        <summary
          aria-label="Toggle navigation menu"
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-sm border border-hair text-ink transition-colors hover:border-ink focus-visible:outline-2 focus-visible:outline-spark [&::-webkit-details-marker]:hidden"
        >
          <!-- Hamburger Icon (when closed) -->
          <svg
            class="h-5 w-5 group-open/details:hidden"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
          </svg>
          <!-- Close Icon (when open) -->
          <svg
            class="hidden h-5 w-5 group-open/details:block"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </summary>

        <!-- Mobile Dropdown Panel -->
        <nav
          id="mobile-nav"
          aria-label="Mobile Navigation"
          class="absolute right-0 top-12 z-50 w-72 max-w-[calc(100vw-2rem)] border border-hair bg-paper p-6 shadow-none"
        >
          <div class="flex flex-col gap-4">
            <span
              class="font-mono text-xs uppercase tracking-[0.16em] text-muted"
            >
              Menu
            </span>
            <div class="h-px w-full bg-hair" aria-hidden="true"></div>

            {
              mainLinks.map((link) => {
                const isActive =
                  currentPath === link.href ||
                  (link.href !== '/' && currentPath.startsWith(link.href));
                return (
                  <a
                    href={link.href}
                    aria-current={isActive ? 'page' : undefined}
                    class={`rounded-sm py-2 font-sans text-sm font-medium uppercase tracking-[0.12em] transition-colors focus-visible:outline-2 focus-visible:outline-spark ${
                      isActive
                        ? 'font-semibold text-spark-ink'
                        : 'text-muted hover:text-ink'
                    }`}
                  >
                    {link.label}
                  </a>
                );
              })
            }

            <div class="my-2 h-px w-full bg-hair" aria-hidden="true"></div>

            <div class="flex flex-col gap-3 pt-2">
              <Button
                href={teachAction.href}
                variant="ghost"
                size="sm"
                class="w-full text-center"
              >
                {teachAction.label}
              </Button>
              <Button
                href={enquireAction.href}
                variant="primary"
                size="sm"
                class="w-full text-center"
              >
                {enquireAction.label}
              </Button>
            </div>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Progressive enhancement: close mobile menu on Escape key or outside click
  const details = document.getElementById(
    'mobile-nav-details'
  ) as HTMLDetailsElement | null;

  if (details) {
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && details.hasAttribute('open')) {
        details.removeAttribute('open');
        const summary = details.querySelector('summary');
        summary?.focus();
      }
    });

    document.addEventListener('click', (e) => {
      if (details.hasAttribute('open') && !details.contains(e.target as Node)) {
        details.removeAttribute('open');
      }
    });
  }
</script>
