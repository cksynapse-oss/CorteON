---
import tutorProblemRaw from '../../content/illustrative/tutor-problem.json';
import type { TutorProblemContent } from '../../content/schemas';
import StatusChip from '../ui/StatusChip.astro';

const tutor = tutorProblemRaw as TutorProblemContent;
---

<div
  class="relative overflow-hidden rounded border border-hair-ink bg-ink p-6 text-paper sm:p-10"
>
  {/* Terminal / Cell Header */}
  <div
    class="flex flex-wrap items-center justify-between gap-4 border-b border-hair-ink pb-6"
  >
    <div class="flex items-center gap-3">
      <span
        class="inline-flex items-center rounded-pill border border-hair-ink px-3 py-1 font-mono text-xs font-semibold uppercase tracking-wider text-spark-glow"
      >
        {tutor.name}
      </span>
      <StatusChip status={tutor.status} onDark={true} />
    </div>
    <div class="font-mono text-xs uppercase tracking-widest text-muted-on-ink">
      <span>Interactive Prototype</span>
    </div>
  </div>

  {/* Problem Display Card */}
  <div class="bg-ink/80 my-8 rounded border border-hair-ink p-6 sm:p-8">
    <div
      class="mb-3 flex items-center justify-between font-mono text-xs uppercase tracking-wider text-spark-glow"
    >
      <span>{tutor.domain}</span>
      <span class="text-muted-on-ink">{tutor.problemTitle}</span>
    </div>
    <p
      class="font-serif text-xl font-normal leading-snug text-paper sm:text-2xl"
    >
      {tutor.problemStatement}
    </p>
  </div>

  {/* Socratic Hint Ladder */}
  <div class="mb-8 space-y-3">
    <div class="mb-3 flex items-center justify-between">
      <span
        class="font-mono text-xs font-semibold uppercase tracking-wider text-muted-on-ink"
      >
        Socratic Hint Ladder (Progressive Disclosure)
      </span>
      <span class="text-muted-on-ink/80 font-mono text-xs">
        Hints before answers
      </span>
    </div>

    {
      tutor.hints.map((hint, index) => (
        <details
          class="bg-ink/40 open:border-spark-glow/50 group rounded border border-hair-ink transition-colors open:bg-ink"
          open={index === 0}
        >
          <summary class="flex cursor-pointer list-none items-center justify-between p-4 font-mono text-xs uppercase tracking-wider text-paper hover:text-spark-glow focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-spark [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-2">
              <span class="font-semibold text-spark-glow">{hint.label}</span>
              <span class="text-muted-on-ink">·</span>
              <span class="text-paper/90">{hint.title}</span>
            </span>
            <span
              class="text-muted-on-ink transition-transform duration-200 group-open:rotate-180 group-hover:text-spark-glow"
              aria-hidden="true"
            >
              <svg
                class="h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </span>
          </summary>
          <div class="border-t border-hair-ink px-4 pb-4 pt-3 font-body text-base leading-relaxed text-muted-on-ink">
            <p>{hint.content}</p>
          </div>
        </details>
      ))
    }
  </div>

  {/* Confidence Calibration Slider */}
  <div class="mb-8 border-t border-hair-ink pt-6">
    <div class="mb-3 flex items-center justify-between">
      <label
        for="calibration-slider"
        class="font-mono text-xs uppercase tracking-wider text-muted-on-ink"
      >
        {tutor.calibration.label}
      </label>
      <output
        id="confidence-display"
        for="calibration-slider"
        class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-glow"
      >
        50% Confident
      </output>
    </div>

    <input
      id="calibration-slider"
      type="range"
      min="0"
      max="100"
      value="50"
      step="5"
      class="h-2 w-full cursor-pointer appearance-none rounded-full bg-hair-ink accent-spark hover:accent-spark-glow focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-spark"
      aria-describedby="calibration-sub"
    />

    <p id="calibration-sub" class="mt-3 font-body text-sm text-muted-on-ink">
      {tutor.calibration.sub}
    </p>
  </div>

  {/* Institutional Bottom Line */}
  <div
    class="bg-ink/40 flex flex-col gap-2 rounded border border-dashed border-hair-ink p-4 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="flex items-center gap-2">
      <span class="h-2 w-2 rounded-full bg-spark-glow" aria-hidden="true"
      ></span>
      <span
        class="font-mono text-xs font-semibold uppercase tracking-wider text-paper"
      >
        Human Standard
      </span>
    </div>
    <span class="font-body text-sm text-muted-on-ink">
      {tutor.humanRule}
    </span>
  </div>
</div>

<script>
  // Progressive enhancement for confidence slider readout
  const slider = document.getElementById(
    'calibration-slider'
  ) as HTMLInputElement | null;
  const display = document.getElementById('confidence-display');

  if (slider && display) {
    slider.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      display.textContent = `${val}% Confident`;
    });
  }
</script>
