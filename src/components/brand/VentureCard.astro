---
import Button from '../ui/Button.astro';
import type { VentureItem } from '../../content/schemas';
import { getFormUrl, isFormConfigured } from '../../config/forms';

interface Props {
  venture: VentureItem;
  class?: string;
}

const { venture, class: className = '' } = Astro.props;

const formUrl = getFormUrl('internshipApplication');
const isExternalForm = isFormConfigured('internshipApplication');
---

<article
  class={`flex flex-col justify-between rounded border border-hair bg-paper p-6 transition-colors hover:border-ink/40 sm:p-8 ${className}`}
  id={`venture-${venture.id}`}
>
  <div>
    <!-- Status Chip -->
    <div class="mb-4 flex items-center justify-between gap-2">
      <span
        class="bg-hair/50 inline-block rounded-sm px-2.5 py-1 font-mono text-[11px] font-semibold uppercase tracking-wider text-spark-ink"
      >
        {venture.statusChip || 'in development'}
      </span>
      <span class="font-mono text-xs text-muted"> Chamba Venture Track </span>
    </div>

    <!-- Title -->
    <h3
      class="font-serif text-2xl font-normal tracking-tight text-ink md:text-3xl"
    >
      {venture.title}
    </h3>

    <!-- Description -->
    <p class="mt-4 font-sans text-base leading-relaxed text-muted">
      {venture.description}
    </p>

    <!-- Possible Intern Work -->
    <div class="border-hair/60 mt-6 border-t pt-5">
      <h4
        class="mb-3 font-mono text-xs font-semibold uppercase tracking-wider text-ink"
      >
        Possible intern tasks & projects
      </h4>
      <ul class="space-y-2 font-sans text-sm text-muted">
        {
          venture.possibleWork.map((task) => (
            <li class="flex items-start gap-2.5">
              <span
                class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-spark"
                aria-hidden="true"
              />
              <span class="leading-relaxed">{task}</span>
            </li>
          ))
        }
      </ul>
    </div>

    {
      venture.accuracyNote && (
        <div class="border-hair/80 bg-hair/20 mt-5 rounded border p-3 font-sans text-xs italic text-muted">
          {venture.accuracyNote}
        </div>
      )
    }
  </div>

  <!-- Card Action -->
  <div class="border-hair/60 mt-8 border-t pt-5">
    <Button
      href={formUrl}
      target={isExternalForm ? '_blank' : undefined}
      rel={isExternalForm ? 'noopener noreferrer' : undefined}
      variant="primary"
      size="sm"
      class="w-full justify-center"
    >
      <span>Enquire about this venture</span>
      {
        isExternalForm && (
          <svg
            class="ml-1 h-3.5 w-3.5 opacity-80"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
            />
          </svg>
        )
      }
    </Button>
    <p class="mt-2 text-center font-sans text-[11px] text-muted">
      Part of the 6-month Business Development programme
    </p>
  </div>
</article>
