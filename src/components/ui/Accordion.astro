---
export interface AccordionItem {
  id: string;
  question: string;
  answer: string;
}

interface Props {
  items: AccordionItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<div class={`space-y-4 ${className}`}>
  {
    items.map((item) => (
      <details
        id={`faq-${item.id}`}
        class="open:bg-surface-dim/20 group rounded border border-hair bg-paper transition-colors duration-150"
      >
        <summary class="flex cursor-pointer list-none items-center justify-between p-6 font-serif text-lg font-medium text-ink transition-colors hover:text-spark-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-spark sm:p-8 sm:text-xl [&::-webkit-details-marker]:hidden">
          <span class="pr-6">{item.question}</span>
          <span
            class="shrink-0 text-muted transition-transform duration-200 group-open:rotate-180 group-hover:text-spark-ink"
            aria-hidden="true"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"
              />
            </svg>
          </span>
        </summary>
        <div class="border-t border-hair px-6 pb-6 pt-4 font-body text-base leading-relaxed text-muted sm:px-8 sm:pb-8 sm:pt-6">
          <p>{item.answer}</p>
        </div>
      </details>
    ))
  }
</div>
