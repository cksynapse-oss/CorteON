---
interface Props {
  id: string;
  label: string;
  name?: string;
  checked?: boolean;
  required?: boolean;
  disabled?: boolean;
  error?: string;
  helpText?: string;
  onDark?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  id,
  label,
  name = id,
  checked = false,
  required = false,
  disabled = false,
  error,
  helpText,
  onDark = false,
  class: className = '',
  ...rest
} = Astro.props;

const describedBy = [
  helpText ? `${id}-help` : null,
  error ? `${id}-error` : null,
]
  .filter(Boolean)
  .join(' ');

// Border colors
const boxBorderColor = onDark
  ? error
    ? 'border-spark-glow'
    : 'border-hair-ink'
  : error
    ? 'border-spark-ink'
    : 'border-hair';

const checkedBoxStyles = onDark
  ? 'peer-checked:bg-paper peer-checked:border-paper peer-checked:text-ink'
  : 'peer-checked:bg-ink peer-checked:border-ink peer-checked:text-paper';

const labelTextColor = onDark ? 'text-paper' : 'text-ink';
---

<div class={`flex flex-col ${className}`}>
  <label
    for={id}
    class="group relative inline-flex cursor-pointer select-none items-start gap-3 py-1"
  >
    {/* Visually hidden native checkbox for full accessibility */}
    <input
      type="checkbox"
      id={id}
      name={name}
      checked={checked}
      required={required}
      disabled={disabled}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={describedBy || undefined}
      class="peer sr-only"
      {...rest}
    />

    {/* Custom 16px square indicator (2px radius) */}
    <span
      class={`flex items-center justify-center w-4 h-4 mt-1 rounded-sm border bg-transparent text-transparent transition-all duration-150 shrink-0 ${boxBorderColor} ${checkedBoxStyles} peer-focus-visible:outline-2 peer-focus-visible:outline-spark peer-focus-visible:outline-offset-2 ${
        disabled ? 'opacity-40 cursor-not-allowed' : 'group-hover:border-spark'
      }`}
      aria-hidden="true"
    >
      <svg class="h-2.5 w-2.5 fill-current" viewBox="0 0 16 16">
        <path
          d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z"
        ></path>
      </svg>
    </span>

    {/* Accessible label text (>= 16px per AGENTS.md rule 10) */}
    <span
      class={`text-base font-body leading-normal ${labelTextColor} ${disabled ? 'opacity-40' : ''}`}
    >
      {label}
      {
        required && (
          <span
            class={onDark ? 'text-spark-glow' : 'text-spark-ink'}
            aria-hidden="true"
          >
            *
          </span>
        )
      }
    </span>
  </label>

  {
    helpText && !error && (
      <p
        id={`${id}-help`}
        class={`ml-7 font-sans text-xs ${onDark ? 'text-muted-on-ink' : 'text-muted'}`}
      >
        {helpText}
      </p>
    )
  }

  {
    error && (
      <p
        id={`${id}-error`}
        role="alert"
        class={`ml-7 font-sans text-xs font-medium ${onDark ? 'text-spark-glow' : 'text-spark-ink'}`}
      >
        {error}
      </p>
    )
  }
</div>
