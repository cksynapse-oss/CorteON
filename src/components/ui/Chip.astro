---
interface Props {
  variant?: 'default' | 'muted' | 'outline' | 'spark';
  as?: 'span' | 'button' | 'a';
  href?: string;
  onDark?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  variant = 'default',
  as: Component = 'span',
  href,
  onDark = false,
  class: className = '',
  ...rest
} = Astro.props;

const Tag = href ? 'a' : Component;

const baseStyles =
  'inline-flex items-center justify-center h-6 px-2.5 rounded-pill text-xs font-sans font-medium uppercase tracking-[0.12em] leading-none transition-colors duration-150 select-none';

const variantStylesLight = {
  default: 'border border-hair text-muted bg-transparent',
  muted: 'border border-hair text-muted/80 bg-paper/50',
  outline: 'border border-ink text-ink bg-transparent',
  spark: 'border border-spark-ink text-spark-ink bg-transparent',
};

const variantStylesDark = {
  default: 'border border-hair-ink text-muted-on-ink bg-transparent',
  muted: 'border border-hair-ink text-muted-on-ink/80 bg-ink/50',
  outline: 'border border-paper text-paper bg-transparent',
  spark: 'border border-spark-glow text-spark-glow bg-transparent',
};

const variantStyle = onDark
  ? variantStylesDark[variant]
  : variantStylesLight[variant];

const interactiveStyles =
  Tag !== 'span'
    ? 'cursor-pointer hover:border-spark focus-visible:outline-2 focus-visible:outline-spark focus-visible:outline-offset-2'
    : '';

const classes = [baseStyles, variantStyle, interactiveStyles, className]
  .filter(Boolean)
  .join(' ');
---

<Tag href={href} class={classes} {...rest}>
  <slot />
</Tag>
