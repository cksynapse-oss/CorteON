---
import { getBilingualRoutePair } from '../../lib/i18n';
import navEn from '../../content/navigation.json';
import navHi from '../../content/hi/navigation.json';

interface Props {
  currentPath?: string;
  class?: string;
  onDark?: boolean;
}

const {
  currentPath = Astro.url.pathname,
  class: className = '',
  onDark = false,
} = Astro.props;

// Determine current locale
const isHindi = currentPath === '/hi' || currentPath.startsWith('/hi/');
const navigation = isHindi ? navHi : navEn;

// Compute counterpart routes using data-driven bilingual registry
const clean = currentPath.replace(/\/$/, '') || '/';
const pair = getBilingualRoutePair(clean);

let enHref = clean;
let hiHref = '/hi'; // Fallback to Hindi home for routes without dedicated Hindi equivalent

if (isHindi) {
  if (pair) {
    enHref = pair.en;
  } else {
    const sub = clean.replace(/^\/hi\/?/, '');
    enHref = sub ? `/${sub}` : '/';
  }
  hiHref = clean;
} else {
  enHref = clean;
  if (pair) {
    hiHref = pair.hi;
  } else {
    // Un-translated routes link to Hindi home
    hiHref = '/hi';
  }
}

// Ensure clean paths without trailing slashes except for root
if (enHref.length > 1 && enHref.endsWith('/')) {
  enHref = enHref.slice(0, -1);
}
if (hiHref.length > 1 && hiHref.endsWith('/')) {
  hiHref = hiHref.slice(0, -1);
}
---

<nav
  aria-label={navigation.languageToggle.navAriaLabel}
  class:list={[
    'inline-flex select-none items-center rounded-pill border p-0.5 font-mono text-xs',
    onDark
      ? 'border-hair-ink bg-ink text-paper'
      : 'border-hair bg-paper text-ink',
    className,
  ]}
>
  <a
    href={enHref}
    aria-label={navigation.languageToggle.enAriaLabel}
    aria-current={!isHindi ? 'page' : undefined}
    lang="en"
    hreflang="en"
    class:list={[
      'inline-flex items-center justify-center rounded-pill px-2.5 py-1 transition-colors focus-visible:outline-2 focus-visible:outline-spark',
      !isHindi
        ? onDark
          ? 'bg-paper font-semibold text-ink'
          : 'bg-ink font-semibold text-paper'
        : onDark
          ? 'text-muted-on-ink hover:text-paper'
          : 'text-muted hover:text-ink',
    ]}
  >
    EN
  </a>

  <a
    href={hiHref}
    aria-label={navigation.languageToggle.hiAriaLabel}
    aria-current={isHindi ? 'page' : undefined}
    lang="hi"
    hreflang="hi"
    class:list={[
      'inline-flex items-center justify-center rounded-pill px-2.5 py-1 transition-colors focus-visible:outline-2 focus-visible:outline-spark',
      isHindi
        ? onDark
          ? 'bg-paper font-semibold text-ink'
          : 'bg-ink font-semibold text-paper'
        : onDark
          ? 'text-muted-on-ink hover:text-paper'
          : 'text-muted hover:text-ink',
    ]}
  >
    हिन्दी
  </a>
</nav>
