---
interface Props {
  id?: string;
  theme?: 'paper' | 'ink';
  padding?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
  container?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  id,
  theme = 'paper',
  padding = 'lg',
  container = true,
  class: className = '',
  ...rest
} = Astro.props;

const paddingStyles = {
  none: '',
  sm: 'py-8 sm:py-12',
  md: 'py-12 sm:py-16 lg:py-20',
  lg: 'py-16 sm:py-24 lg:py-32',
  xl: 'py-24 sm:py-32 lg:py-40',
};

const themeStyles = {
  paper: 'bg-paper text-ink',
  ink: 'theme-ink bg-ink text-paper',
};

const sectionClasses = [
  'relative w-full',
  themeStyles[theme],
  paddingStyles[padding],
  className,
]
  .filter(Boolean)
  .join(' ');
---

<section id={id} class={sectionClasses} {...rest}>
  {
    container ? (
      <div class="mx-auto max-w-content px-5 sm:px-8 lg:px-10">
        <slot />
      </div>
    ) : (
      <slot />
    )
  }
</section>
