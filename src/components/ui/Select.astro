---
export interface SelectOption {
  value: string;
  label: string;
  disabled?: boolean;
}

interface Props {
  id: string;
  label: string;
  name?: string;
  options: SelectOption[];
  value?: string;
  placeholder?: string;
  required?: boolean;
  disabled?: boolean;
  error?: string;
  helpText?: string;
  onDark?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  id,
  label,
  name = id,
  options = [],
  value,
  placeholder,
  required = false,
  disabled = false,
  error,
  helpText,
  onDark = false,
  class: className = '',
  ...rest
} = Astro.props;

const describedBy = [
  helpText ? `${id}-help` : null,
  error ? `${id}-error` : null,
]
  .filter(Boolean)
  .join(' ');

// Label styling
const labelStyles = [
  'block text-xs font-sans font-medium uppercase tracking-[0.12em] mb-2 select-none',
  onDark ? 'text-muted-on-ink' : 'text-muted',
].join(' ');

// Select box styling
const baseSelectStyles =
  'w-full min-h-[48px] pl-4 pr-10 py-3 rounded text-base font-body appearance-none transition-colors duration-150 outline-none box-border cursor-pointer';

const themeSelectStyles = onDark
  ? error
    ? 'bg-ink text-paper border border-spark-glow focus:border-spark-glow focus:ring-1 focus:ring-spark-glow'
    : 'bg-ink text-paper border border-hair-ink focus:border-spark-glow focus:ring-1 focus:ring-spark-glow'
  : error
    ? 'bg-paper text-ink border border-spark-ink focus:border-spark-ink focus:ring-1 focus:ring-spark-ink'
    : 'bg-paper text-ink border border-hair focus:border-spark focus:ring-1 focus:ring-spark';

const disabledStyles = disabled
  ? 'opacity-40 cursor-not-allowed bg-hair/10'
  : '';

const selectClasses = [
  baseSelectStyles,
  themeSelectStyles,
  disabledStyles,
  className,
]
  .filter(Boolean)
  .join(' ');
---

<div class="w-full">
  <label for={id} class={labelStyles}>
    {label}
    {
      required && (
        <span
          class={onDark ? 'text-spark-glow' : 'text-spark-ink'}
          aria-hidden="true"
        >
          *
        </span>
      )
    }
  </label>

  <div class="relative">
    <select
      id={id}
      name={name}
      required={required}
      disabled={disabled}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={describedBy || undefined}
      class={selectClasses}
      {...rest}
    >
      {
        placeholder && (
          <option value="" disabled selected={!value}>
            {placeholder}
          </option>
        )
      }
      {
        options.map((opt) => (
          <option
            value={opt.value}
            disabled={opt.disabled}
            selected={value === opt.value}
          >
            {opt.label}
          </option>
        ))
      }
    </select>

    {/* Custom 1px Hairline Chevron Arrow (Inline SVG, line art only) */}
    <div
      class={`pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3.5 ${
        onDark ? 'text-muted-on-ink' : 'text-muted'
      }`}
      aria-hidden="true"
    >
      <svg
        class="h-4 w-4"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
      </svg>
    </div>
  </div>

  {
    helpText && !error && (
      <p
        id={`${id}-help`}
        class={`mt-1.5 font-sans text-xs ${onDark ? 'text-muted-on-ink' : 'text-muted'}`}
      >
        {helpText}
      </p>
    )
  }

  {
    error && (
      <p
        id={`${id}-error`}
        role="alert"
        class={`mt-1.5 font-sans text-xs font-medium ${onDark ? 'text-spark-glow' : 'text-spark-ink'}`}
      >
        {error}
      </p>
    )
  }
</div>
