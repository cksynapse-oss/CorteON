---
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/eb-garamond/500.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import NavBar from '../components/brand/NavBar.astro';
import Footer from '../components/brand/Footer.astro';
import FloorGauge from '../components/brand/FloorGauge.astro';
import site from '../content/site.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: 'en' | 'hi';
  theme?: 'paper' | 'ink';
  activeFloor?: 'g' | '1' | '2' | null;
  hideNav?: boolean;
  hideFooter?: boolean;
  hideGauge?: boolean;
  noindex?: boolean;
}

const isPathHindi =
  Astro.url.pathname === '/hi' || Astro.url.pathname.startsWith('/hi/');

const {
  title = `${site.name} — A modern gurukul in Chamba`,
  description = site.tagline,
  image = '/og-image.png',
  lang = isPathHindi ? 'hi' : 'en',
  theme = 'paper',
  activeFloor = null,
  hideNav = false,
  hideFooter = false,
  hideGauge = false,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site
  ? Astro.site.toString().replace(/\/$/, '')
  : 'https://corteon.in';
const cleanPath = Astro.url.pathname.replace(/\/$/, '');
const canonicalUrl = cleanPath ? `${siteUrl}${cleanPath}` : `${siteUrl}/`;
const ogImageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;

// Compute hreflang alternates for launch bilingual routes (Home, Programmes, Enquire)
const isBilingualRoute =
  cleanPath === '' ||
  cleanPath === '/hi' ||
  cleanPath === '/programmes' ||
  cleanPath === '/hi/programmes' ||
  cleanPath === '/enquire' ||
  cleanPath === '/hi/enquire';

let enCanonicalUrl = `${siteUrl}/`;
let hiCanonicalUrl = `${siteUrl}/hi`;

if (cleanPath === '/programmes' || cleanPath === '/hi/programmes') {
  enCanonicalUrl = `${siteUrl}/programmes`;
  hiCanonicalUrl = `${siteUrl}/hi/programmes`;
} else if (cleanPath === '/enquire' || cleanPath === '/hi/enquire') {
  enCanonicalUrl = `${siteUrl}/enquire`;
  hiCanonicalUrl = `${siteUrl}/hi/enquire`;
}

const isDevRoute =
  noindex ||
  Astro.url.pathname.startsWith('/_kit') ||
  Astro.url.pathname.startsWith('/kit');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['EducationalOrganization', 'LocalBusiness'],
  name: site.name,
  description: site.tagline,
  url: 'https://corteon.in/',
  logo: `${siteUrl}/favicon.svg`,
  image: ogImageUrl,
  telephone: `+91${site.phone}`,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Behind the Post Office',
    addressLocality: 'Chamba',
    addressRegion: 'Himachal Pradesh',
    addressCountry: 'IN',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: [
        'Monday',
        'Tuesday',
        'Wednesday',
        'Thursday',
        'Friday',
        'Saturday',
      ],
      opens: '15:30',
      closes: '18:30',
    },
  ],
};
---

<!doctype html>
<html lang={lang} data-theme={theme} class={theme === 'ink' ? 'theme-ink' : ''}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {
      isBilingualRoute && (
        <>
          <link rel="alternate" hreflang="en" href={enCanonicalUrl} />
          <link rel="alternate" hreflang="hi" href={hiCanonicalUrl} />
          <link rel="alternate" hreflang="x-default" href={enCanonicalUrl} />
        </>
      )
    }
    {
      isDevRoute ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow" />
      )
    }

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={lang === 'hi' ? 'hi_IN' : 'en_IN'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Structured Data (JSON-LD) -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />

    <!-- Privacy-friendly Cookieless Analytics (T14) -->
    <script src="../scripts/analytics.ts"></script>
  </head>
  <body class="min-h-screen bg-paper text-ink">
    <!-- Accessible Skip Link (AGENTS.md rule 10 & BUILD_PLAN.md T1) -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <slot name="header">
      {!hideNav && <NavBar currentPath={Astro.url.pathname} />}
    </slot>

    {!hideGauge && <FloorGauge activeFloor={activeFloor} />}

    <main id="main-content" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>

    <slot name="footer">
      {!hideFooter && <Footer currentPath={Astro.url.pathname} />}
    </slot>
  </body>
</html>
