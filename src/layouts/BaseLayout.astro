---
import '@fontsource/eb-garamond/latin-400.css';
import '@fontsource/eb-garamond/latin-400-italic.css';
import '@fontsource/eb-garamond/latin-500.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import garamondNormal from '@fontsource/eb-garamond/files/eb-garamond-latin-400-normal.woff2?url';
import garamondItalic from '@fontsource/eb-garamond/files/eb-garamond-latin-400-italic.woff2?url';
import geistNormal from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMonoNormal from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import '../styles/global.css';
import NavBar from '../components/brand/NavBar.astro';
import Footer from '../components/brand/Footer.astro';
import FloorGauge from '../components/brand/FloorGauge.astro';
import site from '../content/site.json';
import type { SiteContent } from '../content/schemas';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogImageAlt?: string;
  lang?: string;
  theme?: 'paper' | 'ink';
  activeFloor?: 'g' | '1' | '2' | null;
  hideNav?: boolean;
  hideFooter?: boolean;
  hideGauge?: boolean;
  noindex?: boolean;
}

const activeSite = site as unknown as SiteContent;

const {
  title = `${activeSite.name} — A modern gurukul in Chamba`,
  description = activeSite.tagline,
  image = '/og-image.png',
  ogImageAlt = activeSite.ogImageAlt,
  lang = 'en',
  theme = 'paper',
  activeFloor = null,
  hideNav = false,
  hideFooter = false,
  hideGauge = false,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site
  ? Astro.site.toString().replace(/\/$/, '')
  : 'https://corteon.in';
const cleanPath = Astro.url.pathname.replace(/\/$/, '');
const canonicalUrl = cleanPath ? `${siteUrl}${cleanPath}` : `${siteUrl}/`;
const ogImageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;

const isDevRoute =
  noindex ||
  Astro.url.pathname.startsWith('/_kit') ||
  Astro.url.pathname.startsWith('/kit');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['EducationalOrganization', 'LocalBusiness'],
  name: site.name,
  description: site.tagline,
  url: 'https://corteon.in/',
  logo: `${siteUrl}/favicon.svg`,
  image: ogImageUrl,
  telephone: `+91${site.phone}`,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: activeSite.address.streetAddress,
    addressLocality: activeSite.address.addressLocality,
    addressRegion: activeSite.address.addressRegion,
    ...(activeSite.address.postalCode
      ? { postalCode: activeSite.address.postalCode }
      : {}),
    addressCountry: activeSite.address.addressCountry,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: [
        'Monday',
        'Tuesday',
        'Wednesday',
        'Thursday',
        'Friday',
        'Saturday',
      ],
      opens: '15:30',
      closes: '18:30',
    },
  ],
};
---

<!doctype html>
<html lang={lang} data-theme={theme} class={theme === 'ink' ? 'theme-ink' : ''}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Critical Font Preloads (CWV: eliminates font-swap layout shift) -->
    <link
      rel="preload"
      href={garamondNormal}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={garamondItalic}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={geistNormal}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={geistMonoNormal}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {
      isDevRoute ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow" />
      )
    }

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={lang === 'hi' ? 'hi_IN' : 'en_IN'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Structured Data (JSON-LD) -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />

    <!-- Privacy-friendly Cookieless Analytics (T14) -->
    <script>
      import '../scripts/analytics.ts';
    </script>
  </head>
  <body class="min-h-screen bg-paper text-ink">
    <!-- Accessible Skip Link (AGENTS.md rule 10 & BUILD_PLAN.md T1) -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <slot name="header">
      {!hideNav && <NavBar currentPath={Astro.url.pathname} />}
    </slot>

    {!hideGauge && <FloorGauge activeFloor={activeFloor} />}

    <main id="main-content" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>

    <slot name="footer">
      {!hideFooter && <Footer currentPath={Astro.url.pathname} />}
    </slot>
  </body>
</html>
