---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import StatusChip from '../components/ui/StatusChip.astro';

import site from '../content/site.json';
import { getFormUrl, isFormConfigured } from '../config/forms';

const cuetPgFormUrl = getFormUrl('cuetPg');
const isCuetPgExternal = isFormConfigured('cuetPg');

const netPrepFormUrl = getFormUrl('netPrep');
const isNetExternal = isFormConfigured('netPrep');

const foundationFormUrl = getFormUrl('foundationPack');
const isFoundationExternal = isFormConfigured('foundationPack');

const questionBankFormUrl = getFormUrl('questionBank');
const isQbExternal = isFormConfigured('questionBank');

const aiLiteracyFormUrl = getFormUrl('aiLiteracy');
const isAiExternal = isFormConfigured('aiLiteracy');

const businessDevFormUrl = getFormUrl('businessDevelopment');
const isBdExternal = isFormConfigured('businessDevelopment');

const commFormUrl = getFormUrl('communication');
const isCommExternal = isFormConfigured('communication');

const comboFormUrl = getFormUrl('aiBusinessCombo');
const isComboExternal = isFormConfigured('aiBusinessCombo');

const subjects = [
  { name: 'Physics', stream: 'Physical Sciences' },
  { name: 'Chemistry', stream: 'Chemical Sciences' },
  { name: 'Zoology', stream: 'Life Sciences' },
  { name: 'Mathematics', stream: 'Mathematical Sciences' },
  { name: 'Botany', stream: 'Plant Sciences' },
  { name: 'Economics', stream: 'Social Sciences' },
  { name: 'History', stream: 'Humanities' },
  { name: 'Geography', stream: 'Earth & Social Sciences' },
  { name: 'Psychology', stream: 'Behavioral Sciences' },
];
---

<BaseLayout
  title={`College Students & Exam Aspirants — CUET PG, NET & Professional Skills — ${site.name}`}
  description="Academic preparation and practical capabilities for college students in Chamba. CUET PG and UGC NET subject coaching across 9 disciplines, Foundation Pack, Applied AI Literacy, Business Development + Internship, and Communication."
>
  {/* Hero */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="mx-auto max-w-4xl text-center">
      <div class="mb-4 inline-flex items-center gap-2">
        <span
          class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-spark-ink"
        >
          College & Aspirants · Undergraduates & Graduates
        </span>
        <StatusChip status="LIVE NOW" />
      </div>

      <h1
        class="font-serif text-display-xl-mobile font-normal leading-[1.08] tracking-[-0.025em] text-ink sm:text-display-lg md:text-display-xl"
      >
        Academic excellence. Practical capabilities. Venture experience.
      </h1>

      <p
        class="mx-auto mt-4 max-w-2xl font-sans text-base leading-relaxed text-muted sm:text-body-lg"
      >
        We provide degree college students and graduates in Chamba with two
        complementary paths: rigorous preparation for competitive examinations
        (CUET PG, UGC NET, Aptitude Foundations) and six-month
        capability-building programmes connected to real local ventures.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button href="#cuet-net" variant="primary" size="lg">
          CUET PG & NET Preparation
        </Button>
        <Button href="#professional-skills" variant="secondary" size="lg">
          Practical Programmes (6 Months)
        </Button>
      </div>

      <p class="mt-4 font-sans text-xs text-muted">
        College-level batches scheduled before 3:00 PM · Offline instruction in
        Chamba
      </p>
    </div>
  </Section>

  {/* PART A: CUET PG & UGC NET PREPARATION */}
  <Section
    theme="paper"
    padding="lg"
    class="border-b border-hair"
    id="cuet-net"
  >
    <div class="mx-auto max-w-5xl">
      <div class="text-center">
        <span
          class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-spark-ink"
        >
          Competitive Examination Modules
        </span>
        <h2
          class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
        >
          CUET PG and UGC NET Preparation
        </h2>
        <p
          class="mx-auto mt-2 max-w-2xl font-sans text-sm leading-relaxed text-muted"
        >
          Specialised subject coaching across nine core academic disciplines for
          students targeting central university master’s admissions or national
          lectureship and Junior Research Fellowship qualifications.
        </p>
      </div>

      {/* Two Exam Cards */}
      <div class="mt-12 grid gap-8 md:grid-cols-2">
        {/* CUET PG */}
        <div
          class="flex flex-col justify-between rounded border border-hair bg-paper p-8 shadow-sm"
        >
          <div>
            <div class="flex items-center justify-between">
              <span
                class="rounded-pill bg-hair px-3 py-1 font-mono text-xs font-semibold uppercase text-ink"
              >
                Postgraduate Entrance
              </span>
              <span class="font-mono text-xs font-semibold text-spark-ink">
                Exam-Specific Duration
              </span>
            </div>

            <h3
              class="mt-4 font-serif text-2xl font-normal text-ink sm:text-3xl"
            >
              CUET PG Subject Preparation
            </h3>
            <p class="mt-2 font-mono text-xs font-medium text-spark-ink">
              Duration: Until examination · Fee: Enquire
            </p>

            <p class="mt-4 font-sans text-sm leading-relaxed text-muted">
              Intensive subject-focused preparation tailored to central
              university admission patterns. Concept revision, analytical
              problem sets, previous-year paper drills, and mock tests.
            </p>

            <div class="mt-6 border-t border-hair pt-4">
              <span class="font-mono text-xs font-semibold uppercase text-ink">
                Enquiry Details Captured:
              </span>
              <p class="mt-1 font-sans text-xs text-muted">
                Target subject, graduation discipline, target examination year,
                and specific preparation requirements.
              </p>
            </div>
          </div>

          <div class="mt-8 border-t border-hair pt-6">
            <Button
              href={cuetPgFormUrl}
              target={isCuetPgExternal ? '_blank' : undefined}
              rel={isCuetPgExternal ? 'noopener noreferrer' : undefined}
              variant="primary"
              size="md"
              class="w-full justify-center"
            >
              <span>Enquire for CUET PG</span>
            </Button>
          </div>
        </div>

        {/* UGC NET */}
        <div
          class="flex flex-col justify-between rounded border border-hair bg-paper p-8 shadow-sm"
        >
          <div>
            <div class="flex items-center justify-between">
              <span
                class="rounded-pill bg-hair px-3 py-1 font-mono text-xs font-semibold uppercase text-ink"
              >
                Lectureship & JRF
              </span>
              <span class="font-mono text-xs font-semibold text-spark-ink">
                Exam-Specific Duration
              </span>
            </div>

            <h3
              class="mt-4 font-serif text-2xl font-normal text-ink sm:text-3xl"
            >
              UGC NET Subject Preparation
            </h3>
            <p class="mt-2 font-mono text-xs font-medium text-spark-ink">
              Duration: Until examination · Fee: Enquire
            </p>

            <p class="mt-4 font-sans text-sm leading-relaxed text-muted">
              Integrated preparation covering Paper 1 (teaching aptitude,
              research methodology, reasoning) and subject-specific Paper 2
              across nine disciplines.
            </p>

            <div class="mt-6 border-t border-hair pt-4">
              <span class="font-mono text-xs font-semibold uppercase text-ink">
                Enquiry Details Captured:
              </span>
              <p class="mt-1 font-sans text-xs text-muted">
                Postgraduate discipline, paper choice, target cycle, and Paper 1
                / Paper 2 preparation needs.
              </p>
            </div>
          </div>

          <div class="mt-8 border-t border-hair pt-6">
            <Button
              href={netPrepFormUrl}
              target={isNetExternal ? '_blank' : undefined}
              rel={isNetExternal ? 'noopener noreferrer' : undefined}
              variant="primary"
              size="md"
              class="w-full justify-center"
            >
              <span>Enquire for UGC NET</span>
            </Button>
          </div>
        </div>
      </div>

      {/* 9 Subject Disciplines Grid */}
      <div class="mt-14">
        <h3 class="text-center font-serif text-xl font-normal text-ink">
          Available Subject Modules (9 Disciplines)
        </h3>
        <p class="mt-1 text-center font-sans text-xs text-muted">
          Available for both CUET PG and UGC NET subject tracks.
        </p>

        <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3">
          {
            subjects.map((subj, index) => (
              <div class="hover:border-ink/40 rounded border border-hair bg-paper p-4 transition-colors">
                <div class="flex items-center justify-between">
                  <span class="font-mono text-xs font-bold text-spark-ink">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="font-mono text-[11px] text-muted">
                    {subj.stream}
                  </span>
                </div>
                <p class="mt-2 font-serif text-lg font-normal text-ink">
                  {subj.name}
                </p>
              </div>
            ))
          }
        </div>

        <p class="mt-4 text-center font-sans text-xs italic text-muted">
          Note: Syllabi follow official national examination guidelines.
          Specific syllabus details are confirmed with students upon batch
          registration.
        </p>
      </div>
    </div>
  </Section>

  {/* FOUNDATION PACK & QUESTION BANK */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="mx-auto max-w-5xl">
      <div class="mb-10 text-center">
        <span
          class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-spark-ink"
        >
          General Aptitude & Diagnostics
        </span>
        <h2
          class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
        >
          Aptitude Foundations for Competitive Examinations
        </h2>
      </div>

      <div class="grid gap-8 md:grid-cols-2">
        {/* Foundation Pack */}
        <div
          class="flex flex-col justify-between rounded border border-hair bg-paper p-8 shadow-sm"
        >
          <div>
            <div class="flex items-center justify-between">
              <span
                class="rounded-pill bg-hair px-2.5 py-0.5 font-mono text-[11px] font-semibold text-ink"
              >
                12 Weeks
              </span>
              <span class="font-mono text-xs font-semibold text-spark-ink">
                ₹599 / month
              </span>
            </div>
            <h3 class="mt-4 font-serif text-2xl font-normal text-ink">
              Foundation Pack
            </h3>
            <p class="mt-1 font-serif text-sm italic text-muted">
              General Awareness · Logical Reasoning · Quantitative Aptitude
            </p>
            <p class="mt-4 font-sans text-sm text-muted">
              28 structured units across three core areas. Graded practice sets,
              weekly current-affairs digest, and weekly tests for comprehensive
              exam baseline mastery.
            </p>
          </div>
          <div class="mt-6 border-t border-hair pt-4">
            <Button
              href={foundationFormUrl}
              target={isFoundationExternal ? '_blank' : undefined}
              rel={isFoundationExternal ? 'noopener noreferrer' : undefined}
              variant="primary"
              size="sm"
              class="w-full justify-center"
            >
              Enquire for Foundation Pack
            </Button>
          </div>
        </div>

        {/* Question Bank */}
        <div
          class="flex flex-col justify-between rounded border border-hair bg-paper p-8 shadow-sm"
        >
          <div>
            <div class="flex items-center justify-between">
              <span
                class="rounded-pill bg-hair px-2.5 py-0.5 font-mono text-[11px] font-semibold text-ink"
              >
                6 Months Access
              </span>
              <span class="font-mono text-xs font-semibold text-spark-ink">
                ₹499 one-time
              </span>
            </div>
            <h3 class="mt-4 font-serif text-2xl font-normal text-ink">
              Exam Question Bank & Performance Profile
            </h3>
            <p class="mt-1 font-serif text-sm italic text-muted">
              Topic-wise Practice · Timed Tests · Socratic Hints
            </p>
            <p class="mt-4 font-sans text-sm text-muted">
              Topic-wise practice sets, hints before full answers, error
              logging, and periodic teacher review to identify weak areas and
              systematically improve examination speed.
            </p>
          </div>
          <div class="mt-6 border-t border-hair pt-4">
            <Button
              href={questionBankFormUrl}
              target={isQbExternal ? '_blank' : undefined}
              rel={isQbExternal ? 'noopener noreferrer' : undefined}
              variant="primary"
              size="sm"
              class="w-full justify-center"
            >
              Enquire for Question Bank
            </Button>
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* PART B, C, D: 6-MONTH PROFESSIONAL & VENTURE CAPABILITIES */}
  <Section
    theme="paper"
    padding="lg"
    class="border-b border-hair"
    id="professional-skills"
  >
    <div class="mx-auto max-w-5xl">
      <div class="text-center">
        <span
          class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-spark-ink"
        >
          Practical Employability & Enterprise
        </span>
        <h2
          class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
        >
          Three Structured 6-Month Capability Programmes
        </h2>
        <p
          class="mx-auto mt-2 max-w-2xl font-sans text-sm leading-relaxed text-muted"
        >
          Preparing for examinations is vital; building practical capabilities
          is equally essential. These six-month programmes train you to use
          modern tools, communicate professionally, and execute real business
          tasks.
        </p>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-3">
        {/* Applied AI Literacy */}
        <div
          class="flex flex-col justify-between rounded border border-hair bg-paper p-6 shadow-sm"
        >
          <div>
            <div class="flex items-center justify-between">
              <span
                class="rounded-pill bg-hair px-2.5 py-0.5 font-mono text-[11px] font-semibold text-ink"
              >
                6 Months
              </span>
              <span class="font-mono text-xs font-semibold text-spark-ink"
                >₹899 / mo</span
              >
            </div>
            <h3 class="mt-4 font-serif text-2xl font-normal text-ink">
              Applied AI Literacy
            </h3>
            <p class="mt-2 font-sans text-xs text-muted">
              AI foundations, understanding modern AI systems, prompt
              engineering, research & verification, AI writing and analysis,
              data/spreadsheet workflows, multimodal tools, automation, and
              responsible usage.
            </p>
            <ul class="mt-4 space-y-1.5 font-sans text-xs text-muted">
              <li>• Focus on applying AI to real tasks</li>
              <li>• Office workflows & no-code automation</li>
              <li>• Critical verification and fact-checking</li>
              <li>• Hands-on practical capstone deliverables</li>
            </ul>
          </div>
          <div class="mt-6 border-t border-hair pt-4">
            <Button
              href={aiLiteracyFormUrl}
              target={isAiExternal ? '_blank' : undefined}
              rel={isAiExternal ? 'noopener noreferrer' : undefined}
              variant="primary"
              size="sm"
              class="w-full justify-center"
            >
              Enquire about AI Literacy
            </Button>
          </div>
        </div>

        {/* Business Development + Internship */}
        <div
          class="border-spark/40 flex flex-col justify-between rounded border-2 bg-paper p-6 shadow-sm"
        >
          <div>
            <div class="flex items-center justify-between">
              <span
                class="bg-spark/10 rounded-pill px-2.5 py-0.5 font-mono text-[11px] font-semibold text-spark-ink"
              >
                6 Months · Flagship
              </span>
              <span class="font-mono text-xs font-semibold text-spark-ink"
                >₹899 / mo</span
              >
            </div>
            <h3 class="mt-4 font-serif text-2xl font-normal text-ink">
              Business Development
            </h3>
            <p class="mt-2 font-sans text-xs text-muted">
              <strong>Months 1–3 (Learn):</strong> Business fundamentals, customer
              discovery, market research, product development, costing, pricing, branding,
              marketing, sales, and operations.<br />
              <strong>Months 4–6 (Build):</strong> Mentored internship working on
              real Chamba venture projects.
            </p>
            <ul class="mt-4 space-y-1.5 font-sans text-xs text-muted">
              <li>• Interdisciplinary collaboration</li>
              <li>• Work on real catalogues, interviews, sales</li>
              <li>• Mentored by guides and local practitioners</li>
              <li>• Synapse Certificate on completion</li>
            </ul>
          </div>
          <div class="mt-6 border-t border-hair pt-4">
            <Button
              href={businessDevFormUrl}
              target={isBdExternal ? '_blank' : undefined}
              rel={isBdExternal ? 'noopener noreferrer' : undefined}
              variant="primary"
              size="sm"
              class="w-full justify-center"
            >
              Apply for Business Dev
            </Button>
          </div>
        </div>

        {/* Communication Skills */}
        <div
          class="flex flex-col justify-between rounded border border-hair bg-paper p-6 shadow-sm"
        >
          <div>
            <div class="flex items-center justify-between">
              <span
                class="rounded-pill bg-hair px-2.5 py-0.5 font-mono text-[11px] font-semibold text-ink"
              >
                6 Months
              </span>
              <span class="font-mono text-xs font-semibold text-spark-ink"
                >₹599 / mo</span
              >
            </div>
            <h3 class="mt-4 font-serif text-2xl font-normal text-ink">
              Communication Skills
            </h3>
            <p class="mt-2 font-sans text-xs text-muted">
              English and Hindi bilingual proficiency, professional writing,
              public speaking, presentations, group discussions, job interview
              preparation, business correspondence, and teamwork.
            </p>
            <ul class="mt-4 space-y-1.5 font-sans text-xs text-muted">
              <li>• Overcome hesitation in speaking</li>
              <li>• Professional reporting and emails</li>
              <li>• Presenting ideas and pitch decks</li>
              <li>• Regular practical exercises & feedback</li>
            </ul>
          </div>
          <div class="mt-6 border-t border-hair pt-4">
            <Button
              href={commFormUrl}
              target={isCommExternal ? '_blank' : undefined}
              rel={isCommExternal ? 'noopener noreferrer' : undefined}
              variant="primary"
              size="sm"
              class="w-full justify-center"
            >
              Enquire about Communication
            </Button>
          </div>
        </div>
      </div>

      {/* Combo Banner */}
      <div
        class="mt-8 flex flex-col items-center justify-between gap-6 rounded border border-hair bg-paper p-6 sm:flex-row sm:p-8"
      >
        <div>
          <span
            class="bg-spark/10 rounded-pill px-2.5 py-0.5 font-mono text-xs font-semibold text-spark-ink"
          >
            Recommended College Track
          </span>
          <h4 class="mt-2 font-serif text-2xl font-normal text-ink">
            AI Literacy + Business Development Combo
          </h4>
          <p class="mt-1 font-sans text-sm text-muted">
            Enrol in both programmes simultaneously for ₹1,499/month (saves
            ₹299/month vs separate enrolment).
          </p>
        </div>
        <Button
          href={comboFormUrl}
          target={isComboExternal ? '_blank' : undefined}
          rel={isComboExternal ? 'noopener noreferrer' : undefined}
          variant="secondary"
          size="md"
        >
          Enquire for Combined Track
        </Button>
      </div>
    </div>
  </Section>

  {/* TRIAL CLASS NOTICE & CLOSING */}
  <Section theme="paper" padding="lg">
    <div
      class="bg-hair/20 mx-auto max-w-3xl rounded border border-hair p-8 text-center sm:p-10"
    >
      <h3 class="font-serif text-2xl font-normal text-ink sm:text-3xl">
        Begin with a Trial Class
      </h3>
      <p
        class="mx-auto mt-3 max-w-xl font-sans text-sm leading-relaxed text-muted"
      >
        Every college student and graduate can attend 1–2 trial classes before
        confirming enrolment. We will review your academic goals and help you
        choose the right programme.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button
          href={cuetPgFormUrl}
          target={isCuetPgExternal ? '_blank' : undefined}
          rel={isCuetPgExternal ? 'noopener noreferrer' : undefined}
          variant="primary"
          size="lg"
        >
          <span>Submit Course Enquiry</span>
        </Button>
        <Button href="/contact" variant="secondary" size="lg">
          Talk to our team
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>
