---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';

import coursesData from '../../content/courses.json';
import site from '../../content/site.json';
import type { CourseItem } from '../../content/schemas';
import { getFormUrl, isFormConfigured, type FormKey } from '../../config/forms';

export function getStaticPaths() {
  const courses = (coursesData.courses || []) as CourseItem[];
  return courses.map((course) => ({
    params: { id: course.id },
    props: { course },
  }));
}

interface Props {
  course: CourseItem;
}

const { course } = Astro.props;

// Form URL resolution
const formKeyMap: Record<string, FormKey> = {
  'foundation-pack': 'foundationPack',
  'question-bank': 'questionBank',
  'subject-classes': 'subjectClasses',
  'subject-classes-entrance': 'subjectClassesEntrance',
  'school-ai-literacy': 'schoolAiLiteracy',
  'school-business-development': 'schoolBusiness',
  'school-communication': 'schoolCommunication',
  'cuet-pg-prep': 'cuetPg',
  'net-prep': 'netPrep',
  communication: 'communication',
  'business-development': 'businessDevelopment',
  'ai-literacy': 'aiLiteracy',
  'ai-business-combo': 'aiBusinessCombo',
};

const formKey = formKeyMap[course.id] || 'courseGeneral';
const formUrl = getFormUrl(formKey);
const isExternalForm = isFormConfigured(formKey);

const formattedPrice = course.price_inr
  ? `₹${course.price_inr.toLocaleString('en-IN')}`
  : course.price_display || 'Enquire';
---

<BaseLayout
  title={`${course.title} — ${site.name}`}
  description={course.subtitle ||
    `Detailed syllabus, schedule, fees and enrolment for ${course.title} at Synapse.`}
>
  {/* Course Hero */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="mx-auto max-w-4xl">
      <nav aria-label="Breadcrumb" class="mb-6 font-mono text-xs text-muted">
        <a
          href="/courses"
          class="hover:text-ink focus-visible:outline-2 focus-visible:outline-spark"
          >Courses</a
        >
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-ink">{course.title}</span>
      </nav>

      <div class="flex flex-wrap items-center gap-2">
        {
          course.audience.map((aud) => (
            <span class="bg-hair/50 rounded-sm px-2.5 py-1 font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink">
              {aud}
            </span>
          ))
        }
        {
          course.duration && (
            <span class="font-mono text-xs text-muted">
              · Duration: {course.duration}
            </span>
          )
        }
      </div>

      <h1
        class="mt-4 font-serif text-display-xl-mobile font-normal text-ink sm:text-display-lg"
      >
        {course.title}
      </h1>

      {
        course.subtitle && (
          <p class="mt-2 font-serif text-xl italic text-muted sm:text-2xl">
            {course.subtitle}
          </p>
        )
      }

      {/* Pricing Strip */}
      <div
        class="bg-hair/20 my-8 flex flex-wrap items-baseline gap-4 rounded border border-hair p-6"
      >
        <div>
          <span class="font-serif text-3xl font-semibold text-ink sm:text-4xl">
            {formattedPrice}
          </span>
          {
            course.billing && (
              <span class="font-sans text-sm font-medium text-muted">
                / {course.billing}
              </span>
            )
          }
        </div>

        {
          course.total_at_listed_monthly_rate_inr && (
            <div class="border-l border-hair pl-4 font-mono text-xs text-muted">
              Total 6-month programme: ₹
              {course.total_at_listed_monthly_rate_inr.toLocaleString('en-IN')}
            </div>
          )
        }

        {
          course.monthly_saving_inr && (
            <div class="border-l border-hair pl-4 font-mono text-xs font-semibold text-spark-ink">
              Saves ₹{course.monthly_saving_inr}/month vs separate enrolment
            </div>
          )
        }
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <Button
          href={formUrl}
          target={isExternalForm ? '_blank' : undefined}
          rel={isExternalForm ? 'noopener noreferrer' : undefined}
          variant="primary"
          size="lg"
        >
          <span>Enquire about this course</span>
          {
            isExternalForm && (
              <svg
                class="ml-1 h-4 w-4 opacity-80"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                />
              </svg>
            )
          }
        </Button>

        <Button href="/contact" variant="secondary" size="lg">
          Ask a question
        </Button>
      </div>

      <p class="mt-3 font-sans text-xs text-muted">
        Offline classroom batches in Chamba · 1–2 trial classes before payment ·
        Exact batch times confirmed on enquiry
      </p>
    </div>
  </Section>

  {/* What is Included Overview */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="mx-auto max-w-4xl">
      <h2 class="font-serif text-headline-sm font-normal text-ink">
        What is included
      </h2>
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
          course.includes.map((item) => (
            <div class="flex items-start gap-3 rounded border border-hair bg-paper p-4">
              <span
                class="mt-1 h-2 w-2 shrink-0 rounded-full bg-spark"
                aria-hidden="true"
              />
              <span class="font-sans text-sm leading-relaxed text-ink">
                {item}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  {/* Subjects List if available */}
  {
    course.subjects && course.subjects.length > 0 && (
      <Section theme="paper" padding="lg" class="border-b border-hair">
        <div class="mx-auto max-w-4xl">
          <span class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink">
            Subject Options
          </span>
          <h2 class="mt-2 font-serif text-headline-sm font-normal text-ink">
            Available Subject Modules
          </h2>
          <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3">
            {course.subjects.map((subj) => (
              <div class="rounded border border-hair bg-paper p-4 text-center">
                <span class="font-sans text-base font-medium text-ink">
                  {subj}
                </span>
              </div>
            ))}
          </div>
          {course.availability_note && (
            <p class="mt-4 font-sans text-xs text-muted">
              * {course.availability_note}
            </p>
          )}
        </div>
      </Section>
    )
  }

  {/* Foundation Pack Syllabus Details */}
  {
    course.id === 'foundation-pack' &&
      typeof course.modules === 'object' &&
      !Array.isArray(course.modules) && (
        <Section theme="paper" padding="lg" class="border-b border-hair">
          <div class="mx-auto max-w-4xl space-y-12">
            <div>
              <span class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink">
                Structured 12-Week Syllabus
              </span>
              <h2 class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md">
                28 Structured Units Across Three Subjects
              </h2>
              <p class="mt-3 font-sans text-sm leading-relaxed text-muted">
                Learning rhythm: Concept lesson → guided examples → practice set
                → weekly test → review of mistakes. Current affairs are revised
                weekly.
              </p>
            </div>

            {/* General Awareness */}
            {course.modules.general_awareness && (
              <div class="rounded border border-hair bg-paper p-6 sm:p-8">
                <div class="flex items-baseline justify-between border-b border-hair pb-4">
                  <h3 class="font-serif text-2xl font-normal text-ink">
                    A. General Awareness
                  </h3>
                  <span class="font-mono text-xs font-semibold text-spark-ink">
                    10 Units
                  </span>
                </div>
                <ol class="mt-6 space-y-3 font-sans text-sm text-muted">
                  {course.modules.general_awareness.map((unit, index) => (
                    <li class="flex items-start gap-3">
                      <span class="font-mono text-xs font-bold text-spark-ink">
                        {String(index + 1).padStart(2, '0')}.
                      </span>
                      <span class="text-ink">{unit}</span>
                    </li>
                  ))}
                </ol>
              </div>
            )}

            {/* Reasoning */}
            {course.modules.reasoning && (
              <div class="rounded border border-hair bg-paper p-6 sm:p-8">
                <div class="flex items-baseline justify-between border-b border-hair pb-4">
                  <h3 class="font-serif text-2xl font-normal text-ink">
                    B. Logical and Analytical Reasoning
                  </h3>
                  <span class="font-mono text-xs font-semibold text-spark-ink">
                    8 Units
                  </span>
                </div>
                <ol class="mt-6 space-y-3 font-sans text-sm text-muted">
                  {course.modules.reasoning.map((unit, index) => (
                    <li class="flex items-start gap-3">
                      <span class="font-mono text-xs font-bold text-spark-ink">
                        {String(index + 1).padStart(2, '0')}.
                      </span>
                      <span class="text-ink">{unit}</span>
                    </li>
                  ))}
                </ol>
              </div>
            )}

            {/* Quantitative Aptitude */}
            {course.modules.quantitative_aptitude && (
              <div class="rounded border border-hair bg-paper p-6 sm:p-8">
                <div class="flex items-baseline justify-between border-b border-hair pb-4">
                  <h3 class="font-serif text-2xl font-normal text-ink">
                    C. Quantitative Aptitude
                  </h3>
                  <span class="font-mono text-xs font-semibold text-spark-ink">
                    10 Units
                  </span>
                </div>
                <ol class="mt-6 space-y-3 font-sans text-sm text-muted">
                  {course.modules.quantitative_aptitude.map((unit, index) => (
                    <li class="flex items-start gap-3">
                      <span class="font-mono text-xs font-bold text-spark-ink">
                        {String(index + 1).padStart(2, '0')}.
                      </span>
                      <span class="text-ink">{unit}</span>
                    </li>
                  ))}
                </ol>
              </div>
            )}
          </div>
        </Section>
      )
  }

  {/* Question Bank Details */}
  {
    course.id === 'question-bank' && (
      <Section theme="paper" padding="lg" class="border-b border-hair">
        <div class="mx-auto max-w-4xl space-y-8">
          <div>
            <span class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink">
              Structured Practice & Diagnostics
            </span>
            <h2 class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md">
              Exam Question Bank & Performance Profile
            </h2>
          </div>

          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            <div class="rounded border border-hair bg-paper p-6">
              <h3 class="font-serif text-xl font-normal text-ink">
                Practice Modes
              </h3>
              <ul class="mt-4 space-y-2.5 font-sans text-sm text-muted">
                <li>• Topic-wise and chapter-wise practice sets</li>
                <li>• Mixed practice sets under timed conditions</li>
                <li>• Progressive hints before showing full solutions</li>
                <li>
                  • Revision reminders for questions due for another attempt
                </li>
              </ul>
            </div>

            <div class="rounded border border-hair bg-paper p-6">
              <h3 class="font-serif text-xl font-normal text-ink">
                Learner Performance Profile
              </h3>
              <ul class="mt-4 space-y-2.5 font-sans text-sm text-muted">
                <li>• Accuracy and speed indicators per topic</li>
                <li>• Error log tracking recurring misconceptions</li>
                <li>• Weekly push list of focus areas for improvement</li>
                <li>
                  • Periodic teacher review comparing digital and paper results
                </li>
              </ul>
            </div>
          </div>
        </div>
      </Section>
    )
  }

  {/* Business Development Details */}
  {
    course.id === 'business-development' && (
      <Section theme="paper" padding="lg" class="border-b border-hair">
        <div class="mx-auto max-w-4xl space-y-10">
          <div>
            <span class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink">
              6-Month Programme Structure
            </span>
            <h2 class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md">
              Three Months Learn · Three Months Build
            </h2>
            <p class="mt-3 font-sans text-sm text-muted">
              ₹899/month for all six months (total fee ₹5,394).
            </p>
          </div>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div class="rounded border border-hair bg-paper p-6">
              <h3 class="font-serif text-xl font-normal text-ink">
                Months 1–3: Learn
              </h3>
              <p class="mt-2 font-sans text-xs text-muted">
                Business fundamentals, customer discovery, market research,
                product development, costing and pricing, branding and
                positioning, marketing, sales, and operations.
              </p>
            </div>

            <div class="rounded border border-hair bg-paper p-6">
              <h3 class="font-serif text-xl font-normal text-ink">
                Months 4–6: Build
              </h3>
              <p class="mt-2 font-sans text-xs text-muted">
                Students collaborate in interdisciplinary teams on actual
                venture challenges and create real project deliverables across
                Chamba ventures.
              </p>
            </div>
          </div>
        </div>
      </Section>
    )
  }

  {/* Closing CTA */}
  <Section theme="paper" padding="lg">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-serif text-headline-sm font-normal text-ink">
        Ready to get started?
      </h2>
      <p class="mx-auto mt-3 max-w-xl font-sans text-base text-muted">
        Attend 1–2 trial classes at our learning centre in Chamba. Meet the
        guides, review the materials, and decide if the programme is right for
        you.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button
          href={formUrl}
          target={isExternalForm ? '_blank' : undefined}
          rel={isExternalForm ? 'noopener noreferrer' : undefined}
          variant="primary"
          size="lg"
        >
          <span>Enquire now</span>
        </Button>
        <Button href="/contact" variant="secondary" size="lg">
          Talk to our team
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>
