---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import CourseCard from '../../components/brand/CourseCard.astro';
import Button from '../../components/ui/Button.astro';

import coursesData from '../../content/courses.json';
import site from '../../content/site.json';
import type { CourseItem } from '../../content/schemas';
import { getFormUrl, isFormConfigured } from '../../config/forms';

const courses = (coursesData.courses || []) as CourseItem[];

const generalFormUrl = getFormUrl('courseGeneral');
const isGeneralExternal = isFormConfigured('courseGeneral');
---

<BaseLayout
  title={`Courses & Programmes — ${site.name}`}
  description="Explore our structured offline classroom courses in Chamba: Class 11–12 Subject Classes, JEE/NEET Preparation, CUET PG & NET Subject Coaching, Applied AI Literacy, Business Development, and Communication."
>
  {/* Header */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="mx-auto max-w-4xl text-center">
      <span
        class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-spark-ink"
      >
        Structured Curricula · Transparent Fees
      </span>
      <h1
        class="mt-4 font-serif text-display-lg-mobile font-normal text-ink sm:text-display-lg"
      >
        Courses & Programmes
      </h1>
      <p
        class="mx-auto mt-4 max-w-2xl font-sans text-base leading-relaxed text-muted sm:text-body-lg"
      >
        Every course has a published curriculum, clear pricing, and offline
        classroom batches at our Chamba centre behind the Post Office. Attend
        1–2 trial classes before confirming enrolment.
      </p>

      {/* Quick Jump Anchors */}
      <div class="mt-8 flex flex-wrap justify-center gap-2">
        <a
          href="#school-students"
          class="rounded-pill border border-hair bg-paper px-4 py-2 font-mono text-xs font-medium text-muted transition-colors hover:border-ink hover:text-ink focus-visible:outline-2 focus-visible:outline-spark"
        >
          School Students
        </a>
        <a
          href="#college-exams"
          class="rounded-pill border border-hair bg-paper px-4 py-2 font-mono text-xs font-medium text-muted transition-colors hover:border-ink hover:text-ink focus-visible:outline-2 focus-visible:outline-spark"
        >
          College & Competitive Exams
        </a>
        <a
          href="#business-development"
          class="rounded-pill border border-hair bg-paper px-4 py-2 font-mono text-xs font-medium text-muted transition-colors hover:border-ink hover:text-ink focus-visible:outline-2 focus-visible:outline-spark"
        >
          Employability & Venture Skills
        </a>
        <a
          href="#institutional"
          class="rounded-pill border border-hair bg-paper px-4 py-2 font-mono text-xs font-medium text-muted transition-colors hover:border-ink hover:text-ink focus-visible:outline-2 focus-visible:outline-spark"
        >
          For Institutions
        </a>
      </div>
    </div>
  </Section>

  {/* All Courses Grid */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="mb-12">
      <span
        class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink"
      >
        Complete Catalogue
      </span>
      <h2
        class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
      >
        All Programme Offerings
      </h2>
      <p class="mt-2 font-sans text-sm text-muted">
        Select any course to view full details, syllabus units, or submit an
        enquiry.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
      {courses.map((course) => <CourseCard course={course} />)}
    </div>
  </Section>

  {/* Audience Groups for Easy Filtering */}
  <Section
    theme="paper"
    padding="lg"
    class="border-b border-hair"
    id="school-students"
  >
    <div
      class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"
    >
      <div>
        <span
          class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink"
        >
          Audience Guide
        </span>
        <h2
          class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
        >
          For School Students (Classes 8–12)
        </h2>
        <p class="mt-2 max-w-2xl font-sans text-sm text-muted">
          Subject classes in Science and Commerce, dedicated entrance
          preparation, and 6-month capability programmes.
        </p>
      </div>
      <a
        href="/school"
        class="font-mono text-xs font-semibold text-spark-ink hover:underline"
      >
        View dedicated School page →
      </a>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <div class="rounded border border-hair bg-paper p-6">
        <h3 class="font-serif text-xl font-normal text-ink">
          Regular Subject Classes
        </h3>
        <p class="mt-1 font-mono text-xs text-spark-ink">
          ₹599 / subject / month
        </p>
        <p class="mt-3 font-sans text-sm text-muted">
          Physics, Chemistry, Biology, Mathematics, Economics, Accountancy.
          Board + CUET foundation.
        </p>
        <div class="mt-4">
          <a
            href="/courses/subject-classes"
            class="font-sans text-xs font-semibold text-spark-ink hover:underline"
          >
            View details →
          </a>
        </div>
      </div>

      <div class="border-spark/40 rounded border-2 bg-paper p-6">
        <h3 class="font-serif text-xl font-normal text-ink">
          JEE / NEET Preparation
        </h3>
        <p class="mt-1 font-mono text-xs text-spark-ink">
          ₹799 / subject / month
        </p>
        <p class="mt-3 font-sans text-sm text-muted">
          Intensive entrance preparation until the examination. PCM for JEE, PCB
          for NEET.
        </p>
        <div class="mt-4">
          <a
            href="/courses/subject-classes-entrance"
            class="font-sans text-xs font-semibold text-spark-ink hover:underline"
          >
            View details →
          </a>
        </div>
      </div>

      <div class="rounded border border-hair bg-paper p-6">
        <h3 class="font-serif text-xl font-normal text-ink">
          Capability Programmes
        </h3>
        <p class="mt-1 font-mono text-xs text-spark-ink">6 Months · Enquire</p>
        <p class="mt-3 font-sans text-sm text-muted">
          AI Literacy, Business Development, and Communication Skills designed
          specifically for school students.
        </p>
        <div class="mt-4">
          <a
            href="/school#capability-programmes"
            class="font-sans text-xs font-semibold text-spark-ink hover:underline"
          >
            View school programmes →
          </a>
        </div>
      </div>
    </div>
  </Section>

  {/* College Students & Aspirants */}
  <Section
    theme="paper"
    padding="lg"
    class="border-b border-hair"
    id="college-exams"
  >
    <div
      class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"
    >
      <div>
        <span
          class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink"
        >
          Audience Guide
        </span>
        <h2
          class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
        >
          For College Students & Exam Aspirants
        </h2>
        <p class="mt-2 max-w-2xl font-sans text-sm text-muted">
          Postgraduate entrance, national eligibility tests, and comprehensive
          aptitude preparation.
        </p>
      </div>
      <a
        href="/college"
        class="font-mono text-xs font-semibold text-spark-ink hover:underline"
      >
        View dedicated College page →
      </a>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <div class="rounded border border-hair bg-paper p-6">
        <h3 class="font-serif text-xl font-normal text-ink">
          CUET PG & UGC NET
        </h3>
        <p class="mt-1 font-mono text-xs text-spark-ink">
          9 Disciplines · Enquire
        </p>
        <p class="mt-3 font-sans text-sm text-muted">
          Specialised subject coaching across 9 disciplines: Physics, Chemistry,
          Zoology, Mathematics, Botany, Economics, History, Geography,
          Psychology.
        </p>
        <div class="mt-4">
          <a
            href="/college#cuet-net"
            class="font-sans text-xs font-semibold text-spark-ink hover:underline"
          >
            View modules →
          </a>
        </div>
      </div>

      <div class="rounded border border-hair bg-paper p-6">
        <h3 class="font-serif text-xl font-normal text-ink">Foundation Pack</h3>
        <p class="mt-1 font-mono text-xs text-spark-ink">
          ₹599 / month (12 weeks)
        </p>
        <p class="mt-3 font-sans text-sm text-muted">
          28 structured units across General Awareness, Logical Reasoning, and
          Quantitative Aptitude.
        </p>
        <div class="mt-4">
          <a
            href="/courses/foundation-pack"
            class="font-sans text-xs font-semibold text-spark-ink hover:underline"
          >
            View syllabus →
          </a>
        </div>
      </div>

      <div class="rounded border border-hair bg-paper p-6">
        <h3 class="font-serif text-xl font-normal text-ink">
          Exam Question Bank
        </h3>
        <p class="mt-1 font-mono text-xs text-spark-ink">
          ₹499 one-time (6 months)
        </p>
        <p class="mt-3 font-sans text-sm text-muted">
          Practice questions, timed mock tests, accuracy profiles, and error
          analysis across target exams.
        </p>
        <div class="mt-4">
          <a
            href="/courses/question-bank"
            class="font-sans text-xs font-semibold text-spark-ink hover:underline"
          >
            View details →
          </a>
        </div>
      </div>
    </div>
  </Section>

  {/* Employability & Business */}
  <Section
    theme="paper"
    padding="lg"
    class="border-b border-hair"
    id="business-development"
  >
    <div
      class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"
    >
      <div>
        <span
          class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink"
        >
          Audience Guide
        </span>
        <h2
          class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
        >
          Employability, AI & Venture Building
        </h2>
        <p class="mt-2 max-w-2xl font-sans text-sm text-muted">
          Practical modern skills, applied AI workflows, and hands-on venture
          experience in Chamba.
        </p>
      </div>
      <a
        href="/ventures"
        class="font-mono text-xs font-semibold text-spark-ink hover:underline"
      >
        Explore Chamba Ventures →
      </a>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <div class="border-spark/40 rounded border-2 bg-paper p-6">
        <h3 class="font-serif text-xl font-normal text-ink">
          Business Development + Internship
        </h3>
        <p class="mt-1 font-mono text-xs text-spark-ink">
          ₹899 / month (6 months)
        </p>
        <p class="mt-3 font-sans text-sm text-muted">
          Months 1–3: Learn (fundamentals, market research, sales, costing).
          Months 4–6: Build (mentored Chamba venture internship).
        </p>
        <div class="mt-4">
          <a
            href="/courses/business-development"
            class="font-sans text-xs font-semibold text-spark-ink hover:underline"
          >
            View programme →
          </a>
        </div>
      </div>

      <div class="rounded border border-hair bg-paper p-6">
        <h3 class="font-serif text-xl font-normal text-ink">
          Applied AI Literacy
        </h3>
        <p class="mt-1 font-mono text-xs text-spark-ink">
          ₹899 / month (6 months)
        </p>
        <p class="mt-3 font-sans text-sm text-muted">
          Understand, use, and apply AI tools to study, research, data, and
          workplace automation tasks.
        </p>
        <div class="mt-4">
          <a
            href="/courses/ai-literacy"
            class="font-sans text-xs font-semibold text-spark-ink hover:underline"
          >
            View curriculum →
          </a>
        </div>
      </div>

      <div class="rounded border border-hair bg-paper p-6">
        <h3 class="font-serif text-xl font-normal text-ink">
          Communication Skills
        </h3>
        <p class="mt-1 font-mono text-xs text-spark-ink">
          ₹599 / month (6 months)
        </p>
        <p class="mt-3 font-sans text-sm text-muted">
          English and Hindi fluency, professional writing, public speaking,
          presentations, and interviews.
        </p>
        <div class="mt-4">
          <a
            href="/courses/communication"
            class="font-sans text-xs font-semibold text-spark-ink hover:underline"
          >
            View curriculum →
          </a>
        </div>
      </div>
    </div>
  </Section>

  {/* Institutional Guide */}
  <Section
    theme="paper"
    padding="lg"
    class="border-b border-hair"
    id="institutional"
  >
    <div
      class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"
    >
      <div>
        <span
          class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink"
        >
          For Schools & Colleges
        </span>
        <h2
          class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
        >
          Four Institutional Services
        </h2>
        <p class="mt-2 max-w-2xl font-sans text-sm text-muted">
          We collaborate with schools and colleges to conduct structured classes
          using existing school infrastructure.
        </p>
      </div>
      <a
        href="/schools-colleges"
        class="font-mono text-xs font-semibold text-spark-ink hover:underline"
      >
        View Institutional details →
      </a>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded border border-hair bg-paper p-5">
        <span class="font-mono text-xs font-bold text-spark-ink">01</span>
        <h3 class="mt-2 font-serif text-lg font-normal text-ink">
          AI Literacy
        </h3>
        <p class="mt-1 font-sans text-xs text-muted">
          Classes on AI tools, research, verification, and productivity.
        </p>
      </div>
      <div class="rounded border border-hair bg-paper p-5">
        <span class="font-mono text-xs font-bold text-spark-ink">02</span>
        <h3 class="mt-2 font-serif text-lg font-normal text-ink">
          Robotics & ATL
        </h3>
        <p class="mt-1 font-sans text-xs text-muted">
          Teaching and projects utilizing your school's existing lab equipment.
        </p>
      </div>
      <div class="rounded border border-hair bg-paper p-5">
        <span class="font-mono text-xs font-bold text-spark-ink">03</span>
        <h3 class="mt-2 font-serif text-lg font-normal text-ink">
          Business Dev
        </h3>
        <p class="mt-1 font-sans text-xs text-muted">
          Youth entrepreneurship, customer discovery, costing, and sales.
        </p>
      </div>
      <div class="rounded border border-hair bg-paper p-5">
        <span class="font-mono text-xs font-bold text-spark-ink">04</span>
        <h3 class="mt-2 font-serif text-lg font-normal text-ink">
          Communication
        </h3>
        <p class="mt-1 font-sans text-xs text-muted">
          Bilingual fluency, public speaking, writing, and team discussion.
        </p>
      </div>
    </div>
  </Section>

  {/* Common Pricing Principles */}
  <Section theme="paper" padding="lg">
    <div
      class="bg-hair/20 mx-auto max-w-3xl rounded border border-hair p-8 sm:p-10"
    >
      <h3 class="font-serif text-2xl font-normal text-ink">
        How pricing and payments work
      </h3>
      <ul class="mt-4 space-y-3 font-sans text-sm text-muted">
        <li class="flex items-start gap-2">
          <span
            class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-spark"
            aria-hidden="true"></span>
          <span
            ><strong>Transparent rates:</strong> Every fee is published above. No
            hidden charges or automatic recurring checkout subscriptions.</span
          >
        </li>
        <li class="flex items-start gap-2">
          <span
            class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-spark"
            aria-hidden="true"></span>
          <span
            ><strong>Trial classes:</strong> Attend one or two trial classes before
            payment so you know the course is right for you.</span
          >
        </li>
        <li class="flex items-start gap-2">
          <span
            class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-spark"
            aria-hidden="true"></span>
          <span
            ><strong>No website checkout:</strong> Every CTA is an enquiry. Payment
            arrangements are shared after your trial class.</span
          >
        </li>
      </ul>

      <div class="mt-8">
        <Button
          href={generalFormUrl}
          target={isGeneralExternal ? '_blank' : undefined}
          rel={isGeneralExternal ? 'noopener noreferrer' : undefined}
          variant="primary"
          size="md"
        >
          <span>Enquire about any course</span>
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>
