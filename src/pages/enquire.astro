---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';

import site from '../content/site.json';
import { getFormUrl, isFormConfigured } from '../config/forms';

const generalFormUrl = getFormUrl('courseGeneral');
const isGeneralExternal = isFormConfigured('courseGeneral');

const bdFormUrl = getFormUrl('internshipApplication');
const isBdExternal = isFormConfigured('internshipApplication');

const institutionFormUrl = getFormUrl('institutionEnquiry');
const isInstitutionExternal = isFormConfigured('institutionEnquiry');
---

<BaseLayout
  title={`Admissions & Enquire — ${site.name}`}
  description="Submit an enquiry for offline courses in Chamba, the Business Development venture internship, or school and college partnerships with Synapse."
>
  {/* Header */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="mx-auto max-w-4xl text-center">
      <span
        class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-spark-ink"
      >
        Admissions & Enquiries
      </span>
      <h1
        class="mt-4 font-serif text-display-lg-mobile font-normal text-ink sm:text-display-lg"
      >
        How would you like to connect?
      </h1>
      <p
        class="mx-auto mt-4 max-w-2xl font-sans text-base leading-relaxed text-muted sm:text-body-lg"
      >
        Choose the relevant enquiry option below. We arrange one or two trial
        classes before payment and confirm all batch schedules directly with
        you.
      </p>
    </div>
  </Section>

  {/* Three Enquiry Pathways */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="mx-auto max-w-4xl">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        {/* Pathway 1 */}
        <div
          class="flex flex-col justify-between rounded border border-hair bg-paper p-6 sm:p-8"
        >
          <div>
            <span class="font-mono text-xs font-bold text-spark-ink"
              >Option 01</span
            >
            <h2 class="mt-2 font-serif text-2xl font-normal text-ink">
              Course Enquiry
            </h2>
            <p class="mt-3 font-sans text-sm leading-relaxed text-muted">
              For students and parents enquiring about the Foundation Pack,
              Question Bank, Subject Classes, Communication, or AI Literacy.
            </p>
            <ul class="mt-4 space-y-1.5 font-sans text-xs text-muted">
              <li>• School students (Classes 8–12)</li>
              <li>• Exam aspirants (CUET, NEET, JEE, NDA)</li>
              <li>• College skill learners</li>
            </ul>
          </div>
          <div class="border-hair/60 mt-8 border-t pt-5">
            <Button
              href={generalFormUrl}
              target={isGeneralExternal ? '_blank' : undefined}
              rel={isGeneralExternal ? 'noopener noreferrer' : undefined}
              variant="primary"
              size="sm"
              class="w-full justify-center"
            >
              <span>Enquire for a Course</span>
            </Button>
          </div>
        </div>

        {/* Pathway 2 */}
        <div
          class="flex flex-col justify-between rounded border border-hair bg-paper p-6 sm:p-8"
        >
          <div>
            <span class="font-mono text-xs font-bold text-spark-ink"
              >Option 02</span
            >
            <h2 class="mt-2 font-serif text-2xl font-normal text-ink">
              Venture Internship
            </h2>
            <p class="mt-3 font-sans text-sm leading-relaxed text-muted">
              For bachelor’s degree students applying to the six-month Business
              Development programme with an internship on a Chamba venture.
            </p>
            <ul class="mt-4 space-y-1.5 font-sans text-xs text-muted">
              <li>• 3 months learning + 3 months internship</li>
              <li>• Real work on local Chamba ventures</li>
              <li>• Synapse Certificate on completion</li>
            </ul>
          </div>
          <div class="border-hair/60 mt-8 border-t pt-5">
            <Button
              href={bdFormUrl}
              target={isBdExternal ? '_blank' : undefined}
              rel={isBdExternal ? 'noopener noreferrer' : undefined}
              variant="primary"
              size="sm"
              class="w-full justify-center"
            >
              <span>Apply for Internship</span>
            </Button>
          </div>
        </div>

        {/* Pathway 3 */}
        <div
          class="flex flex-col justify-between rounded border border-hair bg-paper p-6 sm:p-8"
        >
          <div>
            <span class="font-mono text-xs font-bold text-spark-ink"
              >Option 03</span
            >
            <h2 class="mt-2 font-serif text-2xl font-normal text-ink">
              Schools & Colleges
            </h2>
            <p class="mt-3 font-sans text-sm leading-relaxed text-muted">
              For principals, teachers, and coordinators interested in
              introductory student sessions, baseline diagnostic days, or group
              enrolment.
            </p>
            <ul class="mt-4 space-y-1.5 font-sans text-xs text-muted">
              <li>• Interactive workshops & demos</li>
              <li>• Diagnostic baseline assessments</li>
              <li>• Custom group enrolment</li>
            </ul>
          </div>
          <div class="border-hair/60 mt-8 border-t pt-5">
            <Button
              href={institutionFormUrl}
              target={isInstitutionExternal ? '_blank' : undefined}
              rel={isInstitutionExternal ? 'noopener noreferrer' : undefined}
              variant="primary"
              size="sm"
              class="w-full justify-center"
            >
              <span>Institutional Enquiry</span>
            </Button>
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* Direct Contact Alternatives */}
  <Section theme="paper" padding="lg">
    <div
      class="bg-hair/20 mx-auto max-w-3xl rounded border border-hair p-8 text-center sm:p-10"
    >
      <h3 class="font-serif text-2xl font-normal text-ink">
        Prefer to talk directly?
      </h3>
      <p class="mx-auto mt-3 max-w-xl font-sans text-sm text-muted">
        Call or message us on WhatsApp. Our team responds {site.callbackWindow}.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <Button
          href={`https://wa.me/91${site.phone}?text=${encodeURIComponent('Hello Synapse, I want to enquire about courses and admissions.')}`}
          target="_blank"
          rel="noopener noreferrer"
          variant="primary"
          size="md"
        >
          Message on WhatsApp (+91 {site.phone})
        </Button>
        <Button href="/contact" variant="secondary" size="md">
          View Office & Email Details
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>
