---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Button from '../../components/ui/Button.astro';
import StatusChip from '../../components/ui/StatusChip.astro';
import DoorCard from '../../components/ui/DoorCard.astro';
import Building from '../../components/brand/Building.astro';
import ThreeWorlds from '../../components/brand/ThreeWorlds.astro';
import LoopDiagram from '../../components/brand/LoopDiagram.astro';

import site from '../../content/hi/site.json';
import homeRaw from '../../content/hi/home.json';
import programmesRaw from '../../content/hi/programmes.json';
import floorsRaw from '../../content/floors.json';
import principlesRaw from '../../content/principles.json';
import doorsRaw from '../../content/hi/doors.json';

import type {
  HomeContent,
  ProgrammesContent,
  FloorsContent,
  PrinciplesContent,
  DoorsContent,
} from '../../content/schemas';

const home = homeRaw as HomeContent;
const programmes = programmesRaw as ProgrammesContent;
const floors = floorsRaw as FloorsContent;
const principles = principlesRaw as PrinciplesContent;
const doors = doorsRaw as DoorsContent;
---

<BaseLayout
  title={`${site.name} — ${site.tagline}`}
  description={site.subline}
  lang="hi"
  activeFloor="g"
>
  {/* SECTION 1: HERO (Nocturnal Ink Canvas) */}
  <Section id="hero" theme="ink" padding="lg" class="border-b border-hair-ink">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-8">
      {/* Left Column: Headline, Plain Subline, Strip, CTAs */}
      <div class="lg:col-span-7">
        <div
          class="mb-4 inline-flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-[0.14em] text-spark-glow"
        >
          <span>{home.hero.eyebrow}</span>
        </div>

        {/* The SINGLE <h1> on the page */}
        <h1
          class="mb-6 font-serif text-display-xl-mobile font-normal leading-[1.02] tracking-[-0.03em] text-paper sm:text-display-lg lg:text-display-xl"
        >
          सीखो। सिखाओ। बनाओ। <span class="italic text-spark-glow">दिखाओ।</span>
        </h1>

        <p
          class="text-paper/90 mb-8 max-w-xl font-body text-base leading-relaxed sm:text-body-lg"
        >
          {home.hero.sub}
        </p>

        {/* Open Now Strip */}
        <div
          class="bg-ink/80 mb-8 flex flex-col gap-2 rounded border border-hair-ink p-4 sm:flex-row sm:items-center sm:gap-4"
        >
          <div class="flex items-center gap-2">
            <span
              class="h-2 w-2 shrink-0 rounded-full bg-spark-glow"
              aria-hidden="true"></span>
            <span
              class="font-sans text-xs font-semibold uppercase tracking-[0.12em] text-paper"
            >
              {home.hero.stripLabel}
            </span>
          </div>
          <span class="hidden text-hair-ink sm:inline" aria-hidden="true"
            >·</span
          >
          <span class="font-body text-xs text-muted-on-ink">
            {home.hero.strip}
          </span>
        </div>

        {/* Primary & Secondary CTAs */}
        <div class="flex flex-wrap items-center gap-4">
          <Button
            href={home.hero.primaryCta.href}
            variant="primary"
            onDark={true}
          >
            {home.hero.primaryCta.label}
          </Button>
          <Button
            href={home.hero.secondaryCta.href}
            variant="ghost"
            onDark={true}
          >
            {home.hero.secondaryCta.label}
          </Button>
        </div>
      </div>

      {/* Right Column: Isometric Architectural Drawing */}
      <div
        class="flex items-center justify-center lg:col-span-5"
        aria-hidden="true"
      >
        <div class="w-full max-w-md lg:max-w-none">
          <Building active="g" scrollThread={true} onDark={true} />
        </div>
      </div>
    </div>
  </Section>

  {/* SECTION 2: WHAT IS OPEN NOW (The Chamba Classroom) */}
  <Section
    id="open-now"
    theme="paper"
    padding="lg"
    class="border-b border-hair"
  >
    <SectionHeader
      number={home.openNow.number}
      label={home.openNow.label}
      title={home.openNow.title}
      sub={home.openNow.sub}
    />

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
      {/* Left: Tracks Overview & Structure */}
      <div class="lg:col-span-7">
        <p
          class="mb-6 font-body text-base leading-relaxed text-muted sm:text-body-lg"
        >
          {home.openNow.lead}
        </p>

        {/* 4 Launch Tracks */}
        <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {
            programmes.tracks.map((track) => (
              <div class="rounded border border-hair bg-paper p-5">
                <div class="mb-2 flex items-center justify-between">
                  <span class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink">
                    {track.name}
                  </span>
                  <StatusChip status={track.status} />
                </div>
                <p class="font-body text-xs leading-relaxed text-muted">
                  {track.exams.join(', ')}
                </p>
              </div>
            ))
          }
        </div>

        {/* Baseline Diagnostic Note */}
        <div class="bg-surface-dim/30 mb-8 rounded border border-hair p-4">
          <div class="mb-1 flex items-center justify-between">
            <span
              class="font-mono text-xs font-semibold uppercase tracking-wider text-ink"
            >
              {programmes.baseline.name}
            </span>
            <StatusChip status={programmes.baseline.status} />
          </div>
          <p class="font-body text-xs text-muted">
            {programmes.baseline.description}
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-4">
          <Button href={home.openNow.cta.href} variant="primary" size="md">
            {home.openNow.cta.label}
          </Button>
          <Button href="/hi/programmes" variant="secondary" size="md">
            पूर्ण विवरण एवं समय-सारणी
          </Button>
        </div>
      </div>

      {/* Right: Operational Schedule Card */}
      <div class="lg:col-span-5">
        <div class="bg-surface-dim/30 rounded border border-hair p-6 sm:p-8">
          <span
            class="mb-2 block font-mono text-xs font-semibold uppercase tracking-[0.14em] text-spark-ink"
          >
            कक्षा का समय
          </span>
          <h3 class="mb-4 font-serif text-2xl font-normal text-ink">
            {programmes.schedule.hours}
          </h3>
          <p class="mb-6 font-body text-sm leading-relaxed text-muted">
            {programmes.schedule.attendanceRule}
          </p>

          <div class="space-y-3 border-t border-hair pt-4 font-body text-xs">
            <div class="border-hair/50 flex justify-between border-b py-1">
              <span class="font-medium text-ink">दिन</span>
              <span class="text-muted">{programmes.schedule.days}</span>
            </div>
            <div class="border-hair/50 flex justify-between border-b py-1">
              <span class="font-medium text-ink">स्थान</span>
              <span class="text-muted">{site.place}</span>
            </div>
            <div class="border-hair/50 flex justify-between border-b py-1">
              <span class="font-medium text-ink">फीस</span>
              <span class="font-medium text-spark-ink">
                {home.openNow.fee}
              </span>
            </div>
            <div class="flex justify-between py-1">
              <span class="font-medium text-ink">कॉलबैक वादा</span>
              <span class="text-muted">{site.callbackWindow}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* SECTION 3: THE IDEA IN ONE SCREEN */}
  <Section
    id="the-idea"
    theme="paper"
    padding="lg"
    class="border-b border-hair"
  >
    <SectionHeader
      number={home.theIdea.number}
      label={home.theIdea.label}
      title={home.theIdea.title}
    />

    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
      <div class="space-y-6 lg:col-span-6">
        <div class="rounded border border-hair bg-paper p-6">
          <span
            class="mb-2 block font-mono text-xs font-semibold uppercase tracking-wider text-muted"
          >
            समस्या
          </span>
          <p class="font-body text-base leading-relaxed text-ink">
            {home.theIdea.problem}
          </p>
        </div>

        <div class="rounded border border-hair bg-paper p-6">
          <span
            class="mb-2 block font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink"
          >
            सिनेप्स का समाधान
          </span>
          <p class="font-body text-base leading-relaxed text-ink">
            {home.theIdea.solution}
          </p>
        </div>

        <p class="font-serif text-lg italic text-muted">
          &ldquo;{home.theIdea.analogy}&rdquo;
        </p>

        <div>
          <Button href={home.theIdea.cta.href} variant="secondary" size="md">
            {home.theIdea.cta.label}
          </Button>
        </div>
      </div>

      <div class="flex flex-col items-center gap-8 lg:col-span-6">
        <div class="w-full max-w-md">
          <ThreeWorlds class="w-full" />
        </div>
        <div class="w-full max-w-md">
          <LoopDiagram class="w-full" />
        </div>
      </div>
    </div>
  </Section>

  {/* SECTION 4: THE BUILDING (Three Floors in Order) */}
  <Section
    id="the-building"
    theme="paper"
    padding="lg"
    class="border-b border-hair"
  >
    <SectionHeader
      number={home.theBuilding.number}
      label={home.theBuilding.label}
      title={home.theBuilding.title}
      sub={home.theBuilding.sub}
    />

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        floors.map((floor) => (
          <div class="flex flex-col justify-between rounded border border-hair bg-paper p-6">
            <div>
              <div class="mb-4 flex items-center justify-between">
                <span class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink">
                  फ्लोर {floor.shortName}
                </span>
                <StatusChip status={floor.status} />
              </div>
              <h3 class="mb-2 font-serif text-xl font-normal text-ink">
                {floor.name}
              </h3>
              <p class="font-body text-sm leading-relaxed text-muted">
                {floor.summary}
              </p>
            </div>
            <div class="mt-6 border-t border-hair pt-4">
              <a
                href={`/building#floor-${floor.id}`}
                class="font-sans text-xs uppercase tracking-wider text-ink underline hover:text-spark-ink"
              >
                फ्लोर विवरण देखें &rarr;
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-8 text-center">
      <Button href={home.theBuilding.cta.href} variant="secondary" size="md">
        {home.theBuilding.cta.label}
      </Button>
    </div>
  </Section>

  {/* SECTION 5: FELLOWSHIP & TOOLS */}
  <Section
    id="fellowship-tools"
    theme="paper"
    padding="lg"
    class="border-b border-hair"
  >
    <SectionHeader
      number={home.fellowshipAndTools.number}
      label={home.fellowshipAndTools.label}
      title={home.fellowshipAndTools.title}
    />

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      {/* Fellowship Card */}
      <div
        class="flex flex-col justify-between rounded border border-hair bg-paper p-6 sm:p-8"
      >
        <div>
          <div class="mb-4 flex items-center justify-between">
            <span
              class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink"
            >
              फेलोशिप
            </span>
            <StatusChip status="LIVE NOW" />
          </div>
          <h3 class="mb-3 font-serif text-2xl font-normal text-ink">
            {home.fellowshipAndTools.fellowship.title}
          </h3>
          <p class="font-body text-base leading-relaxed text-muted">
            {home.fellowshipAndTools.fellowship.summary}
          </p>
        </div>
        <div class="mt-6 pt-4">
          <Button
            href={home.fellowshipAndTools.fellowship.href}
            variant="primary"
            size="md"
          >
            {home.fellowshipAndTools.fellowship.action}
          </Button>
        </div>
      </div>

      {/* Tutor Card */}
      <div
        class="bg-surface-dim/30 flex flex-col justify-between rounded border border-hair p-6 sm:p-8"
      >
        <div>
          <div class="mb-4 flex items-center justify-between">
            <span
              class="font-mono text-xs font-semibold uppercase tracking-wider text-muted"
            >
              अभ्यास प्रणाली
            </span>
            <StatusChip status="DIRECTION" />
          </div>
          <h3 class="mb-3 font-serif text-2xl font-normal text-ink">
            {home.fellowshipAndTools.tutor.title}
          </h3>
          <p class="font-body text-base leading-relaxed text-muted">
            {home.fellowshipAndTools.tutor.summary}
          </p>
        </div>
        <div class="mt-6 border-t border-hair pt-4">
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs text-muted">
              {home.fellowshipAndTools.passport.title}
            </span>
            <a
              href={home.fellowshipAndTools.passport.href}
              class="font-sans text-xs uppercase tracking-wider text-ink underline hover:text-spark-ink"
            >
              {home.fellowshipAndTools.passport.action} &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* SECTION 6: PRINCIPLES (8 One-Liners) */}
  <Section
    id="principles"
    theme="paper"
    padding="lg"
    class="border-b border-hair"
  >
    <SectionHeader
      number={home.principles.number}
      label={home.principles.label}
      title={home.principles.title}
      sub={home.principles.sub}
    />

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        principles.items.map((item) => (
          <div class="rounded border border-hair bg-paper p-5">
            <span class="mb-2 block font-mono text-xs font-semibold text-spark-ink">
              {item.number}
            </span>
            <h4 class="mb-2 font-serif text-lg font-normal text-ink">
              {item.title}
            </h4>
            <p class="font-body text-xs leading-relaxed text-muted">
              {item.detail}
            </p>
          </div>
        ))
      }
    </div>

    <div class="mt-8 text-center">
      <a
        href="/idea#open-problems"
        class="font-sans text-xs uppercase tracking-wider text-ink underline hover:text-spark-ink"
      >
        वे प्रश्न जो हमने अभी हल नहीं किए हैं &rarr;
      </a>
    </div>
  </Section>

  {/* SECTION 7: CHOOSE YOUR DOOR */}
  <Section id="choose-door" theme="paper" padding="lg">
    <SectionHeader
      number={home.chooseDoor.number}
      label={home.chooseDoor.label}
      title={home.chooseDoor.title}
      sub={home.chooseDoor.sub}
    />

    <div class="mb-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        doors.map((door) => (
          <DoorCard
            id={door.id}
            number={door.number}
            title={door.title}
            summary={door.summary}
            action={door.action}
            href={door.href}
            status={door.status}
          />
        ))
      }
    </div>

    {/* Direct Contact Fallback Strip */}
    <div
      class="flex flex-col justify-between gap-4 rounded border border-hair bg-paper p-6 sm:flex-row sm:items-center sm:p-8"
    >
      <div>
        <span
          class="mb-1 block font-mono text-xs uppercase tracking-wider text-muted"
        >
          {home.directContact.label}
        </span>
        <p class="font-body text-base text-ink">
          {home.directContact.text}
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a
          href={`https://wa.me/91${site.phone}?text=${encodeURIComponent('नमस्ते सिनेप्स, मैं प्रवेश और कार्यक्रमों के बारे में पूछताछ करना चाहता हूँ।')}`}
          class="inline-flex min-h-[48px] items-center justify-center rounded-pill bg-ink px-6 py-3 font-sans text-xs font-medium uppercase tracking-[0.14em] text-paper transition-colors hover:bg-spark-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-spark"
          target="_blank"
          rel="noopener noreferrer"
        >
          {home.directContact.whatsappAction}
        </a>
        <a
          href={`tel:+91${site.phone}`}
          class="hover:bg-hair/30 inline-flex min-h-[48px] items-center justify-center rounded-pill border border-ink px-6 py-3 font-sans text-xs font-medium uppercase tracking-[0.14em] text-ink transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-spark"
        >
          {site.phoneDisplay}
        </a>
      </div>
    </div>
  </Section>
</BaseLayout>
