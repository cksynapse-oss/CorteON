---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import StatusChip from '../components/ui/StatusChip.astro';

import site from '../content/site.json';
import { getFormUrl, isFormConfigured } from '../config/forms';

const generalFormUrl = getFormUrl('courseGeneral');
const isGeneralExternal = isFormConfigured('courseGeneral');

// Specific forms
const subjectClassesFormUrl = getFormUrl('subjectClasses');
const foundationPackFormUrl = getFormUrl('foundationPack');
const questionBankFormUrl = getFormUrl('questionBank');
const communicationFormUrl = getFormUrl('communication');
const businessDevFormUrl = getFormUrl('businessDevelopment');
const aiLiteracyFormUrl = getFormUrl('aiLiteracy');
const comboFormUrl = getFormUrl('aiBusinessCombo');
const internshipAppUrl = getFormUrl('internshipApplication');
const institutionFormUrl = getFormUrl('institutionEnquiry');
---

<BaseLayout
  title={`${site.name} — Centre for Learning & Innovation in Chamba`}
  description="Opportunity should not depend on geography. Offline classroom learning in Chamba for entrance examination preparation, communication, AI literacy, and practical business development."
>
  {/* SECTION 1: HERO */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="mx-auto max-w-7xl">
      <div class="grid items-center gap-12 lg:grid-cols-12">
        {/* Left Column: Core Message */}
        <div class="text-left lg:col-span-7">
          <div class="mb-4 inline-flex items-center gap-2">
            <span
              class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-spark-ink"
            >
              SYNAPSE · CHAMBA, HIMACHAL PRADESH
            </span>
            <StatusChip status="LIVE NOW" />
          </div>

          <h1
            class="font-serif text-display-xl-mobile font-normal leading-[1.08] tracking-[-0.025em] text-ink sm:text-display-lg md:text-display-xl"
          >
            Opportunity should not depend on geography.
          </h1>

          <p
            class="mt-4 font-mono text-sm font-semibold uppercase tracking-wider text-spark-ink sm:text-base"
          >
            Learn. Prepare. Build. Work.
          </p>

          <p
            class="mt-4 max-w-2xl font-sans text-base leading-relaxed text-muted sm:text-body-lg"
          >
            Talent exists everywhere. Access to opportunity does not. Synapse
            brings structured entrance-examination preparation, communication
            skills, AI literacy and practical business experience closer to
            students and young people in Chamba through focused offline
            classroom instruction.
          </p>

          <div
            class="mt-6 flex items-center gap-3 border-l-2 border-spark pl-4"
          >
            <p class="font-sans text-xs italic text-muted sm:text-sm">
              Better access to education. Better preparation for opportunity.
              Better pathways to work.
            </p>
          </div>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <Button href="#pathways" variant="primary" size="lg">
              Explore three pathways
            </Button>
            <Button
              href={generalFormUrl}
              target={isGeneralExternal ? '_blank' : undefined}
              rel={isGeneralExternal ? 'noopener noreferrer' : undefined}
              variant="secondary"
              size="lg"
            >
              <span>Enquire now</span>
              {
                isGeneralExternal && (
                  <svg
                    class="ml-1.5 h-3.5 w-3.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                    />
                  </svg>
                )
              }
            </Button>
          </div>

          <p class="mt-4 font-sans text-xs text-muted">
            Offline batches at our Chamba centre behind the Post Office · 1–2
            trial classes before payment
          </p>
        </div>

        {/* Right Column: Hero Visual */}
        <div class="lg:col-span-5">
          <div
            class="relative overflow-hidden rounded border border-hair bg-paper shadow-sm"
          >
            <img
              src="/images/home-hero.webp"
              alt="Panoramic view of Chamba town nestled in the Himalayas above the Ravi river"
              class="h-80 w-full object-cover sm:h-96"
              loading="eager"
            />
            <div class="bg-paper/95 border-t border-hair p-4 sm:p-5">
              <div class="flex items-center justify-between">
                <div>
                  <p class="font-sans text-xs font-semibold uppercase text-ink">
                    Chamba Learning Centre
                  </p>
                  <p class="mt-0.5 font-sans text-xs text-muted">
                    Behind the Post Office, Chamba, H.P.
                  </p>
                </div>
                <span
                  class="border-spark/30 bg-spark/10 rounded-pill border px-2.5 py-1 font-mono text-[11px] font-medium text-spark-ink"
                >
                  Offline Batches
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* SECTION 2: WHY SYNAPSE EXISTS */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="mx-auto max-w-4xl">
      <div class="text-center">
        <span
          class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-spark-ink"
        >
          The Problem We Are Solving
        </span>
        <h2
          class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
        >
          Why Synapse exists in Chamba
        </h2>
        <p
          class="mx-auto mt-3 max-w-2xl font-sans text-base leading-relaxed text-muted"
        >
          In a mountain district like Chamba, students and young people do not
          always have access to the range of educational preparation, emerging
          skills, and practical employment pathways available in larger cities.
          We are building Synapse to expand access across three critical areas:
        </p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {/* Gap 1 */}
        <div class="rounded border border-hair bg-paper p-6 shadow-sm">
          <div
            class="bg-spark/10 flex h-10 w-10 items-center justify-center rounded-full font-mono text-sm font-bold text-spark"
          >
            01
          </div>
          <h3 class="mt-4 font-serif text-lg font-normal text-ink">
            Entrance Exam Preparation for School Students
          </h3>
          <p class="mt-2 font-sans text-xs leading-relaxed text-muted">
            School students in Class 11–12 need structured preparation for
            competitive entrance examinations (JEE, NEET, CUET), not just
            school-board syllabus completion. Concept clarity, numerical
            problem-solving, and regular exam tests make the difference.
          </p>
        </div>

        {/* Gap 2 */}
        <div class="rounded border border-hair bg-paper p-6 shadow-sm">
          <div
            class="bg-spark/10 flex h-10 w-10 items-center justify-center rounded-full font-mono text-sm font-bold text-spark"
          >
            02
          </div>
          <h3 class="mt-4 font-serif text-lg font-normal text-ink">
            Aptitude Foundations for College Aspirants
          </h3>
          <p class="mt-2 font-sans text-xs leading-relaxed text-muted">
            College students need structured foundations in General Awareness,
            Logical Reasoning, and Quantitative Aptitude for postgraduate
            entrance (CUET PG), national eligibility tests (UGC NET), and
            competitive career examinations.
          </p>
        </div>

        {/* Gap 3 */}
        <div class="rounded border border-hair bg-paper p-6 shadow-sm">
          <div
            class="bg-spark/10 flex h-10 w-10 items-center justify-center rounded-full font-mono text-sm font-bold text-spark"
          >
            03
          </div>
          <h3 class="mt-4 font-serif text-lg font-normal text-ink">
            Employability & Local Economic Pathways
          </h3>
          <p class="mt-2 font-sans text-xs leading-relaxed text-muted">
            Young graduates need practical capabilities—applied AI tools,
            professional communication, market research, and business
            development—connected to real local ventures so they can become
            work-ready or build sustainable enterprises in Chamba.
          </p>
        </div>
      </div>
    </div>
  </Section>

  {/* SECTION 3: THREE LEARNING PATHWAYS OVERVIEW */}
  <Section
    theme="paper"
    padding="lg"
    class="border-b border-hair"
    id="pathways"
  >
    <div class="mx-auto max-w-7xl">
      <div class="text-center">
        <span
          class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-spark-ink"
        >
          Clear Pathways for Every Learner
        </span>
        <h2
          class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
        >
          Choose your learning pathway
        </h2>
        <p
          class="mx-auto mt-2 max-w-2xl font-sans text-base leading-relaxed text-muted"
        >
          Find focused instruction tailored to your current academic stage and
          future aspirations.
        </p>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-3">
        {/* Gateway Card A */}
        <div
          class="group flex flex-col justify-between overflow-hidden rounded border border-hair bg-paper transition-all hover:border-spark hover:shadow-md"
        >
          <div>
            <div class="relative h-48 overflow-hidden bg-hair">
              <img
                src="/images/pathway-school.webp"
                alt="School science and mathematics classroom teaching on board in Chamba"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
              <div
                class="bg-paper/90 absolute left-3 top-3 rounded-pill px-3 py-1 font-mono text-[11px] font-semibold text-spark-ink shadow-sm"
              >
                Pathway A
              </div>
            </div>
            <div class="p-6">
              <span
                class="font-mono text-xs font-semibold uppercase text-muted"
              >
                School Students · Class 11–12
              </span>
              <h3 class="mt-2 font-serif text-xl font-normal text-ink">
                Prepare for what comes after school.
              </h3>
              <p class="mt-3 font-sans text-sm leading-relaxed text-muted">
                Classroom instruction in Physics, Chemistry, Biology, and
                Mathematics focusing on numerical problem-solving and entrance
                exam readiness (JEE, NEET, CUET), complemented by English-Hindi
                communication and AI literacy.
              </p>
            </div>
          </div>
          <div class="border-t border-hair bg-paper p-6">
            <p class="font-mono text-xs font-semibold text-ink">
              From ₹599/subject/month
            </p>
            <a
              href="#school-programmes"
              class="mt-3 inline-flex items-center gap-1 font-sans text-xs font-bold text-spark hover:underline"
            >
              <span>Explore school programmes</span>
              <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>

        {/* Gateway Card B */}
        <div
          class="group flex flex-col justify-between overflow-hidden rounded border border-hair bg-paper transition-all hover:border-spark hover:shadow-md"
        >
          <div>
            <div class="relative h-48 overflow-hidden bg-hair">
              <img
                src="/images/pathway-college.webp"
                alt="College student focused on competitive exam study and aptitude practice"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
              <div
                class="bg-paper/90 absolute left-3 top-3 rounded-pill px-3 py-1 font-mono text-[11px] font-semibold text-spark-ink shadow-sm"
              >
                Pathway B
              </div>
            </div>
            <div class="p-6">
              <span
                class="font-mono text-xs font-semibold uppercase text-muted"
              >
                College Students & Aspirants
              </span>
              <h3 class="mt-2 font-serif text-xl font-normal text-ink">
                Your next opportunity begins with preparation.
              </h3>
              <p class="mt-3 font-sans text-sm leading-relaxed text-muted">
                A structured Foundation Pack covering General Awareness, Logical
                Reasoning, and Quantitative Aptitude across 28 units, with
                topic-wise Exam Question Banks and speed-accuracy tracking for
                CUET PG, NET, and state exams.
              </p>
            </div>
          </div>
          <div class="border-t border-hair bg-paper p-6">
            <p class="font-mono text-xs font-semibold text-ink">
              Foundation Pack: ₹599/month
            </p>
            <a
              href="#college-programmes"
              class="mt-3 inline-flex items-center gap-1 font-sans text-xs font-bold text-spark hover:underline"
            >
              <span>Explore college programmes</span>
              <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>

        {/* Gateway Card C */}
        <div
          class="group flex flex-col justify-between overflow-hidden rounded border border-hair bg-paper transition-all hover:border-spark hover:shadow-md"
        >
          <div>
            <div class="relative h-48 overflow-hidden bg-hair">
              <img
                src="/images/pathway-business.webp"
                alt="Collaborative business team working on project planning and marketing in Chamba"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
              <div
                class="bg-paper/90 absolute left-3 top-3 rounded-pill px-3 py-1 font-mono text-[11px] font-semibold text-spark-ink shadow-sm"
              >
                Pathway C
              </div>
            </div>
            <div class="p-6">
              <span
                class="font-mono text-xs font-semibold uppercase text-muted"
              >
                Undergraduates & Graduates
              </span>
              <h3 class="mt-2 font-serif text-xl font-normal text-ink">
                Learn practical skills. Gain experience. Become work-ready.
              </h3>
              <p class="mt-3 font-sans text-sm leading-relaxed text-muted">
                A six-month programme combining three months of classroom
                learning (market research, customer discovery, costing,
                branding, sales) with a three-month mentored internship on real
                Chamba ventures.
              </p>
            </div>
          </div>
          <div class="border-t border-hair bg-paper p-6">
            <p class="font-mono text-xs font-semibold text-ink">
              6-Month Programme: ₹899/month
            </p>
            <a
              href="#business-programmes"
              class="mt-3 inline-flex items-center gap-1 font-sans text-xs font-bold text-spark hover:underline"
            >
              <span>Explore business programmes</span>
              <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* SECTION 4: PROGRAMMES BY AUDIENCE */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="mx-auto max-w-7xl">
      {/* 4A: School Students */}
      <div id="school-programmes" class="mb-16 scroll-mt-20">
        <div
          class="mb-6 flex flex-wrap items-baseline justify-between gap-2 border-b border-hair pb-4"
        >
          <div>
            <span
              class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink"
            >
              Pathway A
            </span>
            <h2
              class="mt-1 font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
            >
              Programmes for School Students (Class 11–12)
            </h2>
          </div>
          <p class="font-sans text-xs text-muted">
            Concept clarity · Problem-solving · JEE, NEET, CUET practice
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-3">
          {/* Card: Subject Classes */}
          <div
            class="flex flex-col justify-between rounded border border-hair bg-paper p-6 shadow-sm"
          >
            <div>
              <span
                class="bg-spark/10 rounded-pill px-2.5 py-0.5 font-mono text-[11px] font-semibold text-spark-ink"
              >
                Entrance & Board Focus
              </span>
              <h3 class="mt-3 font-serif text-xl font-normal text-ink">
                Class 11–12 Subject Classes
              </h3>
              <p class="mt-1 font-mono text-xs font-bold text-spark">
                ₹599 / subject / month
              </p>
              <p class="mt-3 font-sans text-xs text-muted">
                Physics · Chemistry · Biology · Mathematics. Structured for
                concept clarity, numerical problem-solving, chapter tests, and
                competitive entrance examination practice (JEE, NEET, CUET).
              </p>
            </div>
            <div class="mt-6 border-t border-hair pt-4">
              <Button
                href={subjectClassesFormUrl}
                target={isGeneralExternal ? '_blank' : undefined}
                rel={isGeneralExternal ? 'noopener noreferrer' : undefined}
                variant="primary"
                size="sm"
                class="w-full justify-center"
              >
                Enquire for Subject Classes
              </Button>
              <a
                href="/courses/subject-classes"
                class="mt-2 block text-center font-sans text-xs text-muted hover:text-ink hover:underline"
              >
                View full syllabus →
              </a>
            </div>
          </div>

          {/* Card: Communication */}
          <div
            class="flex flex-col justify-between rounded border border-hair bg-paper p-6 shadow-sm"
          >
            <div>
              <span
                class="rounded-pill bg-hair px-2.5 py-0.5 font-mono text-[11px] font-semibold text-ink"
              >
                Bilingual Fluency
              </span>
              <h3 class="mt-3 font-serif text-xl font-normal text-ink">
                Communication: English + Hindi
              </h3>
              <p class="mt-1 font-mono text-xs font-bold text-spark">
                ₹599 / month (10 weeks)
              </p>
              <p class="mt-3 font-sans text-xs text-muted">
                Overcome hesitation in speaking. Structured practice in
                speaking, listening, practical writing, group discussion basics,
                and a final showcase presentation.
              </p>
            </div>
            <div class="mt-6 border-t border-hair pt-4">
              <Button
                href={communicationFormUrl}
                target={isGeneralExternal ? '_blank' : undefined}
                rel={isGeneralExternal ? 'noopener noreferrer' : undefined}
                variant="primary"
                size="sm"
                class="w-full justify-center"
              >
                Enquire for Communication
              </Button>
              <a
                href="/courses/communication"
                class="mt-2 block text-center font-sans text-xs text-muted hover:text-ink hover:underline"
              >
                View full syllabus →
              </a>
            </div>
          </div>

          {/* Card: AI Literacy */}
          <div
            class="flex flex-col justify-between rounded border border-hair bg-paper p-6 shadow-sm"
          >
            <div>
              <span
                class="rounded-pill bg-hair px-2.5 py-0.5 font-mono text-[11px] font-semibold text-ink"
              >
                Modern Skills
              </span>
              <h3 class="mt-3 font-serif text-xl font-normal text-ink">
                Applied AI Literacy
              </h3>
              <p class="mt-1 font-mono text-xs font-bold text-spark">
                ₹899 / month (12 weeks)
              </p>
              <p class="mt-3 font-sans text-xs text-muted">
                No coding required. Learn effective prompting, academic research
                verification, data handling, and AI tools for school projects
                and everyday problem-solving.
              </p>
            </div>
            <div class="mt-6 border-t border-hair pt-4">
              <Button
                href={aiLiteracyFormUrl}
                target={isGeneralExternal ? '_blank' : undefined}
                rel={isGeneralExternal ? 'noopener noreferrer' : undefined}
                variant="primary"
                size="sm"
                class="w-full justify-center"
              >
                Enquire for AI Literacy
              </Button>
              <a
                href="/courses/ai-literacy"
                class="mt-2 block text-center font-sans text-xs text-muted hover:text-ink hover:underline"
              >
                View full syllabus →
              </a>
            </div>
          </div>
        </div>
      </div>

      {/* 4B: College Students & Exam Aspirants */}
      <div id="college-programmes" class="mb-16 scroll-mt-20">
        <div
          class="mb-6 flex flex-wrap items-baseline justify-between gap-2 border-b border-hair pb-4"
        >
          <div>
            <span
              class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink"
            >
              Pathway B
            </span>
            <h2
              class="mt-1 font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
            >
              Programmes for College Students & Exam Aspirants
            </h2>
          </div>
          <p class="font-sans text-xs text-muted">
            General Awareness · Logical Reasoning · Quantitative Aptitude · Exam
            Banks
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
          {/* Card: Foundation Pack */}
          <div
            class="flex flex-col justify-between rounded border border-hair bg-paper p-6 shadow-sm"
          >
            <div>
              <div class="flex items-center justify-between">
                <span
                  class="bg-spark/10 rounded-pill px-2.5 py-0.5 font-mono text-[11px] font-semibold text-spark-ink"
                >
                  All 3 Subjects Included
                </span>
                <span class="font-mono text-xs text-muted">12 Weeks</span>
              </div>
              <h3 class="mt-3 font-serif text-2xl font-normal text-ink">
                Foundation Pack
              </h3>
              <p class="mt-1 font-mono text-xs font-bold text-spark">
                ₹599 / month · Includes all three modules
              </p>
              <p class="mt-3 font-sans text-sm leading-relaxed text-muted">
                28 structured units covering Indian History, Polity, Economy,
                General Science, Logical Arrangements, Syllogisms, Arithmetic,
                Algebra, and Data Interpretation. Essential foundation for CUET
                UG/PG, UGC NET, and public competitive examinations.
              </p>
              <ul class="mt-4 space-y-1.5 font-sans text-xs text-muted">
                <li class="flex items-center gap-2">
                  <span class="h-1.5 w-1.5 rounded-full bg-spark"></span>
                  General Awareness (10 units)
                </li>
                <li class="flex items-center gap-2">
                  <span class="h-1.5 w-1.5 rounded-full bg-spark"></span>
                  Logical Reasoning (8 units)
                </li>
                <li class="flex items-center gap-2">
                  <span class="h-1.5 w-1.5 rounded-full bg-spark"></span>
                  Quantitative Aptitude (10 units)
                </li>
              </ul>
            </div>
            <div class="mt-6 border-t border-hair pt-4">
              <Button
                href={foundationPackFormUrl}
                target={isGeneralExternal ? '_blank' : undefined}
                rel={isGeneralExternal ? 'noopener noreferrer' : undefined}
                variant="primary"
                size="md"
                class="w-full justify-center"
              >
                Enquire for Foundation Pack
              </Button>
              <a
                href="/courses/foundation-pack"
                class="mt-2 block text-center font-sans text-xs text-muted hover:text-ink hover:underline"
              >
                View full 28-unit syllabus →
              </a>
            </div>
          </div>

          {/* Card: Question Bank */}
          <div
            class="flex flex-col justify-between rounded border border-hair bg-paper p-6 shadow-sm"
          >
            <div>
              <div class="flex items-center justify-between">
                <span
                  class="rounded-pill bg-hair px-2.5 py-0.5 font-mono text-[11px] font-semibold text-ink"
                >
                  Practice & Performance
                </span>
                <span class="font-mono text-xs text-muted">
                  6 Months Access
                </span>
              </div>
              <h3 class="mt-3 font-serif text-2xl font-normal text-ink">
                Exam Question Bank & Performance Profile
              </h3>
              <p class="mt-1 font-mono text-xs font-bold text-spark">
                ₹499 one-time · 6 months access
              </p>
              <p class="mt-3 font-sans text-sm leading-relaxed text-muted">
                Topic-wise and mixed timed practice sets with hints before full
                answers. Tracks your accuracy and speed profile, highlights weak
                topics, and includes periodic teacher review.
              </p>
              <p class="mt-3 font-sans text-xs italic text-muted">
                Confirm your target examination pack during enquiry.
              </p>
            </div>
            <div class="mt-6 border-t border-hair pt-4">
              <Button
                href={questionBankFormUrl}
                target={isGeneralExternal ? '_blank' : undefined}
                rel={isGeneralExternal ? 'noopener noreferrer' : undefined}
                variant="primary"
                size="md"
                class="w-full justify-center"
              >
                Enquire for Question Bank
              </Button>
              <a
                href="/courses/question-bank"
                class="mt-2 block text-center font-sans text-xs text-muted hover:text-ink hover:underline"
              >
