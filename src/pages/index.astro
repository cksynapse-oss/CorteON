---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import StatusChip from '../components/ui/StatusChip.astro';

import site from '../content/site.json';
import { getFormUrl, isFormConfigured } from '../config/forms';

const generalFormUrl = getFormUrl('courseGeneral');
const isGeneralExternal = isFormConfigured('courseGeneral');

const regularSubjectsFormUrl = getFormUrl('subjectClasses');
const cuetPgFormUrl = getFormUrl('cuetPg');
const aiLiteracyFormUrl = getFormUrl('aiLiteracy');
const businessDevFormUrl = getFormUrl('businessDevelopment');
const commFormUrl = getFormUrl('communication');
const institutionFormUrl = getFormUrl('institutionEnquiry');
---

<BaseLayout
  title={`${site.name} — Centre for Learning & Innovation in Chamba`}
  description="Learn what matters. Build what comes next. Offline education and innovation in Chamba: school subject classes, JEE/NEET, CUET PG, NET, Applied AI literacy, communication, business development, and local venture building."
>
  {/* SECTION 1: HERO */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="mx-auto max-w-7xl">
      <div class="grid items-center gap-12 lg:grid-cols-12">
        {/* Left Column: Core Narrative */}
        <div class="text-left lg:col-span-7">
          <div class="mb-4 inline-flex items-center gap-2">
            <span
              class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-spark-ink"
            >
              SYNAPSE · CHAMBA, HIMACHAL PRADESH
            </span>
            <StatusChip status="LIVE NOW" />
          </div>

          <h1
            class="font-serif text-display-xl-mobile font-normal leading-[1.08] tracking-[-0.025em] text-ink sm:text-display-lg md:text-display-xl"
          >
            Learn what matters. Build what comes next.
          </h1>

          <p
            class="mt-4 font-mono text-sm font-semibold uppercase tracking-wider text-spark-ink sm:text-base"
          >
            Learn. Apply. Build. Create.
          </p>

          <p
            class="mt-4 max-w-2xl font-sans text-base leading-relaxed text-muted sm:text-body-lg"
          >
            Structured education, practical skills and real-world opportunities
            for students, institutions and emerging entrepreneurs. From academic
            and competitive-exam preparation to AI literacy, communication,
            business development and venture-building opportunities.
          </p>

          <div
            class="mt-6 flex items-center gap-3 border-l-2 border-spark pl-4"
          >
            <p class="font-sans text-xs italic text-muted sm:text-sm">
              Education that connects learning with practical work.
            </p>
          </div>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <Button href="#programmes" variant="primary" size="lg">
              Explore programmes
            </Button>
            <Button href="/schools-colleges" variant="secondary" size="lg">
              Partner with us
            </Button>
          </div>

          <p class="mt-4 font-sans text-xs text-muted">
            Offline batches at our Chamba centre behind the Post Office · 1–2
            trial classes before payment
          </p>
        </div>

        {/* Right Column: Hero Visual Card */}
        <div class="lg:col-span-5">
          <div
            class="relative overflow-hidden rounded border border-hair bg-paper shadow-sm"
          >
            <img
              src="/images/home-hero.webp"
              alt="Panoramic view of Chamba nestled in the Himalayas above the Ravi river"
              class="h-80 w-full object-cover sm:h-96"
              loading="eager"
            />
            <div class="border-t border-hair bg-paper p-4 sm:p-5">
              <div class="flex items-center justify-between">
                <div>
                  <p class="font-sans text-xs font-semibold uppercase text-ink">
                    Chamba Learning Centre
                  </p>
                  <p class="mt-0.5 font-sans text-xs text-muted">
                    Behind the Post Office, Chamba, H.P.
                  </p>
                </div>
                <span
                  class="border-spark/30 bg-spark/10 rounded-pill border px-2.5 py-1 font-mono text-[11px] font-medium text-spark-ink"
                >
                  Offline Batches
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* SECTION 2: THE CENTRAL STORY (LEARN → APPLY → BUILD → CREATE) */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="mx-auto max-w-6xl">
      <div class="text-center">
        <span
          class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-spark-ink"
        >
          The Connected Model
        </span>
        <h2
          class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
        >
          Four Connected Stages of Growth
        </h2>
        <p
          class="mx-auto mt-3 max-w-2xl font-sans text-base leading-relaxed text-muted"
        >
          Education should not be limited to attending classes and taking exams.
          Our model links academic foundations directly with hands-on practice,
          interdisciplinary collaboration, and real-world venture building.
        </p>
      </div>

      {/* Connected 4-Stage Progressive Pipeline */}
      <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
        {/* Stage 1: LEARN */}
        <div
          class="hover:border-ink/40 relative flex flex-col justify-between rounded border border-hair bg-paper p-6 transition-colors"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-bold text-spark-ink"
                >01 · STAGE</span
              >
              <span
                class="rounded-pill bg-hair px-2.5 py-0.5 font-mono text-[11px] text-muted"
                >Foundations</span
              >
            </div>
            <h3 class="mt-4 font-serif text-2xl font-normal text-ink">
              1. LEARN
            </h3>
            <p class="mt-2 font-sans text-xs font-medium text-spark-ink">
              Academic foundations & essential capabilities
            </p>
            <p class="mt-3 font-sans text-xs leading-relaxed text-muted">
              Students build rigorous subject understanding, competitive
              entrance readiness, and essential modern literacies.
            </p>
            <ul
              class="mt-4 space-y-1.5 border-t border-hair pt-3 font-sans text-xs text-muted"
            >
              <li>• School subject classes (Class 11–12)</li>
              <li>• CUET PG & UGC NET preparation</li>
              <li>• Applied AI literacy foundations</li>
              <li>• English & Hindi communication</li>
              <li>• Business development fundamentals</li>
            </ul>
          </div>
          <div class="mt-6 border-t border-hair pt-3">
            <span class="font-mono text-[11px] text-muted">Concept mastery</span
            >
          </div>
        </div>

        {/* Stage 2: APPLY */}
        <div
          class="hover:border-ink/40 relative flex flex-col justify-between rounded border border-hair bg-paper p-6 transition-colors"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-bold text-spark-ink"
                >02 · STAGE</span
              >
              <span
                class="rounded-pill bg-hair px-2.5 py-0.5 font-mono text-[11px] text-muted"
                >Practice</span
              >
            </div>
            <h3 class="mt-4 font-serif text-2xl font-normal text-ink">
              2. APPLY
            </h3>
            <p class="mt-2 font-sans text-xs font-medium text-spark-ink">
              Practical activities & interactive drills
            </p>
            <p class="mt-3 font-sans text-xs leading-relaxed text-muted">
              Students apply what they learn through hands-on assignments,
              prompt workflows, and structured team exercises.
            </p>
            <ul
              class="mt-4 space-y-1.5 border-t border-hair pt-3 font-sans text-xs text-muted"
            >
              <li>• AI tools and automation workflows</li>
              <li>• Information research and fact-checking</li>
              <li>• Customer and market discovery</li>
              <li>• Collaborative team challenges</li>
              <li>• Public speaking & presentations</li>
            </ul>
          </div>
          <div class="mt-6 border-t border-hair pt-3">
            <span class="font-mono text-[11px] text-muted"
              >Practical assignments</span
            >
          </div>
        </div>

        {/* Stage 3: BUILD */}
        <div
          class="hover:border-ink/40 relative flex flex-col justify-between rounded border border-hair bg-paper p-6 transition-colors"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-bold text-spark-ink"
                >03 · STAGE</span
              >
              <span
                class="rounded-pill bg-hair px-2.5 py-0.5 font-mono text-[11px] text-muted"
                >Collaboration</span
              >
            </div>
            <h3 class="mt-4 font-serif text-2xl font-normal text-ink">
              3. BUILD
            </h3>
            <p class="mt-2 font-sans text-xs font-medium text-spark-ink">
              Real projects & interdisciplinary teams
            </p>
            <p class="mt-3 font-sans text-xs leading-relaxed text-muted">
              Students collaborate across disciplines on defined challenges for
              local Chamba ventures.
            </p>
            <ul
              class="mt-4 space-y-1.5 border-t border-hair pt-3 font-sans text-xs text-muted"
            >
              <li>• Product development & artisan sampling</li>
              <li>• Costing, pricing, and accounting models</li>
              <li>• Product photography & digital catalogues</li>
              <li>• Websites, tools, and automation</li>
              <li>• Marketing campaigns & direct sales</li>
            </ul>
          </div>
          <div class="mt-6 border-t border-hair pt-3">
            <span class="font-mono text-[11px] text-muted"
              >Venture execution</span
            >
          </div>
        </div>

        {/* Stage 4: CREATE */}
        <div
          class="border-spark/40 relative flex flex-col justify-between rounded border-2 bg-paper p-6 transition-colors hover:border-spark"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-bold text-spark-ink"
                >04 · STAGE</span
              >
              <span
                class="bg-spark/10 rounded-pill px-2.5 py-0.5 font-mono text-[11px] font-semibold text-spark-ink"
                >Outcome</span
              >
            </div>
            <h3 class="mt-4 font-serif text-2xl font-normal text-ink">
              4. CREATE
            </h3>
            <p class="mt-2 font-sans text-xs font-medium text-spark-ink">
              Useful products, services & local opportunities
            </p>
            <p class="mt-3 font-sans text-xs leading-relaxed text-muted">
              The goal is to launch sustainable products, services, businesses,
              and employment pathways rooted in Chamba.
            </p>
            <ul
              class="mt-4 space-y-1.5 border-t border-hair pt-3 font-sans text-xs text-muted"
            >
              <li>• Artisan apparel & contemporary crafts</li>
              <li>• Local travel networks & guest experiences</li>
              <li>• Packaged regional agro-products</li>
              <li>• Expanding educational access</li>
              <li>• Work-ready graduates & entrepreneurs</li>
            </ul>
          </div>
          <div class="mt-6 border-t border-hair pt-3">
            <span class="font-mono text-[11px] font-semibold text-spark-ink"
              >Tangible impact</span
            >
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* SECTION 3: HOMEPAGE AUDIENCE NAVIGATION */}
  <Section
    theme="paper"
    padding="lg"
    class="border-b border-hair"
    id="audience-navigation"
  >
    <div class="mx-auto max-w-6xl">
      <div class="text-center">
        <span
          class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-spark-ink"
        >
          Personalised Entry Points
        </span>
        <h2
          class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
        >
          Where would you like to start?
        </h2>
        <p class="mx-auto mt-2 max-w-2xl font-sans text-sm text-muted">
          Select your background or goal to explore the relevant programmes and
          pathways.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {/* Gateway 1 */}
        <a
          href="/school"
          class="group rounded border border-hair bg-paper p-6 transition-all hover:border-ink hover:shadow-sm focus-visible:outline-2 focus-visible:outline-spark"
        >
          <span class="font-mono text-xs font-semibold uppercase text-spark-ink"
            >School Pathway</span
          >
          <h3
            class="mt-2 font-serif text-xl font-normal text-ink group-hover:text-spark-ink"
          >
            I'm a school student or parent →
          </h3>
          <p class="mt-2 font-sans text-xs text-muted">
            Class 11–12 regular subject classes (₹599/mo), JEE/NEET prep
            (₹799/mo), AI Literacy, Business, and Communication.
          </p>
        </a>

        {/* Gateway 2 */}
        <a
          href="/college"
          class="group rounded border border-hair bg-paper p-6 transition-all hover:border-ink hover:shadow-sm focus-visible:outline-2 focus-visible:outline-spark"
        >
          <span class="font-mono text-xs font-semibold uppercase text-spark-ink"
            >College Pathway</span
          >
          <h3
            class="mt-2 font-serif text-xl font-normal text-ink group-hover:text-spark-ink"
          >
            I'm a college student →
          </h3>
          <p class="mt-2 font-sans text-xs text-muted">
            Applied AI Literacy (6 mo), Business Development + Internship (6
            mo), Foundation Pack, and Communication Skills.
          </p>
        </a>

        {/* Gateway 3 */}
        <a
          href="/college#cuet-net"
          class="group rounded border border-hair bg-paper p-6 transition-all hover:border-ink hover:shadow-sm focus-visible:outline-2 focus-visible:outline-spark"
        >
          <span class="font-mono text-xs font-semibold uppercase text-spark-ink"
            >Entrance Prep</span
          >
          <h3
            class="mt-2 font-serif text-xl font-normal text-ink group-hover:text-spark-ink"
          >
            I'm preparing for CUET PG or NET →
          </h3>
          <p class="mt-2 font-sans text-xs text-muted">
            Subject-specific coaching across 9 disciplines, aptitude test
            series, and dedicated question bank practice.
          </p>
        </a>

        {/* Gateway 4 */}
        <a
          href="/schools-colleges"
          class="group rounded border border-hair bg-paper p-6 transition-all hover:border-ink hover:shadow-sm focus-visible:outline-2 focus-visible:outline-spark"
        >
          <span class="font-mono text-xs font-semibold uppercase text-spark-ink"
            >Institutions</span
          >
          <h3
            class="mt-2 font-serif text-xl font-normal text-ink group-hover:text-spark-ink"
          >
            I'm a school or institution →
          </h3>
          <p class="mt-2 font-sans text-xs text-muted">
            Partner with Synapse for in-school AI classes, Robotics/ATL lab
            sessions, business development, and communication.
          </p>
        </a>

        {/* Gateway 5 */}
        <a
          href="/ventures"
          class="group rounded border border-hair bg-paper p-6 transition-all hover:border-ink hover:shadow-sm focus-visible:outline-2 focus-visible:outline-spark sm:col-span-2 lg:col-span-2"
        >
          <span class="font-mono text-xs font-semibold uppercase text-spark-ink"
            >Venture Building</span
          >
          <h3
            class="mt-2 font-serif text-xl font-normal text-ink group-hover:text-spark-ink"
          >
            I want to work on ventures or internships →
          </h3>
          <p class="mt-2 font-sans text-xs text-muted">
            Join our interdisciplinary teams executing on real Chamba venture
            projects: artisan apparel, travel networks, education, and FMCG
            agro-products.
          </p>
        </a>
      </div>
    </div>
  </Section>

  {/* SECTION 4: HOMEPAGE PROGRAMME OVERVIEW */}
  <Section
    theme="paper"
    padding="lg"
    class="border-b border-hair"
    id="programmes"
  >
    <div class="mx-auto max-w-7xl">
      <div class="text-center">
        <span
          class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-spark-ink"
        >
          Transparent Curricula & Rates
        </span>
        <h2
          class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
        >
          Major Programme Categories
        </h2>
        <p
          class="mx-auto mt-2 max-w-2xl font-sans text-base leading-relaxed text-muted"
        >
          Every programme has a published duration, verified syllabus, and
          offline classroom batches in Chamba.
        </p>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {/* Category 1: School Subject Classes */}
        <div
          class="flex flex-col justify-between rounded border border-hair bg-paper p-6 shadow-sm"
        >
          <div>
            <div class="flex items-center justify-between">
              <span
                class="rounded-pill bg-hair px-2.5 py-0.5 font-mono text-[11px] text-muted"
              >
                Class 11–12
              </span>
              <span class="font-mono text-xs font-semibold text-spark-ink">
                ₹599 or ₹799 / mo
              </span>
            </div>
            <h3 class="mt-3 font-serif text-xl font-normal text-ink">
              School Subject Classes
            </h3>
            <p class="mt-2 font-sans text-xs text-muted">
              Physics, Chemistry, Biology, Mathematics, Economics, Accountancy.
              Regular board + CUET (₹599/sub/mo) or JEE/NEET entrance
              preparation (₹799/sub/mo).
            </p>
            <p class="mt-3 font-mono text-[11px] text-muted">
              Duration: Until board or entrance examination
            </p>
          </div>
          <div
            class="mt-6 flex items-center justify-between border-t border-hair pt-4"
          >
            <a
              href="/school"
              class="font-sans text-xs font-semibold text-spark-ink hover:underline"
            >
              View school options →
            </a>
            <Button href={regularSubjectsFormUrl} variant="primary" size="sm">
              Enquire
            </Button>
          </div>
        </div>

        {/* Category 2: CUET PG & NET Preparation */}
        <div
          class="flex flex-col justify-between rounded border border-hair bg-paper p-6 shadow-sm"
        >
          <div>
            <div class="flex items-center justify-between">
              <span
                class="rounded-pill bg-hair px-2.5 py-0.5 font-mono text-[11px] text-muted"
              >
                Degree & Master's
              </span>
              <span class="font-mono text-xs font-semibold text-spark-ink">
                Enquire
              </span>
            </div>
            <h3 class="mt-3 font-serif text-xl font-normal text-ink">
              CUET PG & UGC NET
            </h3>
            <p class="mt-2 font-sans text-xs text-muted">
              Specialised subject modules across 9 disciplines: Physics,
              Chemistry, Zoology, Mathematics, Botany, Economics, History,
              Geography, Psychology.
            </p>
            <p class="mt-3 font-mono text-[11px] text-muted">
              Duration: Examination-specific
            </p>
          </div>
          <div
            class="mt-6 flex items-center justify-between border-t border-hair pt-4"
          >
            <a
              href="/college#cuet-net"
              class="font-sans text-xs font-semibold text-spark-ink hover:underline"
            >
              View 9 disciplines →
            </a>
            <Button href={cuetPgFormUrl} variant="primary" size="sm">
              Enquire
            </Button>
          </div>
        </div>

        {/* Category 3: Applied AI Literacy */}
        <div
          class="flex flex-col justify-between rounded border border-hair bg-paper p-6 shadow-sm"
        >
          <div>
            <div class="flex items-center justify-between">
              <span
                class="rounded-pill bg-hair px-2.5 py-0.5 font-mono text-[11px] text-muted"
              >
                Practical Skills
              </span>
              <span class="font-mono text-xs font-semibold text-spark-ink">
                ₹899 / mo
              </span>
            </div>
            <h3 class="mt-3 font-serif text-xl font-normal text-ink">
              Applied AI Literacy
            </h3>
            <p class="mt-2 font-sans text-xs text-muted">
              AI foundations, prompt engineering, verification, data
              spreadsheets, multimodal tools, and practical workflows for
              learning and office tasks.
            </p>
            <p class="mt-3 font-mono text-[11px] text-muted">
              Duration: 6 Months
            </p>
          </div>
          <div
            class="mt-6 flex items-center justify-between border-t border-hair pt-4"
          >
            <a
              href="/courses/ai-literacy"
              class="font-sans text-xs font-semibold text-spark-ink hover:underline"
            >
              View syllabus →
            </a>
            <Button href={aiLiteracyFormUrl} variant="primary" size="sm">
              Enquire
            </Button>
          </div>
        </div>

        {/* Category 4: Business Development + Internship */}
        <div
          class="border-spark/40 flex flex-col justify-between rounded border-2 bg-paper p-6 shadow-sm"
        >
          <div>
            <div class="flex items-center justify-between">
              <span
                class="bg-spark/10 rounded-pill px-2.5 py-0.5 font-mono text-[11px] font-semibold text-spark-ink"
              >
                Flagship
              </span>
              <span class="font-mono text-xs font-semibold text-spark-ink">
                ₹899 / mo
              </span>
            </div>
            <h3 class="mt-3 font-serif text-xl font-normal text-ink">
              Business Development + Internship
            </h3>
            <p class="mt-2 font-sans text-xs text-muted">
              Months 1–3 Learn (fundamentals, market research, sales, costing).
              Months 4–6 Build (mentored internship on actual Chamba ventures).
            </p>
            <p class="mt-3 font-mono text-[11px] text-muted">
              Duration: 6 Months
            </p>
          </div>
          <div
            class="mt-6 flex items-center justify-between border-t border-hair pt-4"
          >
            <a
              href="/courses/business-development"
              class="font-sans text-xs font-semibold text-spark-ink hover:underline"
            >
              View programme →
            </a>
            <Button href={businessDevFormUrl} variant="primary" size="sm">
              Apply
            </Button>
          </div>
        </div>

        {/* Category 5: Communication Skills */}
        <div
          class="flex flex-col justify-between rounded border border-hair bg-paper p-6 shadow-sm"
        >
          <div>
            <div class="flex items-center justify-between">
              <span
                class="rounded-pill bg-hair px-2.5 py-0.5 font-mono text-[11px] text-muted"
              >
                Bilingual
              </span>
              <span class="font-mono text-xs font-semibold text-spark-ink">
                ₹599 / mo
              </span>
            </div>
            <h3 class="mt-3 font-serif text-xl font-normal text-ink">
              Communication Skills
            </h3>
            <p class="mt-2 font-sans text-xs text-muted">
              English and Hindi speaking, professional writing, public speaking,
              presentations, group discussion dynamics, and job interview
              preparation.
            </p>
            <p class="mt-3 font-mono text-[11px] text-muted">
              Duration: 6 Months
            </p>
          </div>
          <div
            class="mt-6 flex items-center justify-between border-t border-hair pt-4"
          >
            <a
              href="/courses/communication"
              class="font-sans text-xs font-semibold text-spark-ink hover:underline"
            >
              View syllabus →
            </a>
            <Button href={commFormUrl} variant="primary" size="sm">
              Enquire
            </Button>
          </div>
        </div>

        {/* Category 6: Institutional Offerings */}
        <div
          class="flex flex-col justify-between rounded border border-hair bg-paper p-6 shadow-sm"
        >
          <div>
            <div class="flex items-center justify-between">
              <span
                class="rounded-pill bg-hair px-2.5 py-0.5 font-mono text-[11px] text-muted"
              >
                For Schools
              </span>
              <span class="font-mono text-xs font-semibold text-spark-ink">
                Customised
              </span>
            </div>
