---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import CourseCard from '../components/brand/CourseCard.astro';

import coursesData from '../content/courses.json';
import site from '../content/site.json';
import type { CourseItem } from '../content/schemas';
import { getFormUrl, isFormConfigured } from '../config/forms';

const courses = (coursesData.courses || []) as CourseItem[];

const generalFormUrl = getFormUrl('courseGeneral');
const isGeneralExternal = isFormConfigured('courseGeneral');
---

<BaseLayout
  title={`${site.name} — Online courses in Chamba & beyond`}
  description="Prepare for exams. Build skills. Do real work. Structured online courses for school students, competitive-exam aspirants and college students."
>
  {/* 1. HERO SECTION */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="mx-auto max-w-4xl text-center">
      <div
        class="mb-4 inline-flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-[0.16em] text-spark-ink"
      >
        <span>SYNAPSE · CHAMBA, HIMACHAL PRADESH</span>
      </div>

      <h1
        class="mb-6 font-serif text-display-xl-mobile font-normal leading-[1.05] tracking-[-0.025em] text-ink sm:text-display-lg md:text-display-xl"
      >
        Prepare for exams. Build skills. <span class="italic text-spark-ink"
          >Do real work.</span
        >
      </h1>

      <p
        class="mx-auto mb-8 max-w-2xl font-sans text-base leading-relaxed text-muted sm:text-body-lg"
      >
        Online courses for school students, competitive-exam aspirants and
        college students. Choose structured exam modules, Class 11–12 subject
        classes, English-Hindi communication, applied AI or a
        business-development programme with a real internship.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <Button href="#courses" variant="primary" size="lg">
          Explore courses
        </Button>
        <Button
          href={generalFormUrl}
          target={isGeneralExternal ? '_blank' : undefined}
          rel={isGeneralExternal ? 'noopener noreferrer' : undefined}
          variant="secondary"
          size="lg"
        >
          <span>Enquire now</span>
          {
            isGeneralExternal && (
              <svg
                class="ml-1 h-4 w-4 opacity-80"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                />
              </svg>
            )
          }
        </Button>
      </div>

      <div
        class="bg-hair/30 mt-8 inline-block rounded-sm border border-hair px-4 py-2 font-mono text-xs font-medium text-ink"
      >
        Courses from ₹599 · Online classes · One or two trial classes before
        enrolment
      </div>
    </div>
  </Section>

  {/* 2. THREE AUDIENCE TRACKS */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="mb-10 text-center">
      <span
        class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink"
      >
        Choose your path
      </span>
      <h2
        class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
      >
        A course for what you need next
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {/* Track 1: School */}
      <div
        class="flex flex-col justify-between rounded border border-hair bg-paper p-6 sm:p-8"
      >
        <div>
          <span
            class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink"
          >
            Classes 8–12
          </span>
          <h3 class="mt-2 font-serif text-2xl font-normal text-ink">
            For school students
          </h3>
          <p class="mt-3 font-sans text-sm leading-relaxed text-muted">
            Build communication skills and strengthen subject knowledge. Class
            11–12 students can choose Physics, Chemistry, Biology or Mathematics
            for board and entrance preparation. The Foundation Pack is also
            available for building competitive-exam fundamentals.
          </p>
        </div>
        <div class="border-hair/60 mt-6 border-t pt-4">
          <Button
            href="/courses#school"
            variant="ghost"
            size="sm"
            class="px-0 hover:bg-transparent hover:text-spark-ink"
          >
            <span>Explore school courses</span>
            <span aria-hidden="true" class="ml-1">→</span>
          </Button>
        </div>
      </div>

      {/* Track 2: Entrance Exams */}
      <div
        class="flex flex-col justify-between rounded border border-hair bg-paper p-6 sm:p-8"
      >
        <div>
          <span
            class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink"
          >
            Aspirants & Boards
          </span>
          <h3 class="mt-2 font-serif text-2xl font-normal text-ink">
            For entrance-exam aspirants
          </h3>
          <p class="mt-3 font-sans text-sm leading-relaxed text-muted">
            Build your foundation in General Awareness, Reasoning and
            Quantitative Aptitude. Add an exam-specific Question Bank to
            practise by topic, track accuracy and speed, and identify what to
            work on next.
          </p>
        </div>
        <div class="border-hair/60 mt-6 border-t pt-4">
          <Button
            href="/courses#exam"
            variant="ghost"
            size="sm"
            class="px-0 hover:bg-transparent hover:text-spark-ink"
          >
            <span>Explore exam preparation</span>
            <span aria-hidden="true" class="ml-1">→</span>
          </Button>
        </div>
      </div>

      {/* Track 3: College */}
      <div
        class="flex flex-col justify-between rounded border border-hair bg-paper p-6 sm:p-8"
      >
        <div>
          <span
            class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink"
          >
            College & Graduates
          </span>
          <h3 class="mt-2 font-serif text-2xl font-normal text-ink">
            For college students
          </h3>
          <p class="mt-3 font-sans text-sm leading-relaxed text-muted">
            Work on communication, practical AI use and business development.
            The six-month Business Development programme combines structured
            learning with an internship on a Chamba-based venture.
          </p>
        </div>
        <div class="border-hair/60 mt-6 border-t pt-4">
          <Button
            href="/courses#college"
            variant="ghost"
            size="sm"
            class="px-0 hover:bg-transparent hover:text-spark-ink"
          >
            <span>Explore college programmes</span>
            <span aria-hidden="true" class="ml-1">→</span>
          </Button>
        </div>
      </div>
    </div>
  </Section>

  {/* 3. COURSES AT A GLANCE */}
  <Section theme="paper" padding="lg" class="border-b border-hair" id="courses">
    <div
      class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"
    >
      <div>
        <span
          class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink"
        >
          Transparent Fees · Structured Learning
        </span>
        <h2
          class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
        >
          Courses at a glance
        </h2>
      </div>
      <a
        href="/courses"
        class="font-sans text-sm font-semibold text-spark-ink hover:underline focus-visible:outline-2 focus-visible:outline-spark"
      >
        <span>View all course details & syllabi</span>
        <span aria-hidden="true" class="ml-1">→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      {
        courses.map((c, idx) => (
          <CourseCard course={c} featured={idx === 0 || idx === 4} />
        ))
      }
    </div>
  </Section>

  {/* 4. HOW ENROLMENT WORKS */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="mb-12 text-center">
      <span
        class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink"
      >
        Clear & Simple Process
      </span>
      <h2
        class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
      >
        How enrolment works
      </h2>
      <p class="mx-auto mt-3 max-w-xl font-sans text-sm text-muted">
        Four transparent steps from your first question to your online class
        batch.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded border border-hair bg-paper p-6">
        <span class="font-mono text-xs font-bold text-spark-ink">01</span>
        <h3 class="mt-2 font-serif text-xl font-normal text-ink">1. Enquire</h3>
        <p class="mt-2 font-sans text-sm leading-relaxed text-muted">
          Choose a course and submit the short enquiry form. A Synapse team
          member will contact you.
        </p>
      </div>

      <div class="rounded border border-hair bg-paper p-6">
        <span class="font-mono text-xs font-bold text-spark-ink">02</span>
        <h3 class="mt-2 font-serif text-xl font-normal text-ink">
          2. Attend a trial class
        </h3>
        <p class="mt-2 font-sans text-sm leading-relaxed text-muted">
          Join one or two trial classes so you can understand the teaching
          format and decide whether the course is right for you.
        </p>
      </div>

      <div class="rounded border border-hair bg-paper p-6">
        <span class="font-mono text-xs font-bold text-spark-ink">03</span>
        <h3 class="mt-2 font-serif text-xl font-normal text-ink">
          3. Confirm your batch
        </h3>
        <p class="mt-2 font-sans text-sm leading-relaxed text-muted">
          We will share the available batch timing, course details and fee
          information before you enrol.
        </p>
      </div>

      <div class="rounded border border-hair bg-paper p-6">
        <span class="font-mono text-xs font-bold text-spark-ink">04</span>
        <h3 class="mt-2 font-serif text-xl font-normal text-ink">
          4. Start learning
        </h3>
        <p class="mt-2 font-sans text-sm leading-relaxed text-muted">
          Join your online batch and follow the course plan. Tests, practice and
          progress reviews depend on the programme you choose.
        </p>
      </div>
    </div>
  </Section>

  {/* 5. LEARNING FORMAT */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div
      class="bg-hair/20 mx-auto max-w-3xl rounded border border-hair p-8 sm:p-10"
    >
      <div class="flex items-center gap-3">
        <span class="h-2 w-2 rounded-full bg-spark" aria-hidden="true"></span>
        <span
          class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink"
        >
          Delivery Mode & Local Presence
        </span>
      </div>

      <h2 class="mt-3 font-serif text-2xl font-normal text-ink sm:text-3xl">
        Online learning with roots in Chamba
      </h2>

      <p class="mt-4 font-sans text-base leading-relaxed text-muted">
        All classes are online. College-level batches are generally planned
        before 3:00 PM, while school-level batches are planned after 3:00 PM.
        Exact timings are shared during the enquiry process. The Synapse office
        is behind the Post Office in Chamba, Himachal Pradesh.
      </p>

      <div
        class="border-hair/80 mt-6 flex flex-wrap items-center gap-6 border-t pt-6 font-mono text-xs text-ink"
      >
        <div>
          <span class="text-muted">Office:</span> Behind the Post Office, Chamba
        </div>
        <div>
          <span class="text-muted">Phone / WhatsApp:</span> +91 {site.phone}
        </div>
        <div>
          <span class="text-muted">Delivery:</span> Live Online Batches
        </div>
      </div>
    </div>
  </Section>

  {/* 6. INSTITUTIONAL SECTION TEASER */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="grid grid-cols-1 items-center gap-8 md:grid-cols-12">
      <div class="md:col-span-8">
        <span
          class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink"
        >
          For Schools & Colleges
        </span>
        <h2
          class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
        >
          Bring a Synapse session to your school or college
        </h2>
        <p class="mt-3 font-sans text-base leading-relaxed text-muted">
          We work with schools and colleges on introductory sessions,
          communication workshops, AI awareness, entrance-baseline assessments
          and information sessions for the Business Development programme.
          Institutions can also enquire about group enrolment.
        </p>
      </div>

      <div class="md:col-span-4 md:text-right">
        <Button href="/schools-colleges" variant="primary" size="md">
          Enquire for your institution
        </Button>
      </div>
    </div>
  </Section>

  {/* 7. CLOSING CTA */}
  <Section theme="paper" padding="lg">
    <div class="mx-auto max-w-3xl text-center">
      <h2
        class="font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
      >
        Not sure which course is right for you?
      </h2>
      <p
        class="mx-auto mt-4 max-w-xl font-sans text-base leading-relaxed text-muted"
      >
        Tell us your class or college year, the exam you are preparing for, or
        the skill you want to work on. We will help you identify the relevant
        course and the next available batch.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button href="/contact" variant="primary" size="lg">
          Ask Synapse
        </Button>
        <Button
          href={`https://wa.me/91${site.phone}?text=${encodeURIComponent('Hello Synapse, I want to enquire about which course is right for me.')}`}
          target="_blank"
          rel="noopener noreferrer"
          variant="secondary"
          size="lg"
        >
          Chat on WhatsApp
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>
