---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Synapse">
  <div class="mx-auto max-w-content px-4 py-16 sm:px-6 md:px-8 lg:px-10">
    <header class="mb-12">
      <span class="font-mono text-label-md uppercase text-muted">
        Task T1 · Base Layout & Tokens
      </span>
      <h1
        class="mt-4 font-serif text-display-xl-mobile font-normal tracking-tight text-ink md:text-display-xl"
      >
        Synapse
      </h1>
      <p class="mt-4 max-w-2xl font-sans text-body-lg text-muted">
        A modern gurukul for the age of AI. Learn, teach and build, under one
        roof.
      </p>
    </header>

    <section aria-labelledby="tokens-heading" class="mt-16 space-y-8">
      <h2
        id="tokens-heading"
        class="font-serif text-headline-sm font-medium text-ink"
      >
        Verified Token Hierarchy
      </h2>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
        <div class="border border-hair p-4">
          <span class="font-mono text-label-sm uppercase text-muted"
            >Paper Canvas</span
          >
          <p class="mt-1 font-serif text-headline-sm text-ink">#F3EEE4</p>
          <p class="mt-1 font-sans text-body-sm text-muted">Main background</p>
        </div>

        <div class="border border-hair p-4">
          <span class="font-mono text-label-sm uppercase text-muted"
            >Ink Tone</span
          >
          <p class="mt-1 font-serif text-headline-sm text-ink">#15130F</p>
          <p class="mt-1 font-sans text-body-sm text-muted">
            16.0:1 contrast on paper
          </p>
        </div>

        <div class="border border-hair p-4">
          <span class="font-mono text-label-sm uppercase text-muted"
            >Muted Text</span
          >
          <p class="mt-1 font-serif text-headline-sm text-muted">#5C574B</p>
          <p class="mt-1 font-sans text-body-sm text-muted">
            6.2:1 contrast on paper
          </p>
        </div>

        <div class="border border-hair p-4">
          <span class="font-mono text-label-sm uppercase text-muted"
            >Spark (Display)</span
          >
          <p class="mt-1 font-serif text-headline-sm text-spark">#D9481F</p>
          <p class="mt-1 font-sans text-body-sm text-muted">
            Rules, dots, display &ge; 24px
          </p>
        </div>

        <div class="border border-hair p-4">
          <span class="font-mono text-label-sm uppercase text-muted"
            >Spark Ink</span
          >
          <p class="mt-1 font-serif text-headline-sm text-spark-ink">#B22C01</p>
          <p class="mt-1 font-sans text-body-sm text-muted">
            Small red text & buttons (5.6:1)
          </p>
        </div>

        <div class="border border-hair-ink bg-ink p-4 text-paper">
          <span class="font-mono text-label-sm uppercase text-muted-on-ink"
            >Spark Glow (On Ink)</span
          >
          <p class="mt-1 font-serif text-headline-sm text-spark-glow">
            #FF6338
          </p>
          <p class="mt-1 font-sans text-body-sm text-muted-on-ink">
            Small red text on ink (6.3:1)
          </p>
        </div>
      </div>

      <div class="pt-4">
        <a
          href="#main-content"
          class="inline-block rounded-pill bg-ink px-6 py-3 font-sans text-label-md uppercase text-paper transition-colors hover:bg-spark-ink"
        >
          Focus Ring Test Button
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
