---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import site from '../content/site.json';
---

<BaseLayout
  title={`Courses & Programmes — ${site.name}`}
  description="Explore our seven structured courses with transparent fees: Foundation Pack, Question Bank, Class 11–12 Subject Classes, Communication, AI Literacy and Business Development + Internship."
>
  <Section theme="paper" padding="lg">
    <div class="mx-auto max-w-2xl py-12 text-center">
      <h1 class="font-serif text-3xl font-normal text-ink">
        Looking for our programmes?
      </h1>
      <p class="mt-4 font-sans text-base text-muted">
        Our programme offerings and course catalogue are now located at our
        Courses directory.
      </p>
      <div class="mt-8">
        <Button href="/courses" variant="primary" size="md">
          View all courses & syllabi →
        </Button>
      </div>
    </div>
  </Section>

  <script is:inline>
    // Client-side instant forward
    if (
      window.location.pathname === '/programmes' ||
      window.location.pathname === '/programmes/'
    ) {
      window.location.replace('/courses');
    }
  </script>
</BaseLayout>
