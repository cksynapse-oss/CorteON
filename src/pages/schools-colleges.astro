---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import StatusChip from '../components/ui/StatusChip.astro';

import site from '../content/site.json';
import { getFormUrl, isFormConfigured } from '../config/forms';

const formUrl = getFormUrl('institutionEnquiry');
const isExternal = isFormConfigured('institutionEnquiry');
---

<BaseLayout
  title={`For Schools & Educational Institutions — ${site.name}`}
  description="Structured institutional programmes for schools and colleges in Himachal Pradesh: AI Literacy, Robotics & ATL Lab Sessions, Business Development, and Communication Skills."
>
  {/* Hero */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="mx-auto max-w-4xl text-center">
      <div class="mb-4 inline-flex items-center gap-2">
        <span
          class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-spark-ink"
        >
          Institutional Partnerships · Schools & Colleges
        </span>
        <StatusChip status="LIVE NOW" />
      </div>

      <h1
        class="mt-4 font-serif text-display-lg-mobile font-normal text-ink sm:text-display-lg"
      >
        Structured learning programmes for educational institutions.
      </h1>

      <p
        class="mx-auto mt-4 max-w-2xl font-sans text-base leading-relaxed text-muted sm:text-body-lg"
      >
        Our institutional offering is primarily designed for schools, though
        colleges and other learning institutions can also partner with us. We
        deliver structured classes in AI literacy, robotics and ATL lab
        sessions, youth entrepreneurship, and bilingual communication.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button
          href={formUrl}
          target={isExternal ? '_blank' : undefined}
          rel={isExternal ? 'noopener noreferrer' : undefined}
          variant="primary"
          size="lg"
        >
          <span>Enquire about institutional pricing</span>
        </Button>
        <Button href="/contact" variant="secondary" size="lg">
          Talk to our team
        </Button>
      </div>

      <p class="mt-4 font-sans text-xs text-muted">
        Custom delivery formats · Flexible batch scheduling · Enquire for single
        or combined services
      </p>
    </div>
  </Section>

  {/* THE FOUR MAJOR INSTITUTIONAL SERVICES */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="mx-auto max-w-5xl">
      <div class="mb-12">
        <span
          class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink"
        >
          Core Offerings
        </span>
        <h2
          class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
        >
          Four Structured Services for Schools
        </h2>
        <p class="mt-2 max-w-2xl font-sans text-sm text-muted">
          Institutions can engage Synapse for individual services or design a
          comprehensive multi-service programme for their student batches.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {/* Service 1: AI Literacy Classes */}
        <div
          class="hover:border-ink/40 flex flex-col justify-between rounded border border-hair bg-paper p-8 shadow-sm transition-colors"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-bold text-spark-ink">01</span>
              <span
                class="rounded-pill bg-hair px-2.5 py-0.5 font-mono text-[11px] text-muted"
              >
                Technology
              </span>
            </div>

            <h3 class="mt-3 font-serif text-2xl font-normal text-ink">
              AI Literacy Classes
            </h3>
            <p class="mt-2 font-sans text-sm leading-relaxed text-muted">
              Structured classes introducing school students to artificial
              intelligence, modern tools, and safe digital productivity.
            </p>

            <ul class="mt-4 space-y-2 font-sans text-xs text-muted">
              <li>• Understanding artificial intelligence concepts</li>
              <li>• Generative AI and modern AI tools</li>
              <li>• Prompting and effective interaction methods</li>
              <li>• Research, source checking, and verification</li>
              <li>• AI for school learning, revision, and productivity</li>
              <li>• Responsible AI usage, digital ethics, and boundaries</li>
              <li>• Practical student assignments and applications</li>
            </ul>
          </div>

          <div class="mt-8 border-t border-hair pt-4">
            <Button
              href={formUrl}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener noreferrer' : undefined}
              variant="secondary"
              size="sm"
              class="w-full justify-center"
            >
              Enquire about institutional pricing
            </Button>
          </div>
        </div>

        {/* Service 2: Robotics and ATL Lab Classes */}
        <div
          class="hover:border-ink/40 flex flex-col justify-between rounded border border-hair bg-paper p-8 shadow-sm transition-colors"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-bold text-spark-ink">02</span>
              <span
                class="rounded-pill bg-hair px-2.5 py-0.5 font-mono text-[11px] text-muted"
              >
                Lab & Hardware
              </span>
            </div>

            <h3 class="mt-3 font-serif text-2xl font-normal text-ink">
              Robotics & ATL Lab Classes
            </h3>
            <p class="mt-2 font-sans text-sm leading-relaxed text-muted">
              Teaching and practical sessions using your school’s existing Atal
              Tinkering Lab (ATL) or robotics infrastructure to bring hands-on
              engineering to life.
            </p>

            <ul class="mt-4 space-y-2 font-sans text-xs text-muted">
              <li>• Robotics fundamentals and mechanical principles</li>
              <li>• Electronics basics, circuit building, and safety</li>
              <li>• Sensors, actuators, and signal processing</li>
              <li>• Microcontrollers and embedded systems where appropriate</li>
              <li>• Programming, logic flow, and automation drills</li>
              <li>• Practical hardware projects and prototyping</li>
              <li>
                • End-of-term project demonstrations for parents & faculty
              </li>
            </ul>

            <div
              class="bg-hair/30 mt-4 rounded p-3 font-sans text-[11px] text-muted"
            >
              <strong>Infrastructure Note:</strong> We develop structured learning
              activities around the school’s existing laboratory equipment. Synapse
              does not supply laboratory hardware unless separately confirmed in an
              agreement.
            </div>
          </div>

          <div class="mt-8 border-t border-hair pt-4">
            <Button
              href={formUrl}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener noreferrer' : undefined}
              variant="secondary"
              size="sm"
              class="w-full justify-center"
            >
              Enquire about institutional pricing
            </Button>
          </div>
        </div>

        {/* Service 3: Business Development Classes */}
        <div
          class="hover:border-ink/40 flex flex-col justify-between rounded border border-hair bg-paper p-8 shadow-sm transition-colors"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-bold text-spark-ink">03</span>
              <span
                class="rounded-pill bg-hair px-2.5 py-0.5 font-mono text-[11px] text-muted"
              >
                Enterprise & Practical
              </span>
            </div>

            <h3 class="mt-3 font-serif text-2xl font-normal text-ink">
              Business Development Classes
            </h3>
            <p class="mt-2 font-sans text-sm leading-relaxed text-muted">
              Introduce school students to real-world problem solving, market
              dynamics, and entrepreneurial execution through structured team
              challenges.
            </p>

            <ul class="mt-4 space-y-2 font-sans text-xs text-muted">
              <li>• Understanding real problems and market opportunities</li>
              <li>• Business fundamentals and how enterprises work</li>
              <li>• Customer discovery and conducting simple interviews</li>
              <li>• Developing product ideas and basic prototypes</li>
              <li>• Market research and local economic analysis</li>
              <li>• Costing, pricing fundamentals, and budgeting</li>
              <li>• Marketing, sales, and team-based venture projects</li>
            </ul>
          </div>

          <div class="mt-8 border-t border-hair pt-4">
            <Button
              href={formUrl}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener noreferrer' : undefined}
              variant="secondary"
              size="sm"
              class="w-full justify-center"
            >
              Enquire about institutional pricing
            </Button>
          </div>
        </div>

        {/* Service 4: Communication Skills Classes */}
        <div
          class="hover:border-ink/40 flex flex-col justify-between rounded border border-hair bg-paper p-8 shadow-sm transition-colors"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-bold text-spark-ink">04</span>
              <span
                class="rounded-pill bg-hair px-2.5 py-0.5 font-mono text-[11px] text-muted"
              >
                Fluency & Expression
              </span>
            </div>

            <h3 class="mt-3 font-serif text-2xl font-normal text-ink">
              Communication Skills Classes
            </h3>
            <p class="mt-2 font-sans text-sm leading-relaxed text-muted">
              Introduce structured communication training to help students
              overcome hesitation, present clearly, and articulate ideas in both
              English and Hindi.
            </p>

            <ul class="mt-4 space-y-2 font-sans text-xs text-muted">
              <li>• English and Hindi spoken fluency and pronunciation</li>
              <li>• Public speaking and overcoming stage fear</li>
              <li>• Structured presentation skills and visual slides</li>
              <li>
                • Practical writing: essays, reports, and professional emails
              </li>
              <li>• Group discussion techniques and constructive dialogue</li>
              <li>• Confidence in expressing, defending, and revising ideas</li>
              <li>• Collaborative team communication exercises</li>
            </ul>
          </div>

          <div class="mt-8 border-t border-hair pt-4">
            <Button
              href={formUrl}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener noreferrer' : undefined}
              variant="secondary"
              size="sm"
              class="w-full justify-center"
            >
              Enquire about institutional pricing
            </Button>
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* INSTITUTIONAL ENQUIRY PROCESS & WHAT IS CAPTURED */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="mx-auto max-w-4xl">
      <div class="text-center">
        <span
          class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-spark-ink"
        >
          Transparent Process
        </span>
        <h2
          class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
        >
          How Institutional Partnerships Work
        </h2>
        <p class="mx-auto mt-2 max-w-2xl font-sans text-sm text-muted">
          We do not publish fixed institutional prices because every school has
          differing student counts, available infrastructure, and scheduling
          requirements.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="rounded border border-hair bg-paper p-6">
          <span class="font-mono text-xs font-bold text-spark-ink">Step 1</span>
          <h3 class="mt-2 font-serif text-xl font-normal text-ink">
            Submit Your Details
          </h3>
          <p class="mt-2 font-sans text-xs leading-relaxed text-muted">
            The school principal or coordinator submits the institutional form.
            We capture:
          </p>
          <ul
            class="mt-3 list-disc space-y-1 pl-4 font-sans text-xs text-muted"
          >
            <li>School / institution name and location</li>
            <li>Contact person, phone number, and official email</li>
            <li>Number of students and classes involved</li>
            <li>
              Services of interest (AI, Robotics, Business, Communication)
            </li>
            <li>Existing robotics / ATL infrastructure status</li>
            <li>
              Preferred delivery format (in-school sessions, workshops, batch
              scheduling)
            </li>
            <li>Any specific institutional requirements</li>
          </ul>
        </div>

        <div class="rounded border border-hair bg-paper p-6">
          <span class="font-mono text-xs font-bold text-spark-ink">Step 2</span>
          <h3 class="mt-2 font-serif text-xl font-normal text-ink">
            Scope & Proposal
          </h3>
          <p class="mt-2 font-sans text-xs leading-relaxed text-muted">
            After receiving the enquiry, Synapse contacts the leadership team to
            discuss programme scope, pricing, delivery arrangements, and
            timeline possibilities tailored to your academic calendar.
          </p>
          <div
            class="mt-6 border-t border-hair pt-4 font-mono text-xs text-spark-ink"
          >
            Response {site.callbackWindow}
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* Closing CTA */}
  <Section theme="paper" padding="lg">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-serif text-headline-sm font-normal text-ink">
        Partner with Synapse in Chamba
      </h2>
      <p class="mx-auto mt-3 max-w-xl font-sans text-base text-muted">
        Connect your students with structured modern learning in AI, robotics,
        business, and communication. Reach out today to schedule an initial
        discussion.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button
          href={formUrl}
          target={isExternal ? '_blank' : undefined}
          rel={isExternal ? 'noopener noreferrer' : undefined}
          variant="primary"
          size="lg"
        >
          <span>Enquire about institutional pricing</span>
        </Button>
        <Button href="/contact" variant="secondary" size="lg">
          Contact via WhatsApp / Phone
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>
