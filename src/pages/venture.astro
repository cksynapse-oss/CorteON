---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import site from '../content/site.json';
---

<BaseLayout
  title={`Chamba Ventures — ${site.name}`}
  description="Explore the four venture project areas connected to the Synapse Business Development programme in Chamba."
>
  <Section theme="paper" padding="lg">
    <div class="mx-auto max-w-2xl py-12 text-center">
      <h1 class="font-serif text-3xl font-normal text-ink">
        Chamba Ventures & Internship Projects
      </h1>
      <p class="mt-4 font-sans text-base text-muted">
        Details on our four venture tracks are now located at our Chamba
        Ventures page.
      </p>
      <div class="mt-8">
        <Button href="/ventures" variant="primary" size="md">
          Explore Chamba Ventures →
        </Button>
      </div>
    </div>
  </Section>

  <script is:inline>
    // Client-side instant forward
    if (
      window.location.pathname === '/venture' ||
      window.location.pathname === '/venture/'
    ) {
      window.location.replace('/ventures');
    }
  </script>
</BaseLayout>
