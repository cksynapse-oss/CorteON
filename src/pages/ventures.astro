---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import VentureCard from '../components/brand/VentureCard.astro';
import Button from '../components/ui/Button.astro';
import StatusChip from '../components/ui/StatusChip.astro';

import venturesData from '../content/ventures.json';
import site from '../content/site.json';
import type { VentureItem } from '../content/schemas';
import { getFormUrl, isFormConfigured } from '../config/forms';

const ventures = (venturesData.ventures || []) as VentureItem[];

const formUrl = getFormUrl('internshipApplication');
const isExternal = isFormConfigured('internshipApplication');

const businessCurriculumUrl = '/courses/business-development';
---

<BaseLayout
  title={`Chamba Ventures — The Learning-to-Build Model — ${site.name}`}
  description="Learn together. Build together. Create something real. How students from AI, Business Development, Commerce, and Humanities collaborate on actual Chamba ventures."
>
  {/* Hero */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="mx-auto max-w-4xl text-center">
      <div class="mb-4 inline-flex items-center gap-2">
        <span
          class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-spark-ink"
        >
          Chamba Ventures · The Learning-to-Build Model
        </span>
        <StatusChip status="LIVE NOW" />
      </div>

      <h1
        class="mt-4 font-serif text-display-xl-mobile font-normal leading-[1.08] tracking-[-0.025em] text-ink sm:text-display-lg md:text-display-xl"
      >
        Learn together. Build together. Create something real.
      </h1>

      <p
        class="mx-auto mt-4 max-w-2xl font-sans text-base leading-relaxed text-muted sm:text-body-lg"
      >
        Education is not limited to attending classes and completing exams. At
        Synapse, students and interns from AI, business, commerce, humanities,
        and technology connect to build real products, services, and local
        enterprises rooted in Chamba.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button
          href={formUrl}
          target={isExternal ? '_blank' : undefined}
          rel={isExternal ? 'noopener noreferrer' : undefined}
          variant="primary"
          size="lg"
        >
          <span>Apply for Venture Internship</span>
        </Button>
        <Button href={businessCurriculumUrl} variant="secondary" size="lg">
          View 6-Month Programme
        </Button>
      </div>

      <p class="mt-4 font-sans text-xs text-muted">
        Mentored internship · Interdisciplinary collaboration · Authentic local
        projects
      </p>
    </div>
  </Section>

  {/* HOW THE VENTURE MODEL OPERATES (4 STAGES) */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="mx-auto max-w-5xl">
      <div class="mb-12 text-center">
        <span
          class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink"
        >
          Operational Architecture
        </span>
        <h2
          class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
        >
          How the Venture Model Operates in Four Stages
        </h2>
        <p class="mx-auto mt-2 max-w-2xl font-sans text-sm text-muted">
          A clear progression connecting initial coordination with cohort
          learning and interdisciplinary project delivery.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {/* Stage 1 */}
        <div
          class="flex flex-col justify-between rounded border border-hair bg-paper p-6"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-bold text-spark-ink"
                >Stage 1</span
              >
              <span class="font-mono text-[11px] text-muted">Inception</span>
            </div>
            <h3 class="mt-3 font-serif text-xl font-normal text-ink">
              Initial Venture Interns
            </h3>
            <p class="mt-2 font-sans text-xs leading-relaxed text-muted">
              Initially, we recruit a small number of interns who help establish
              the initial venture teams and coordinate operations. These interns
              contribute to research, execution, communication, project
              coordination, and day-to-day activities.
            </p>
          </div>
          <div
            class="mt-4 border-t border-hair pt-3 font-mono text-[11px] text-spark-ink"
          >
            Foundation & operations
          </div>
        </div>

        {/* Stage 2 */}
        <div
          class="flex flex-col justify-between rounded border border-hair bg-paper p-6"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-bold text-spark-ink"
                >Stage 2</span
              >
              <span class="font-mono text-[11px] text-muted">Learning</span>
            </div>
            <h3 class="mt-3 font-serif text-xl font-normal text-ink">
              Learning Cohorts Join
            </h3>
            <p class="mt-2 font-sans text-xs leading-relaxed text-muted">
              Students participating in the AI Literacy and Business Development
              programmes develop practical capabilities. They are introduced to
              actual venture challenges and small project assignments during
              their learning journey.
            </p>
          </div>
          <div
            class="mt-4 border-t border-hair pt-3 font-mono text-[11px] text-spark-ink"
          >
            Applied capabilities
          </div>
        </div>

        {/* Stage 3 */}
        <div
          class="flex flex-col justify-between rounded border border-hair bg-paper p-6"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-bold text-spark-ink"
                >Stage 3</span
              >
              <span class="font-mono text-[11px] text-muted">Teams</span>
            </div>
            <h3 class="mt-3 font-serif text-xl font-normal text-ink">
              Interdisciplinary Collaboration
            </h3>
            <p class="mt-2 font-sans text-xs leading-relaxed text-muted">
              Students and initial interns coordinate across projects. Teams
              combine AI tool workflows, market research, commerce costing,
              humanities storytelling, and technical development to build
              well-rounded solutions.
            </p>
          </div>
          <div
            class="mt-4 border-t border-hair pt-3 font-mono text-[11px] text-spark-ink"
          >
            Complementary skills
          </div>
        </div>

        {/* Stage 4 */}
        <div
          class="flex flex-col justify-between rounded border border-hair bg-paper p-6"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-bold text-spark-ink"
                >Stage 4</span
              >
              <span class="font-mono text-[11px] text-muted">Delivery</span>
            </div>
            <h3 class="mt-3 font-serif text-xl font-normal text-ink">
              Work on Actual Ventures
            </h3>
            <p class="mt-2 font-sans text-xs leading-relaxed text-muted">
              Participants collaborate on selected ventures and work towards
              tangible outputs: market research, customer interviews, product
              catalogues, websites, branding, sales distribution, and
              operational workflows.
            </p>
          </div>
          <div
            class="mt-4 border-t border-hair pt-3 font-mono text-[11px] text-spark-ink"
          >
            Tangible outcomes
          </div>
        </div>
      </div>

      {/* Disciplinary Collaboration Matrix */}
      <div class="bg-hair/20 mt-8 rounded border border-hair p-6 sm:p-8">
        <h4 class="font-serif text-xl font-normal text-ink">
          How Different Disciplines Contribute to the Same Venture
        </h4>
        <div
          class="mt-4 grid grid-cols-1 gap-4 font-sans text-xs leading-relaxed text-muted sm:grid-cols-2 lg:grid-cols-3"
        >
          <div class="rounded border border-hair bg-paper p-4">
            <strong class="text-ink">AI Learners:</strong> Research, implement modern
            AI tools, automate repetitive tasks, and design intelligent workflows.
          </div>
          <div class="rounded border border-hair bg-paper p-4">
            <strong class="text-ink">Business Learners:</strong> Customer discovery,
            market research, positioning, marketing strategy, and direct sales.
          </div>
          <div class="rounded border border-hair bg-paper p-4">
            <strong class="text-ink">Commerce Students:</strong> Unit economics, product
            costing, margin modeling, accounting, and supply tracking.
          </div>
          <div class="rounded border border-hair bg-paper p-4">
            <strong class="text-ink">Humanities Students:</strong> Qualitative research,
            cultural context, authentic storytelling, and artisan documentation.
          </div>
          <div class="rounded border border-hair bg-paper p-4">
            <strong class="text-ink">Technical Students:</strong> Websites, digital
            catalogues, local booking workflows, automation scripts, and digital tools.
          </div>
          <div class="rounded border border-hair bg-paper p-4">
            <strong class="text-ink">Initial Interns:</strong> Team coordination,
            project scheduling, day-to-day execution, and stakeholder communication.
          </div>
        </div>

        <p class="mt-4 border-t border-hair pt-3 text-[11px] italic text-muted">
          Important note: Project allocation depends on capabilities, selection,
          availability, and venture requirements. Synapse does not promise
          automatic employment, guaranteed funding, equity, or a paid placement
          to every participant.
        </p>
      </div>
    </div>
  </Section>

  {/* THE FOUR CHAMBA VENTURES */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="mx-auto max-w-5xl">
      <div class="mb-10">
        <span
          class="font-mono text-xs font-semibold uppercase tracking-wider text-spark-ink"
        >
          Active Project Tracks
        </span>
        <h2
          class="mt-2 font-serif text-headline-sm font-normal text-ink sm:text-headline-md"
        >
          Four Chamba Ventures
        </h2>
        <p class="mt-2 max-w-2xl font-sans text-sm text-muted">
          Each venture is grounded in local opportunities in Chamba. All
          projects carry honest status labels reflecting their current
          development stage.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {ventures.map((venture) => <VentureCard venture={venture} />)}
      </div>
    </div>
  </Section>

  {/* ETHICS & LOCAL RESPECT POLICY */}
  <Section theme="paper" padding="lg" class="border-b border-hair">
    <div class="mx-auto max-w-4xl rounded border border-hair bg-paper p-8">
      <h3 class="font-serif text-2xl font-normal text-ink">
        Artisan Consent, Attribution & Fair Collaboration
      </h3>
      <p class="mt-3 font-sans text-sm leading-relaxed text-muted">
        In projects involving local artisans, traditional crafts like Chamba
        Rumal, or local agricultural produce, Synapse strictly respects
        intellectual property, artisan consent, proper attribution, and fair
        compensation. We do not display mock-ups as finished products, nor do we
        claim commercial ownership over community craft traditions.
      </p>
      <div class="mt-4 font-mono text-xs font-semibold text-spark-ink">
        Rooted in local heritage · Built with contemporary standards
      </div>
    </div>
  </Section>

  {/* Closing CTA */}
  <Section theme="paper" padding="lg">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-serif text-headline-sm font-normal text-ink">
        Want to collaborate or intern with us?
      </h2>
      <p class="mx-auto mt-3 max-w-xl font-sans text-base text-muted">
        Whether you are an aspiring intern, local business, artisan, or student
        ready to apply your skills, reach out to explore current venture
        opportunities.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button
          href={formUrl}
          target={isExternal ? '_blank' : undefined}
          rel={isExternal ? 'noopener noreferrer' : undefined}
          variant="primary"
          size="lg"
        >
          <span>Submit Venture Internship Application</span>
        </Button>
        <Button href="/contact" variant="secondary" size="lg">
          Talk to our team
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>
